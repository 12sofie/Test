exports.getEmployeeVacationInfo = async (req, res) => {
  const language = req.headers["accept-language"] || "en";

  try {
    const { from, to } = req.query;

    const vacationsTable = "vacations_emp";
    const employeesTable = "employees_emp";

    const where = [];
    const params = [];

    if (from) {
      where.push(`v.date >= ?`);
      params.push(from);
    }
    if (to) {
      where.push(`v.date <= ?`);
      params.push(to);
    }

    const whereSQL = where.length ? `WHERE ${where.join(" AND ")}` : "";

    const [rows] = await db.query(
      `
      SELECT
        v.employeeID,
        e.codeEmployee,
        CONCAT(
          COALESCE(e.firstName, ''),
          ' ',
          COALESCE(e.lastName, '')
        ) AS fullName,
        COUNT(*) AS daysTaken,
        MIN(v.date) AS firstDate,
        MAX(v.date) AS lastDate,
        SUM(v.date > CURDATE()) AS pendingCount,
        (SUM(v.date > CURDATE()) > 0) AS hasPending
      FROM ${vacationsTable} v
      INNER JOIN ${employeesTable} e ON e.employeeID = v.employeeID
      ${whereSQL}
      GROUP BY v.employeeID, e.codeEmployee, e.firstName, e.lastName
      ORDER BY hasPending DESC, pendingCount DESC, fullName ASC
      `,
      params
    );

    return res.status(200).json(rows);
  } catch (error) {
    console.error(error);
    return res.status(500).json({ message: t("getError", language) });
  }
};


