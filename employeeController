  } catch (error) {
    console.error("Error al exportar reporte de baja carga:", error);
    res.status(500).json({ message: "Error al generar el archivo Excel." });
  }
};

//permite ver los permisos especiales en absence management 
exports.vistaEmployeePermissionSpecial = async (req, res) => {
  const language = req.headers["accept-language"] || "en";
  let { date } = req.query;

  // Si no viene fecha, usar la actual
  if (!date) {
    const hoy = new Date();
    const year = hoy.getFullYear();
    const month = String(hoy.getMonth() + 1).padStart(2, "0");
    const day = String(hoy.getDate()).padStart(2, "0");
    date = `${year}-${month}-${day}`;
  }

  try {
    let query = `
      SELECT permissionSpecialID, date, employeeID, createdDate, createdBy
      FROM permissionspecial_emp
    `;

    const queryParams = [];

    // filtro por fecha (DATE real)
    if (date) {
      query += ` WHERE date = ? `;
      queryParams.push(date);
    }

    query += ` ORDER BY permissionSpecialID DESC `;

    const [rows] = await db.query(query, queryParams);

    const byEmployee = new Map();

    for (const row of rows) {
      const empID = row.employeeID;

      let d = row.date;

      // por seguridad si mysql devuelve Date object
      if (d instanceof Date) {
        d = d.toISOString().split("T")[0];
      }

      if (!byEmployee.has(empID)) {
        byEmployee.set(empID, {
          employeeID: empID,
          dates: [],
          permissionSpecialIDs: []
        });
      }

      const entry = byEmployee.get(empID);

      // agregar fecha
      if (d && !entry.dates.includes(d)) {
        entry.dates.push(d);
      }

      // agregar permiso
      if (!entry.permissionSpecialIDs.includes(row.permissionSpecialID)) {
        entry.permissionSpecialIDs.push(row.permissionSpecialID);
      }
    }

    if (byEmployee.size === 0) {
      return res.status(200).json({ success: true, data: [] });
    }

    const empIds = Array.from(byEmployee.keys());

    const [empData] = await db.query(`
      SELECT
        e.employeeID,
        e.codeEmployee,
        CONCAT(
          IFNULL(e.firstName, ''), ' ',
          IFNULL(e.middleName, ''), ' ',
          IFNULL(e.lastName, ''), ' ',
          IFNULL(e.secondLastName, '')
        ) AS fullName,
        l.linesNumber 
      FROM employees_emp e
      LEFT JOIN employeeLines_emp el ON e.employeeID = el.employeeID
      LEFT JOIN lines_emp l ON el.linesID = l.linesID
      WHERE e.employeeID IN (?)
    `, [empIds]);

    const result = empData.map((emp) => {
      const info = byEmployee.get(emp.employeeID);

      const sortedDates = (info.dates || [])
        .sort()
        .map((d) => d.replace(/-/g, "/"));

      return {
        employeeID: emp.employeeID,
        codeEmployee: emp.codeEmployee,
        fullName: emp.fullName,
        linesNumber: emp.linesNumber,
        dates: sortedDates,
        datesString: sortedDates.join(" - "),
        permissionSpecialID: info.permissionSpecialIDs?.[0] || null,
        permissionSpecialIDs: info.permissionSpecialIDs || []
      };
    });

    return res.status(200).json({
      success: true,
      data: result,
    });

  } catch (error) {
    console.error("Error en vistaEmployeePermissionSpecial:", error);
    return res.status(500).json({
      success: false,
      message: t("saveError", language),
    });
  }
};

