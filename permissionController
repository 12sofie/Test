//Endpoint para eliminar una maternidad por ID
exports.deleteMaternityById = async (req, res) => {
  try {
    const { id } = req.params;
    if (!id) {
      return res.status(400).json({ success: false, message: "id es requerido." });
    }

    // Consultar los datos de la maternidad antes de borrarla
    const [existingMaternity] = await db.query(
      `SELECT employeeID, maternitytypeID, startDate, endDate FROM maternity_emp WHERE maternityID = ? LIMIT 1`,
      [Number(id)]
    );

    if (!existingMaternity || existingMaternity.length === 0) {
      return res.status(404).json({ success: false, message: "Maternidad no encontrada." });
    }

    const { employeeID, maternitytypeID, startDate, endDate } = existingMaternity[0];
    const maternityType = Number(maternitytypeID);
    const isPreMaternity = maternityType === 1;
    const isPostMaternity = maternityType === 2;

    // Eliminar el registro de maternidad
    const [r] = await db.query(
      `DELETE FROM maternity_emp WHERE maternityID = ?`,
      [Number(id)]
    );

    if (r.affectedRows === 0) {
      return res.status(404).json({ success: false, message: "Maternidad no encontrada." });
    }

    // LIMPIEZA DE EXCEPCIONES AL ELIMINAR
    if (isPreMaternity) {
      // Si se borra el Prenatal, la excepción de embarazada ya no debe terminar un día antes del prenatal.
      // Se limpia la fecha fin asignada por ese prenatal.
      const pregnantEndDate = dayjs(startDate).subtract(1, "day").format("YYYY-MM-DD");

      const [excRows] = await db.query(
        `SELECT exceptionID FROM exceptions_emp WHERE LOWER(exceptionName) LIKE '%embarazada%' LIMIT 1`
      );

      if (excRows.length > 0) {
        const exceptionID = excRows[0].exceptionID;

        await db.query(
          `UPDATE h_assigmentexception_emp
           SET endDate = NULL, updatedDate = NOW(), updatedBy = ?
           WHERE employeeID = ? AND exceptionID = ? AND DATE(endDate) = ?`,
          [getUserIdFromToken(req) || null, employeeID, exceptionID, pregnantEndDate]
        );
      }
    } else if (isPostMaternity) {
      // Si se borra el Postnatal, eliminamos la excepción de lactancia generada
      const lactationStartDate = dayjs(endDate).add(1, "day").format("YYYY-MM-DD");
      const previousExceptionEndDate = dayjs(lactationStartDate)
        .subtract(1, "day")
        .format("YYYY-MM-DD");
      const noExceptionStartDate = dayjs(startDate).add(6, "month").add(1, "day").format("YYYY-MM-DD");

      const [excRows] = await db.query(
        `SELECT exceptionID FROM exceptions_emp WHERE LOWER(exceptionName) LIKE '%lactancia%' LIMIT 1`
      );

      if (excRows.length > 0) {
        const exceptionID = excRows[0].exceptionID;

        await db.query(
          `DELETE FROM h_assigmentexception_emp
           WHERE employeeID = ? AND exceptionID = ? AND DATE(startDate) = ?`,
          [employeeID, exceptionID, lactationStartDate]
        );

        await db.query(
          `UPDATE h_assigmentexception_emp
           SET endDate = NULL,
               updatedDate = NOW(),
               updatedBy = ?
           WHERE employeeID = ?
             AND exceptionID <> ?
             AND DATE(startDate) < ?
             AND DATE(endDate) = ?`,
          [
            getUserIdFromToken(req) || null,
            employeeID,
            exceptionID,
            lactationStartDate,
            previousExceptionEndDate,
          ]
        );
      }

      const [noExceptionRows] = await db.query(
        `SELECT exceptionID FROM exceptions_emp WHERE LOWER(exceptionName) LIKE '%sin excepciones%' LIMIT 1`
      );

      if (noExceptionRows.length > 0) {
        await db.query(
          `DELETE FROM h_assigmentexception_emp
           WHERE employeeID = ? AND exceptionID = ? AND DATE(startDate) = ?`,
          [employeeID, noExceptionRows[0].exceptionID, noExceptionStartDate]
        );
      }
    }

    io.emit("maternity:deleted", { maternityID: Number(id) });

    return res.json({ success: true, message: "Maternidad y sus excepciones asociadas eliminadas correctamente." });
  } catch (err) {
    console.error("deleteMaternityById error:", err);
    return res.status(500).json({ success: false, message: "Error al eliminar maternidad" });
  }
};

