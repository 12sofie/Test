exports.disabilityPage = async (req, res) => {
  try {
    const { page = 1, limit = 50, q = "", from = "", to = "" } = req.query;
    const offset = (Number(page) - 1) * Number(limit);
    const like = `%${q}%`;

    const sql = `
  SELECT
    d.disabilityID,
    d.disabilityTypeID,
    d.extByID,
    exd.name AS extByName,
    d.employeeID,
    d.weekPaid,
    e.codeEmployee,
    CONCAT(COALESCE(e.firstName,''),' ',COALESCE(e.lastName,'')) AS employeeName,
    dt.disabilityName AS disabilityTypeName,
    d.startTime,
    d.startDate,
    d.endDate,
    d.documentation,
    d.comment,
    d.createdDate,
    d.createdBy,
    d.updatedDate,
    d.updatedBy
  FROM disability_emp AS d
  LEFT JOIN employees_emp AS e ON e.employeeID = d.employeeID
  LEFT JOIN disabilitytype_emp AS dt ON dt.disabilityTypeID = d.disabilityTypeID
  LEFT JOIN extdisability_emp AS exd ON exd.extByID = d.extByID
  WHERE (? = ''
    OR e.firstName LIKE ?
    OR e.lastName LIKE ?
    OR e.codeEmployee LIKE ?
    OR dt.disabilityName LIKE ?
    OR d.comment LIKE ?
    OR exd.name LIKE ?
  )
  ${from && to ? "AND NOT (DATE(d.endDate) < DATE(?) OR DATE(d.startDate) > DATE(?))" : ""}
  ORDER BY d.createdDate DESC
  LIMIT ? OFFSET ?;
`;

    const params = [
      q, like, like, like, like, like, like,
      ...(from && to ? [from, to] : []),
      Number(limit), Number(offset),
    ];
    const [rows] = await db.query(sql, params);

    const countSql = `
      SELECT COUNT(*) AS total
      FROM disability_emp AS d
      LEFT JOIN employees_emp AS e ON e.employeeID = d.employeeID
      LEFT JOIN disabilitytype_emp AS dt ON dt.disabilityTypeID = d.disabilityTypeID
        LEFT JOIN extdisability_emp AS exd ON exd.extByID = d.extByID
      WHERE (? = ''
        OR e.firstName LIKE ?
        OR e.lastName LIKE ?
        OR e.codeEmployee LIKE ?
        OR dt.disabilityName LIKE ?
        OR d.comment LIKE ?
        OR exd.name LIKE ?
      );
    `;
    const [[{ total }]] = await db.query(countSql, [
      q,
      like,
      like,
      like,
      like,
      like,
      like,
    ]);

    return res.json({
      success: true,
      data: rows,
      page: Number(page),
      limit: Number(limit),
      total,
    });
  } catch (err) {
    console.error("disabilityPage error:", err);
    return res
      .status(500)
      .json({ success: false, message: "Error obteniendo incapacidades." });
  }
};

exports.addDisability = async (req, res) => {
  const {
    disabilityTypeID,
    extByID,
    employeeID,
    weekPaid,
    startTime,
    startDate,
    endDate,
    documentation,
    comment,
    deletePermission,
    permByDateInfo
  } = req.body;

  try {

    const normalizeTime = (v) => {
      if (!v) return dayjs().format("HH:mm:ss"); // default: ahora
      const s = String(v).trim();

      // acepta HH:mm o HH:mm:ss
      const re = /^([01]\d|2[0-3]):[0-5]\d(:[0-5]\d)?$/;
      if (!re.test(s)) return null;

      return s.length === 5 ? `${s}:00` : s; // HH:mm -> HH:mm:ss
    };

    const startTimeDB = normalizeTime(startTime);
    if (!startTimeDB) {
      return res.status(400).json({
        success: false,
        message: "Hora inválida. Usa formato HH:mm o HH:mm:ss.",
