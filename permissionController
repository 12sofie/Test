exports.maternityPage = async (req, res) => {
  try {
    const { page = 1, limit = 100, q = "", from = "", to = "" } = req.query;
    const offset = (Number(page) - 1) * Number(limit);
    const like = `%${q}%`;

    const hasRange = !!(from && to);

    const whereSearch = `
      (? = ''
        OR e.codeEmployee LIKE ?
        OR e.firstName LIKE ?
        OR e.lastName LIKE ?
        OR mt.maternityType LIKE ?
        OR m.comment LIKE ?
      )
    `;

    const whereRange = hasRange
      ? `AND NOT (DATE(m.endDate) < DATE(?) OR DATE(m.startDate) > DATE(?))`
      : ``;

    const sql = `
      SELECT
        m.maternityID,
        m.employeeID,
        '-' weekPaid,
        e.codeEmployee,
        CONCAT(
          COALESCE(e.firstName,''), ' ',
          COALESCE(e.middleName,''), ' ',
          COALESCE(e.lastName,'')
        ) AS employeeName,
        m.maternitytypeID,
        mt.maternityType AS maternityTypeName,
        '' startTime,
        m.startDate,
        m.endDate,
        m.comment,
        m.documentation,
        m.createDate AS createdDate
      FROM maternity_emp m
      INNER JOIN employees_emp e ON e.employeeID = m.employeeID
      LEFT JOIN maternitytype_emp mt ON mt.maternitytypeID = m.maternitytypeID
      WHERE ${whereSearch}
      ${whereRange}
      ORDER BY m.maternityID DESC
      LIMIT ? OFFSET ?;
    `;

    const params = [
      q, like, like, like, like, like,
      ...(hasRange ? [from, to] : []),
      Number(limit), Number(offset),
    ];

    const [rows] = await db.query(sql, params);

    // (Opcional pero recomendado) total para paginación real
    const countSql = `
      SELECT COUNT(*) AS total
      FROM maternity_emp m
      INNER JOIN employees_emp e ON e.employeeID = m.employeeID
      LEFT JOIN maternitytype_emp mt ON mt.maternitytypeID = m.maternitytypeID
      WHERE ${whereSearch}
      ${whereRange};
    `;

    const countParams = [
      q, like, like, like, like, like,
      ...(hasRange ? [from, to] : []),
    ];

    const [[{ total }]] = await db.query(countSql, countParams);

    return res.json({
      success: true,
      data: rows,
      page: Number(page),
      limit: Number(limit),
      total,
    });
  } catch (err) {
    console.error("maternityPage error:", err);
    return res.status(500).json({
      success: false,
      message: "Error al cargar maternidades",
    });
  }
};

