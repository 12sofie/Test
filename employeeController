const obtenerDiasDisponibles = (hireDate, vacacionesTomadas) => {
  const hoy = new Date();
  const ingreso = new Date(hireDate);

  // Antigüedad total en años (decimal)
  const antiguedadAnios = (hoy - ingreso) / (1000 * 60 * 60 * 24 * 365);

  // Función auxiliar para obtener días según año de antigüedad
  const diasPorAntiguedad = (anio) => {
    if (anio < 1) return 10; // Primer año: 10 días
    else if (anio < 2) return 10;
    else if (anio < 3) return 12;
    else if (anio < 4) return 15;
    else return 20;
  };

  let totalVacaciones = 0;

  if (antiguedadAnios < 1) {
    // Para empleados con menos de 1 año: días proporcionales
    // Ejemplo: 0.52 años = 0.52 * 10 = 5.2 días
    totalVacaciones = antiguedadAnios * 10;
  } else {
    // Años completos trabajados
    const aniosCompletos = Math.floor(antiguedadAnios);

    // Días totales por años completos
    let diasCompletos = 0;
    for (let i = 1; i <= aniosCompletos; i++) {
      diasCompletos += diasPorAntiguedad(i);
    }

    // Año actual (incompleto) - solo si hay fracción de año adicional
    const fraccionAnoActual = antiguedadAnios - aniosCompletos;
    if (fraccionAnoActual > 0) {
      const diasDelSiguienteAno = diasPorAntiguedad(aniosCompletos + 1);
      const diasProporcionales = fraccionAnoActual * diasDelSiguienteAno;
      totalVacaciones = diasCompletos + diasProporcionales;
    } else {
      totalVacaciones = diasCompletos;
    }
  }

  return {
    vacacionesDisponibles:
      Math.round((totalVacaciones - vacacionesTomadas) * 100) / 100,
    antiguedad: Math.round(antiguedadAnios * 100) / 100,
  };
};

