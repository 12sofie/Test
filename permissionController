exports.addInreview = async (req, res) => {
  // Ajustamos la desestructuración para que coincida con lo que envía tu formulario React
  const {
    employeeID,
    startTime,
    startDate,
    endDate,
    comment
  } = req.body;

  try {
    const normalizeTime = (v) => {
      if (!v) return dayjs().format("HH:mm:ss");
      const s = String(v).trim();
      const re = /^([01]\d|2[0-3]):[0-5]\d(:[0-5]\d)?$/;
      if (!re.test(s)) return null;
      return s.length === 5 ? `${s}:00` : s;
    };

    const startTimeDB = normalizeTime(startTime);
    if (!startTimeDB) {
      return res.status(400).json({
        success: false,
        message: "Hora inválida. Usa formato HH:mm o HH:mm:ss.",
      });
    }
    const formattedStartDate = dayjs(startDate).format("YYYY-MM-DD");
    const formattedEndDate = dayjs(endDate).format("YYYY-MM-DD");


    // VALIDACIÓN DE TRASLAPE/DUPLICIDAD

    const [overlapping] = await db.query(
      `SELECT inreviewID FROM inreview_emp 
       WHERE employeeID = ? 
         AND startDate <= ? 
         AND endDate >= ?`,
      [employeeID, formattedEndDate, formattedStartDate]
    );

    if (overlapping.length > 0) {
      return res.status(400).json({
        success: false,
        message: "El empleado ya tiene una revisión registrada que se traslapa con estas fechas.",
      });
    }


    const [result] = await db.query(
      `INSERT INTO inreview_emp (
        employeeID, 
        startDate, 
        startTime, 
        endDate, 
        comment, 
        createdDate, 
        createdBy
      )
       VALUES (?, ?, ?, ?, ?, ?, ?)`,
      [
        employeeID,
        dayjs(startDate).format("YYYY-MM-DD"),
        startTimeDB,
        dayjs(endDate).format("YYYY-MM-DD"),
        comment || null,
        ...camposAuditoriaADD(req),
      ]
    );

    res.status(201).json({
      success: true,
      message: "Revisión de empleado registrada correctamente",
      insertId: result.insertId,
    });
  } catch (error) {
    console.error(error);
    res.status(500).json({
      success: false,
      message: "Error al registrar la revisión"
    });
  }
};

exports.pendingPage = async (req, res) => {
  try {
    const { page = 1, limit = 50, q = "", from = "", to = "" } = req.query;
    const offset = (Number(page) - 1) * Number(limit);
    const like = `%${q}%`;

    const dateFilter = from && to ?
      "AND NOT (DATE(r.endDate) < DATE(?) OR DATE(r.startDate) > DATE(?))" : "";

    const sql = `
      SELECT
        r.inreviewID,
        r.employeeID,
        e.codeEmployee,
        CONCAT(
          COALESCE(e.firstName, ''), ' ',
          COALESCE(e.middleName, ''), ' ',
          COALESCE(e.lastName, '')
        ) AS employeeName,
        r.startDate,
        r.startTime,
        r.endDate,
        r.comment,
        r.createdDate,
        r.createdBy
      FROM inreview_emp AS r
      LEFT JOIN employees_emp AS e ON e.employeeID = r.employeeID
      WHERE (? = ''
        OR e.firstName LIKE ?
        OR e.lastName LIKE ?
        OR e.codeEmployee LIKE ?
        OR r.comment LIKE ?
      )
      ${dateFilter}
      ORDER BY CAST(e.codeEmployee AS UNSIGNED) ASC, r.createdDate DESC
      LIMIT ? OFFSET ?;
    `;

    const params = [
      q,
      like,
      like,
      like,
      like,
      ...(from && to ? [from, to] : []),
      Number(limit),
      Number(offset),
    ];

    const [rows] = await db.query(sql, params);

    const countSql = `
      SELECT COUNT(*) AS total
      FROM inreview_emp AS r
      LEFT JOIN employees_emp AS e ON e.employeeID = r.employeeID
      WHERE (? = ''
        OR e.firstName LIKE ?
        OR e.lastName LIKE ?
        OR e.codeEmployee LIKE ?
        OR r.comment LIKE ?
      )
      ${dateFilter};
    `;

    const [[{ total }]] = await db.query(countSql, [
      q,
      like,
      like,
      like,
      like,
      ...(from && to ? [from, to] : []),
    ]);

    return res.json({
      success: true,
      data: rows,
      page: Number(page),
      limit: Number(limit),
      total,
    });
  } catch (error) {
    console.error("pendingPage error:", error);
    return res.status(500).json({
      success: false,
      message: "Error obteniendo revisiones pendientes",
    });
  }
};

exports.updatePending = async (req, res) => {
  try {
    const { id } = req.params; // inreviewID
    const { startDate, startTime, endDate, comment } = req.body;

    if (!id) {
      return res.status(400).json({
        success: false,
        message: "Falta ID de la revisión.",
      });
    }

    const normalizeTime = (v) => {
      if (!v) return null;
      const s = String(v).trim();
      const re = /^([01]\d|2[0-3]):[0-5]\d(:[0-5]\d)?$/;
      if (!re.test(s)) return null;
      return s.length === 5 ? `${s}:00` : s;
    };

    // Validación de rango de fechas si vienen ambas
    if (startDate && endDate && dayjs(startDate).isAfter(dayjs(endDate))) {
      return res.status(400).json({
        success: false,
        message: "La fecha de inicio no puede ser mayor que la de fin.",
      });
    }

    // Construye la consulta SET dinámicamente
    const fields = [];
    const vals = [];

    if (startDate) {
      fields.push("startDate=?");
      vals.push(dayjs(startDate).format("YYYY-MM-DD"));
    }
    if (startTime) {
      const normalizedTime = normalizeTime(startTime);
      if (!normalizedTime) {
        return res.status(400).json({
          success: false,
          message: "Hora inválida. Usa formato HH:mm o HH:mm:ss.",
        });
      }
      fields.push("startTime=?");
      vals.push(normalizedTime);
    }
    if (endDate) {
      fields.push("endDate=?");
      vals.push(dayjs(endDate).format("YYYY-MM-DD"));
    }
    if (comment !== undefined) {
      fields.push("comment=?");
      vals.push(comment);
    }

    // Si no hay campos para actualizar, no hagas nada
    if (fields.length === 0) {
      return res.status(400).json({
        success: false,
        message: "No hay campos para actualizar.",
      });
    }

    vals.push(id);

    const sql = `UPDATE inreview_emp SET ${fields.join(", ")} WHERE inreviewID = ?`;
    const [result] = await db.query(sql, vals);

    if (result.affectedRows === 0) {
      return res.status(404).json({
        success: false,
        message: "Revisión no encontrada.",
      });
    }

    return res.json({
      success: true,
      message: "Revisión actualizada correctamente.",
    });
  } catch (error) {
    console.error("updatePending error:", error);
    return res.status(500).json({
      success: false,
      message: "Error al actualizar la revisión.",
    });
  }
};

