// Configuración de almacenamiento con nombre personalizado
const storage = multer.diskStorage({
  destination: (req, file, cb) => {
    cb(null, "public/EmpPht");
  },
  filename: (req, file, cb) => {
    const employeeCode = req.params.employeeID;
    const ext = path.extname(file.originalname);
    const filename = `${employeeCode}${ext}`;

    // Elimina archivo existente con el mismo nombre si ya existe
    const filePath = path.join("public/EmpPht", filename);
    if (fs.existsSync(filePath)) {
      fs.unlinkSync(filePath);
    }

    cb(null, filename);
  },
});

const upload = multer({ storage });

const currentEmployeeShiftSubquery = `
  COALESCE(
    (
      SELECT hs.shiftID
      FROM h_assigmentshift_emp hs
      WHERE hs.employeeID = e.employeeID
        AND CURDATE() BETWEEN DATE(hs.startDate)
        AND COALESCE(DATE(hs.endDate), DATE('9999-12-31'))
      ORDER BY hs.startDate DESC, hs.hassigmentshiftID DESC
      LIMIT 1
    ),
    e.shiftID
  )
`;

// Obtener todos los empleados (paginado y filtrado)
exports.getEmployees = async (req, res) => {
  try {
    const page = Math.max(1, parseInt(req.query.page) || 1);
    const limit = Math.min(200, Math.max(1, parseInt(req.query.limit) || 20));
    const offset = (page - 1) * limit;

    const filters = [];
    const params = [];

    if (req.query.codeEmployee) {
      filters.push("e.codeEmployee LIKE ?");
      params.push(`%${req.query.codeEmployee}%`);
    }
    if (req.query.fullName) {
      filters.push("concat(firstName, ' ', middleName, ' ', lastName, ' ', secondLastName) LIKE ?");
      params.push(`%${req.query.fullName}%`);
    }
    if (req.query.departmentID) {
      filters.push("dep.departmentID = ?");
      params.push(req.query.departmentID.departmentID);
    }
    if (req.query.areaID) {
      filters.push("a.areaID = ?");
      params.push(req.query.areaID.areaID);
    }
    if (req.query.divisionID) {
      filters.push("di.divisionID = ?");
      params.push(req.query.divisionID.divisionID);
    }
    if (req.query.jobID) {
      filters.push("j.jobID = ?");
      params.push(req.query.jobID.jobID);
    }
    if (req.query.shiftID) {
      filters.push(`${currentEmployeeShiftSubquery} = ?`);
      params.push(req.query.shiftID);
    }
    if (req.query.isActive) { // Active  = 1, Inactive = 0, All = -1
      if (req.query.isActive !== "-1") {
        filters.push("e.isActive = ?");
        params.push(req.query.isActive);
      }
    }

    const whereClause = filters.length
      ? `WHERE e.companyID = 1 AND ${filters.join(" AND ")}`
      : "WHERE e.companyID = 1";
    const baseQuery = `
      FROM employees_emp e
        INNER JOIN division_emp di  ON di.divisionID   = e.divisionID
        INNER JOIN area_emp a       ON a.areaID         = e.areaID
        INNER JOIN department_emp dep ON dep.departmentID = e.departmentID
        LEFT JOIN shifts_emp shi    ON shi.shiftID     = ${currentEmployeeShiftSubquery}
        INNER JOIN jobs_emp j       ON j.jobID          = e.jobID
      ${whereClause}`;

    const [[{ total }]] = await db.query(
      `SELECT COUNT(*) AS total ${baseQuery}`,
      params
    );
    //para programacion de turnos    
    // dep.departmentName, j.jobName, e.incapacitated, e.shiftID, shi.shiftName,
    const [employees] = await db.query(
      `SELECT
          e.employeeID, e.codeEmployee,
          concat(firstName, " ", middleName, " ", lastName, " ", secondLastName) fullName,
          di.divisionName, a.areaName,
          dep.departmentName, j.jobName, e.incapacitated,
          ${currentEmployeeShiftSubquery} AS effectiveShiftID,
          shi.shiftName,
          if(e.isActive, 'ACTIVO', 'INACTIVO') isActive,
          e.evaluationStep, e.hireDate, e.exceptionID, e.requiredAttendance
       ${baseQuery}
       ORDER BY e.employeeID ASC
       LIMIT ? OFFSET ?`,
      [...params, limit, offset]
    );

    //para programacion de turnos
    // // e.shiftID, 
    //       shi.shiftName
    //     FROM employees_emp e
    //     LEFT JOIN shifts_emp shi ON shi.shiftID = e.shiftID
    // Obtener todos los empleados activos
    const [employeesActives] = await db.query(
      `SELECT
          e.employeeID, e.codeEmployee,
          concat(firstName, " ", middleName, " ", lastName, " ", secondLastName) fullName,
          e.exceptionID,
          e.shiftID, 
          shi.shiftName
        FROM employees_emp e
        LEFT JOIN shifts_emp shi ON shi.shiftID = e.shiftID
        Where e.isActive = 1
       ORDER BY e.employeeID ASC
      `
    );

    res.json({
      data: employees,
      employeesActives: employeesActives,
      pagination: {
        total,
        page,
        limit,
        totalPages: Math.ceil(total / limit),
      },
    });
  } catch (error) {
    console.error(error);
    res.status(500).json({ message: "Error al obtener datos de empleados" });
  }
};

exports.exportEmployeesToExcelWithFilters = async (req, res) => {
  try {
    const filters = [];
    const params = [];

    if (req.query.codeEmployee) {
      filters.push("e.codeEmployee LIKE ?");
      params.push(`%${req.query.codeEmployee}%`);
    }
    if (req.query.fullName) {
      filters.push("concat(firstName, ' ', middleName, ' ', lastName, ' ', secondLastName) LIKE ?");
      params.push(`%${req.query.fullName}%`);
    }
    if (req.query.departmentID) {
      filters.push("dep.departmentID = ?");
      params.push(req.query.departmentID.departmentID);
    }
    if (req.query.areaID) {
      filters.push("a.areaID = ?");
      params.push(req.query.areaID.areaID);
    }
    if (req.query.divisionID) {
      filters.push("di.divisionID = ?");
      params.push(req.query.divisionID.divisionID);
    }
    if (req.query.jobID) {
      filters.push("j.jobID = ?");
      params.push(req.query.jobID.jobID);
    }
    if (req.query.shiftID) {
      filters.push(`${currentEmployeeShiftSubquery} = ?`);
      params.push(req.query.shiftID);
    }
    if (req.query.isActive) { // Active  = 1, Inactive = 0, All = -1
      if (req.query.isActive !== "-1") {
        filters.push("e.isActive = ?");
        params.push(req.query.isActive);
      }
    }

    const whereClause = filters.length
      ? `WHERE e.companyID = 1 AND ${filters.join(" AND ")}`
      : "WHERE e.companyID = 1";

    const baseQuery = `
      FROM employees_emp e
        INNER JOIN division_emp di  ON di.divisionID   = e.divisionID
        INNER JOIN area_emp a       ON a.areaID         = e.areaID
        INNER JOIN department_emp dep ON dep.departmentID = e.departmentID
        LEFT JOIN shifts_emp shi    ON shi.shiftID     = ${currentEmployeeShiftSubquery}
        INNER JOIN jobs_emp j       ON j.jobID          = e.jobID
      ${whereClause}`;

    const [employees] = await db.query(
      `SELECT
          e.employeeID, e.codeEmployee,
          concat(firstName, " ", middleName, " ", lastName, " ", secondLastName) fullName,
          di.divisionName, a.areaName, dep.departmentName, j.jobName,
          ${currentEmployeeShiftSubquery} AS effectiveShiftID,
          shi.shiftName, if(e.isActive, 'ACTIVO', 'INACTIVO') isActive,
          e.hireDate
       ${baseQuery}
       ORDER BY e.employeeID ASC`,
      [...params]
    );

    const workbook = new ExcelJS.Workbook();
    const sheet = workbook.addWorksheet("Empleados");

    // Encabezados
    sheet.columns = [
      { header: "Código", key: "codeEmployee", width: 12 },
      { header: "Nombre", key: "fullName", width: 36 },
      { header: "División", key: "divisionName", width: 18 },
      { header: "Área", key: "areaName", width: 20 },
      { header: "Departamento", key: "departmentName", width: 22 },
      { header: "Cargo", key: "jobName", width: 24 },
      { header: "Turno", key: "shiftName", width: 12 },
      { header: "Estado", key: "isActive", width: 10 },
      { header: "Fecha ingreso", key: "hireDate", width: 16 },
    ];

    // Estilo de encabezado
    sheet.getRow(1).eachCell((cell) => {
      cell.font = { bold: true, color: { argb: "FFFFFFFF" } };
      cell.fill = {
        type: "pattern",
        pattern: "solid",
        fgColor: { argb: "FF1F3864" },
      };
      cell.alignment = { vertical: "middle", horizontal: "center" };
      cell.border = {
        bottom: { style: "thin", color: { argb: "FFAAAAAA" } },
      };
    });

    // Filas de datos
    employees.forEach((emp, index) => {
      const row = sheet.addRow({
        ...emp,
        hireDate: emp.hireDate
          ? dayjs(emp.hireDate).format("DD/MM/YYYY")
          : "",
      });

      // Alternar color de fila
      if (index % 2 === 0) {
        row.eachCell((cell) => {
          cell.fill = {
            type: "pattern",
            pattern: "solid",
            fgColor: { argb: "FFEEF2F7" },
          };
        });
      }

      row.eachCell((cell) => {
        cell.alignment = { vertical: "middle" };
      });
    });

    // Fila de totales
    const totalRow = sheet.addRow(["", "", `Total: ${employees.length} empleados`]);
    totalRow.getCell(3).font = { bold: true };

    res.setHeader(
      "Content-Type",
      "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
    );
    res.setHeader(
      "Content-Disposition",
      `attachment; filename="empleados_${dayjs().format("YYYYMMDD_HHmmss")}.xlsx"`
    );

    await workbook.xlsx.write(res);
    res.end();
  } catch (error) {
    console.error(error);
    res.status(500).json({ message: "Error al exportar datos de empleados" });
  }
};

