    // Se considera válido si está activa antes del nuevo inicio y no termina antes de ese punto.
    await db.query(
      `UPDATE h_assigmentshift_emp
       SET endDate = DATE_SUB(?, INTERVAL 1 DAY)
       WHERE employeeID = ?
         AND DATE(startDate) < ?
         AND (endDate IS NULL OR DATE(endDate) >= ?)
         AND shiftID <> ?`,
      [formattedStartDate, employeeID, formattedStartDate, formattedStartDate, shiftID]
    );

