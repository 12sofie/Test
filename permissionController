exports.getEmployeeAttendance = async (req, res) => {
  try {
    const { employeeID, dayPermission } = req.params;
    let currentTime = dayjs().format("HH:mm:ss");
    let currentDate = dayjs().format("YYYY-MM-DD");
    let dayString = dayjs(dayPermission)
      .locale("en")
      .format("dddd");

    const [shiftDetail] = await db.query(
      `
        SELECT
          s.shiftID, ds.day, s.shiftName, ds.startTime, ds.endTime
        FROM detailsshift_emp ds
        INNER JOIN shifts_emp s ON ds.shiftID = s.shiftID
        WHERE s.companyID = 1
          AND ds.day = '${dayString}'
          AND (
          (ds.startTime < ds.endTime AND '${currentTime}' BETWEEN ds.startTime AND ds.endTime)
          OR
          (ds.startTime > ds.endTime AND
          ('${currentTime}' >= ds.startTime OR '${currentTime}' <= ds.endTime))
        )
      `
    );

    const [dataEmployee] = await db.query(
      `    
          SELECT 
              e.codeEmployee, a.entryTime, s.shiftName, d.startTime, d.endTime, d.day
          FROM employees_emp e
          INNER JOIN jobs_emp j ON e.jobID = j.jobID
          LEFT JOIN h_assigmentshift_emp hs ON hs.employeeID = e.employeeID
            AND DATE(hs.startDate) <= ?
            AND (hs.endDate IS NULL OR DATE(hs.endDate) >= ?)
          INNER JOIN shifts_emp s ON s.shiftID = COALESCE(hs.shiftID, e.shiftID)
          INNER JOIN detailsshift_emp d ON d.shiftID = s.shiftID
          LEFT JOIN h_attendance_emp a 
              ON e.employeeID = a.employeeID 
            AND a.date = ?
          WHERE e.employeeID = ?
          AND d.day = ?;
