// Eliminar vacaciones de empleado
exports.deleteEmployeeVacation = async (req, res) => {
  const language = req.headers["accept-language"] || "en";
  const { vacationID } = req.params;
  if (!isValidNumber(vacationID)) {
    return res.status(500).json({ message: "ID de vacaciones inválido" });
  }
  try {
    await db.query("DELETE FROM vacations_emp WHERE vacationID = ?", [
      vacationID,
    ]);
    res.status(200).json({ message: t("deleteSuccess", language) });
  } catch (error) {
    console.error("Error al eliminar vacaciones:", error);
    res.status(500).json({ message: t("deleteError", language) });
  }
};

exports.deleteVacationByDate = async (req, res) => {
  const language = (req.headers["accept-language"] || "en").toLowerCase();
  const { employeeID, date } = req.query;

  const isValidNumber = (v) => /^\d+$/.test(String(v || "").trim());
  const isValidDate = (v) => /^\d{4}-\d{2}-\d{2}$/.test(String(v || "").trim());

  if (!isValidNumber(employeeID)) {
    return res.status(400).json({ message: "employeeID inválido" });
  }
  if (!isValidDate(date)) {
    return res.status(400).json({ message: "Fecha inválida (YYYY-MM-DD)" });
  }

  try {
    // 👇 AJUSTA vacationDate al nombre real
    const [result] = await db.query(
      `DELETE FROM vacations_emp
       WHERE employeeID = ? AND DATE(date) = ?`,
      [employeeID, date]
    );

    if (!result?.affectedRows) {
      return res.status(404).json({ message: "No se encontró esa vacación para eliminar" });
    }

    return res.status(200).json({ message: t("deleteSuccess", language) || "Eliminado correctamente" });
  } catch (error) {
    console.error("Error al eliminar vacaciones (by date):", error);
    return res.status(500).json({ message: t("deleteError", language) || "Error al eliminar" });
  }
};

// Agregar días de permisos especiales.
exports.addEmployeePermissionSpecial = async (req, res) => {
  const language = req.headers["accept-language"] || "en";

  try {
    const { dates, employees } = req.body;

    if (!Array.isArray(employees) || employees.length === 0 || !dates || !Array.isArray(dates) || dates.length === 0) {
      return res.status(400).json({
        success: false,
        message: t("requiredFields", language),
      });
    }

    const cleanEmployees = Array.from(
      new Set(
        employees
          .map((id) => Number(id))
          .filter((id) => Number.isInteger(id) && id > 0)
      )
    );

    const cleanDates = Array.from(
      new Set(
        dates
          .map((d) => dayjs(d).format("YYYY-MM-DD"))
          .filter((d) => d !== "Invalid Date" && dayjs(d, "YYYY-MM-DD", true).isValid())
      )
    );

    if (cleanEmployees.length === 0 || cleanDates.length === 0) {
      return res.status(400).json({
        success: false,
        message: t("requiredFields", language),
      });
    }

    const auditFields = camposAuditoriaADD(req);
    const valuesToInsert = [];
    const skippedMessages = [];

    // Validar cada combinación empleado/fecha
    for (const employeeID of cleanEmployees) {
      for (const date of cleanDates) {

        // 1. Validar marcaje de asistencia
        const [attendance] = await db.query(
          `SELECT hattendanceID FROM h_attendance_emp WHERE employeeID = ? AND DATE(date) = ? LIMIT 1`,
          [employeeID, date]
        );

        if (attendance.length > 0) {
          const [[emp]] = await db.query(
            `SELECT codeEmployee, firstName, lastName FROM employees_emp WHERE employeeID = ?`,
            [employeeID]
          );
          skippedMessages.push(
            `Empleado ${emp?.codeEmployee || employeeID} - ${emp?.firstName || ''} ${emp?.lastName || ''} omitido: Ya marcó asistencia el ${date}`
          );
          continue; // Pasa al siguiente registro sin agregarlo
        }

        // 2. Validar si ya tiene baja carga registrada
        const [existingPermission] = await db.query(
          `SELECT permissionSpecialID FROM permissionspecial_emp WHERE employeeID = ? AND DATE(date) = ? LIMIT 1`,
          [employeeID, date]
        );

        if (existingPermission.length > 0) {
          const [[emp]] = await db.query(
            `SELECT codeEmployee, firstName, lastName FROM employees_emp WHERE employeeID = ?`,
            [employeeID]
          );
          skippedMessages.push(
            `Empleado ${emp?.codeEmployee || employeeID} - ${emp?.firstName || ''} ${emp?.lastName || ''} omitido: Ya tiene baja carga el ${date}`
          );
          continue; // Pasa al siguiente registro sin agregarlo
        }

        // Si supera las dos validaciones, se agrega a los inserts
        valuesToInsert.push([employeeID, date, ...auditFields]);
      }
    }

    // Si ningún empleado era apto para insertarse
    if (valuesToInsert.length === 0) {
      return res.status(400).json({
        success: false,
        message: "No se insertó ningún registro. Todos los empleados seleccionados ya registraron asistencia o tienen baja carga previa.",
        skipped: skippedMessages
      });
    }

    // Inserción masiva de los empleados válidos
    const [result] = await db.query(
      `
      INSERT INTO permissionspecial_emp
        (employeeID, date, createdDate, createdBy)
      VALUES ?
      `,
      [valuesToInsert]
    );

    return res.status(201).json({
      success: true,
      message: skippedMessages.length > 0
        ? `Se asignó la baja carga a los empleados disponibles (${result.affectedRows} registros). Omitidos: ${skippedMessages.length}`
        : t("saveSuccess", language),
      permissionSpecialID: result.insertId,
      insertedRows: result.affectedRows,
      skipped: skippedMessages
    });

  } catch (error) {
    console.error("Error al agregar permisos especiales:", error);
    res.status(500).json({
      success: false,
      message: t("saveError", language),
    });
  }
};
//permite ver los permisos de baja carga en menu de permisos
exports.vistaEmployeePermissionSpecialLow = async (req, res) => {
  const language = req.headers["accept-language"] || "en";
  let { startDate, endDate } = req.query;

  // Si no viene un rango de fechas, usar la actual para ambos límites
  if (!startDate || !endDate) {
    const hoy = new Date();
    const year = hoy.getFullYear();
    const month = String(hoy.getMonth() + 1).padStart(2, "0");
    const day = String(hoy.getDate()).padStart(2, "0");
    const hoyFormateado = `${year}-${month}-${day}`;

    if (!startDate) startDate = hoyFormateado;
    if (!endDate) endDate = hoyFormateado;
  }

  try {
    // 1. Obtener los permisos haciendo JOIN con empleados para poder ORDENAR correctamente
    let query = `
      SELECT 
        p.permissionSpecialID, 
        p.date, 
        p.employeeID, 
        p.createdDate, 
        p.createdBy,
        e.codeEmployee,
        CONCAT(
          IFNULL(e.firstName, ''), ' ',
          IFNULL(e.lastName, ''), ' ',
          IFNULL(e.secondLastName, '')
        ) AS fullName,
        l.linesNumber
      FROM permissionspecial_emp p
      INNER JOIN employees_emp e ON p.employeeID = e.employeeID
      LEFT JOIN employeeLines_emp el ON e.employeeID = el.employeeID
      LEFT JOIN lines_emp l ON el.linesID = l.linesID
    `;

    const queryParams = [];

    if (startDate && endDate) {
      query += ` WHERE p.date BETWEEN ? AND ? `;
      queryParams.push(startDate, endDate);
    }

    // CORREGIDO: Primero ordenamos numéricamente por código de empleado, y luego por la fecha del permiso
    query += ` ORDER BY p.date ASC, CAST(e.codeEmployee AS UNSIGNED) ASC, p.permissionSpecialID DESC `;

    const [rows] = await db.query(query, queryParams);

    if (rows.length === 0) {
      return res.status(200).json({ success: true, data: [] });
    }

    // 2. Mapear cada fila directamente al formato del cliente (ya viene ordenada de la BD)
    const result = rows.map((row) => {
      let d = row.date;
      if (d instanceof Date) {
        d = d.toISOString().split("T")[0];
      }
      // Formatear la fecha a YYYY/MM/DD para mantener el estilo visual
      const formattedDate = d ? d.replace(/-/g, "/") : "";

      return {
        permissionSpecialID: row.permissionSpecialID,
        permissionSpecialIDs: [row.permissionSpecialID],
        employeeID: row.employeeID,
        codeEmployee: row.codeEmployee || "",
        fullName: row.fullName ? row.fullName.trim().replace(/\s+/g, ' ') : "", // Limpia espacios dobles de nombres vacíos
        linesNumber: row.linesNumber || null,
        dates: [formattedDate],
        datesString: formattedDate
      };
    });

    return res.status(200).json({
      success: true,
      data: result,
    });

  } catch (error) {
    console.error("Error en vistaEmployeePermissionSpecial:", error);
    return res.status(500).json({
      success: false,
      message: t("saveError", language),
    });
  }
};

