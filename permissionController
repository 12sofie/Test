function parseTime(horaStr) {
  if (!horaStr) return null;
  const [h, m] = horaStr.split(":").map(Number);
  const date = new Date();
  date.setHours(h, m, 0, 0);
  return date;
}

function diffHoras(inicio, fin) {
  return Math.max((fin - inicio) / 3600000, 0);
}

function calcularHorasEmpleado({
  turnoInicio,
  turnoFin,
  permisos,
  entrada,
  salida,
}) {
  const LUNCH_HOURS = 0.75;

  turnoInicio = parseTime(turnoInicio);
  turnoFin = parseTime(turnoFin);
  entrada = parseTime(entrada);
  salida = parseTime(salida);

  // --- 1️⃣ Horas del turno ---
  const horasTurno = diffHoras(turnoInicio, turnoFin);

  // --- 2️⃣ Permisos ---
  let horasPermiso = 0;
  let permisoConAlmuerzo = false;
  permisos.forEach((p) => {
    const pInicio = parseTime(p.permitStartTime);
    const pFin = parseTime(p.permitEndTime);
    horasPermiso += diffHoras(pInicio, pFin);
    if (p.lunchTime) permisoConAlmuerzo = true;
  });

  // --- 3️⃣ Horas trabajadas ---
  let trabajoInicio = entrada
    ? entrada < turnoInicio
      ? turnoInicio
      : entrada
    : turnoInicio;
  let trabajoFin = salida ? (salida > turnoFin ? turnoFin : salida) : turnoFin;
  let horasTrabajadas = diffHoras(trabajoInicio, trabajoFin);

  // --- 4️⃣ Calcular huecos sin justificar (ausencias) ---
  permisos.sort(
    (a, b) => parseTime(a.permitStartTime) - parseTime(b.permitStartTime)
  );
  let horasAusente = 0;
  let cursor = turnoInicio;

  permisos.forEach((p) => {
    const pInicio = parseTime(p.permitStartTime);
    const pFin = parseTime(p.permitEndTime);

    // Si hay hueco entre cursor y inicio del permiso
    if (pInicio > cursor && pInicio > entrada) {
      const desde = cursor < entrada ? entrada : cursor;
      const hasta = pInicio > salida ? salida : pInicio;
      horasAusente += diffHoras(desde, hasta);
    }

    // Actualizar cursor
    if (pFin > cursor) cursor = pFin;
  });

  // Hueco después del último permiso antes de la entrada
  if (cursor < trabajoInicio) horasAusente += diffHoras(cursor, trabajoInicio);

  // --- 5️⃣ Aplicar descuento de almuerzo ---
  if (permisoConAlmuerzo) {
    horasPermiso = Math.max(horasPermiso - LUNCH_HOURS, 0);
  } else {
    horasTrabajadas = Math.max(horasTrabajadas - LUNCH_HOURS, 0);
  }

  // --- 6️⃣ Ajustar totales ---
  const total = horasPermiso + horasTrabajadas + horasAusente;
  const diferencia = horasTurno - total;
  if (Math.abs(diferencia) > 0.05) {
    horasAusente = Math.max(horasAusente + diferencia, 0);
  }

  return {
    horasTurno: horasTurno.toFixed(2),
    horasPermiso: horasPermiso.toFixed(2),
    horasTrabajadas: horasTrabajadas.toFixed(2),
    horasAusente: horasAusente.toFixed(2),
    descuentoAlmuerzo: permisoConAlmuerzo
      ? "Restado del permiso"
      : "Restado del trabajo",
  };
}

function calcularResumen(permisos, turnos) {
  const agrupados = {};

  // Agrupar por empleado y fecha
  for (const p of permisos) {
    const key = `${p.codeEmployee}-${dayjs(p.date).format("YYYY-MM-DD")}`;
    if (!agrupados[key]) agrupados[key] = [];
    agrupados[key].push(p);
  }

  const resultados = [];

  for (const [key, listaPermisos] of Object.entries(agrupados)) {
    const ejemplo = listaPermisos[0];
    const fecha = dayjs(ejemplo.date).format("YYYY-MM-DD");
    const diaSemana = dayjs(fecha).format("dddd").toUpperCase();

    // Buscar turno correspondiente
    const turno = turnos.find(
      (t) => t.shiftID === ejemplo.shiftID && t.day === diaSemana
    );

    if (!turno) continue;

    const resultado = calcularHorasEmpleado({
      turnoInicio: turno.startTime,
      turnoFin: turno.endTime,
      permisos: listaPermisos,
      entrada: ejemplo.entryTime,
      salida: ejemplo.exitTime,
    });

    resultados.push({
      codeEmployee: ejemplo.codeEmployee,
      fullName: ejemplo.fullName,
      fecha,
      horasTurno: resultado.horasTurno,
      horasPermiso: resultado.horasPermiso,
      horasTrabajadas: resultado.horasTrabajadas,
      horasAusente: resultado.horasAusente,
      descuentoAlmuerzo: resultado.descuentoAlmuerzo,
    });
  }

  return resultados;
}

// Calculo para horas trabajadas, tiempo en permiso y horas en ausente
exports.calculateTime = async (req, res) => {
  try {
    // Obtener datos de los turno
    const [turnos] = await db.query(
      `
   SELECT shiftID, day, startTime, endTime FROM detailsshift_emp;
    `
    );

    // Obtener datos del permiso
    const [permisos] = await db.query(
      `
              SELECT DISTINCT
          e.codeEmployee,
          CONCAT(e.firstName, ' ', e.middleName, ' ', e.lastName) AS fullName,
          payType.payrollName AS Planilla,
          COALESCE(hs.shiftID, e.shiftID) AS shiftID, p.date,
          p.permissionID,
          IF(dp.permitStartTime, dp.permitStartTime, p.exitPermission)  AS permitStartTime,
          IF(dp.permitEndTime,   dp.permitEndTime,   p.entryPermission) AS permitEndTime,
          -- horas del permiso
          IF(
              dp.permitStartTime IS NOT NULL,
              TIMESTAMPDIFF(MINUTE, dp.permitStartTime, dp.permitEndTime) / 60,
              TIMESTAMPDIFF(MINUTE, p.exitPermission, p.entryPermission) / 60 
          ) AS permisoHours,
          IFNULL(NULLIF(TRIM(dp.comment), ''), '-') AS commentText,
          -- regla de pago
          CASE 
              WHEN dp.withPay IS NOT NULL THEN 
                  CASE dp.withPay WHEN 1 THEN 'Con goce' ELSE 'Sin goce' END
              ELSE 
                  CASE p.isPaid  WHEN 1 THEN 'Con goce' ELSE 'Sin goce' END
          END AS Pago,
		  -- regla de almuerzo
          CASE 
              WHEN dp.lunchTime IS NOT NULL THEN 
                  CASE dp.lunchTime WHEN 1 THEN true ELSE false END
              ELSE 
                  CASE p.lunchTime  WHEN 1 THEN true ELSE false END
          END AS lunchTime,
          h.employeeID, h.entryTime, h.exitTime
          FROM permissionattendance_emp p
          LEFT JOIN detailpermission_emp dp ON dp.permissionID = p.permissionID
          INNER JOIN employees_emp e         ON e.employeeID = p.employeeID
          LEFT JOIN h_attendance_emp h
		  ON h.employeeID = e.employeeID
		  AND h.date between ? AND ?
          INNER JOIN payrolltype_emp payType ON payType.payrollTypeID = e.payrollTypeID
          LEFT JOIN h_assigmentshift_emp hs
            ON hs.employeeID = e.employeeID
           AND DATE(hs.startDate) <= DATE(p.date)
           AND (hs.endDate IS NULL OR DATE(hs.endDate) >= DATE(p.date))
          WHERE p.date BETWEEN ? AND ?
            AND p.isApproved = 1
          ORDER BY p.date ASC, e.codeEmployee ASC;
    `,
      ["20251006", "20251006", "20251006", "20251006"]
    );

    const resultados = calcularResumen(permisos, turnos);

    return res
      .status(200)
      .json({ success: true, data: resultados, message: "Cálculo realizado." });
  } catch (err) {
    console.error(err);
    return res
      .status(500)
      .json({ success: false, message: "Error al calcular tiempos." });
  }
};

