// Función para obtener todos los permisos registrados
exports.getAllPermissions = async (req, res) => {
  try {
    const [permissionResults] = await db.query(`
      SELECT
        pa.*,
        CONCAT(e.firstName, ' ', e.middleName, ' ', e.lastName) as fullName, e.codeEmployee,
        p.permissionTypeName, j.jobName, ua.username AS approvedByUsername,
        CONCAT(e_aprobador.firstName, ' ', e_aprobador.lastName) AS approvedByFullName,
        CONCAT(e_creador.firstName, ' ', e_creador.lastName) AS createdBy, pa.createdDate,
        att.entryTime AS attendanceEntry
      FROM
        permissionattendance_emp pa
        INNER JOIN permissiontype_emp p ON p.permissionTypeID = pa.permissionTypeID
        INNER JOIN employees_emp e ON e.employeeID = pa.employeeID
        INNER JOIN jobs_emp j ON e.jobID = j.jobID 
        LEFT JOIN users_us ua ON ua.userID = pa.approvedBy
        LEFT JOIN employees_emp e_aprobador ON e_aprobador.employeeID = ua.employeeID
        LEFT JOIN users_us uc ON uc.userID = pa.createdBy 
        LEFT JOIN employees_emp e_creador ON e_creador.employeeID = uc.employeeID 
        LEFT JOIN (
          SELECT employeeID, date, MIN(entryTime) AS entryTime
          FROM h_attendance_emp
          GROUP BY employeeID, date
        ) att ON pa.date = att.date AND pa.employeeID = att.employeeID
      WHERE pa.date BETWEEN '${dayjs().format(
      "YYYY-MM-DD"
    )}' AND '${dayjs().format("YYYY-MM-DD")}'
      ORDER BY pa.permissionID DESC;
    `);
    res.json(permissionResults);
  } catch (err) {
    console.error("Error fetching all permissions:", err);
    res.status(500).json({
      message: "Error al cargar todos los permisos",
      error: err.message,
    });
  }
};

// Función para obtener permisos con filtros
exports.getPermissionsWithFilter = async (req, res) => {
  try {
    const { startDate, endDate } = req.query;
    let filters = [];
    let params = [];
    if (isValidString(startDate)) {
      filters.push("pa.date >= ?");
      params.push(startDate);
    }
    if (isValidString(endDate)) {
      filters.push("pa.date <= ?");
      params.push(endDate);
    }
    const whereClause =
      filters.length > 0 ? `WHERE ${filters.join(" AND ")}` : "";
    const [permissionResults] = await db.query(
      `
      SELECT
        pa.*,
        CONCAT(e.firstName, ' ', e.middleName, ' ', e.lastName) as fullName, e.codeEmployee,
        p.permissionTypeName, j.jobName, ua.username AS approvedByUsername,
        CONCAT(e_aprobador.firstName, ' ', e_aprobador.lastName) AS approvedByFullName, isApproved,
        CONCAT(e_creador.firstName, ' ', e_creador.lastName) AS createdBy, pa.createdDate,
        att.entryTime AS attendanceEntry
      FROM
        permissionattendance_emp pa
        INNER JOIN permissiontype_emp p ON p.permissionTypeID = pa.permissionTypeID
        INNER JOIN employees_emp e ON e.employeeID = pa.employeeID
        INNER JOIN jobs_emp j ON e.jobID = j.jobID
        LEFT JOIN users_us ua ON ua.userID = pa.approvedBy
        LEFT JOIN employees_emp e_aprobador ON e_aprobador.employeeID = ua.employeeID
        LEFT JOIN users_us uc ON uc.userID = pa.createdBy
        LEFT JOIN employees_emp e_creador ON e_creador.employeeID = uc.employeeID
        LEFT JOIN (
          SELECT employeeID, date, MIN(entryTime) AS entryTime
          FROM h_attendance_emp
          GROUP BY employeeID, date
        ) att ON pa.date = att.date AND pa.employeeID = att.employeeID
      ${whereClause}
      ORDER BY pa.date ASC, e.codeEmployee ASC, pa.permissionID ASC;
      `,
      params
    );
    res.json(permissionResults);
  } catch (err) {
    console.error("Error fetching permissions with filter:", err);
    res.status(500).json({
      message: "Error al cargar permisos con filtro",
      error: err.message,
    });
  }
};

// Endpoint para exportar permisos a Excel del modal de Permissions
exports.exportPermissionsToExcel = async (req, res) => {
   
  try {
    const APP_TZ = "America/Tegucigalpa";
    const { date, startDate, endDate } = req.query;
   
    const toSQLDate = (d) => dayjs(d).format("YYYY-MM-DD");

    // --- Construcción de filtros dinámicos ---
    const filters = ["pa.isApproved = 1"];
    const params = [];

    if (date) {
      filters.push("pa.date = ?");
      params.push(toSQLDate(date));
    } else if (startDate && endDate) {
      filters.push("pa.date BETWEEN ? AND ?");
      params.push(toSQLDate(startDate), toSQLDate(endDate));
    } else if (startDate && !endDate) {
      filters.push("pa.date = ?");
      params.push(toSQLDate(startDate));
    } else if (!startDate && endDate) {
      filters.push("pa.date = ?");
      params.push(toSQLDate(endDate));
    } else {
      // Sin parámetros: hoy
      const today = dayjs().format("YYYY-MM-DD");
      filters.push("pa.date = ?");
      params.push(today);
    }

    const whereClause = `WHERE ${filters.join(" AND ")}`;

    // === QUERY SQL ===
    const query = `
      SELECT
        pa.permissionID,
        e.codeEmployee,
        pa.date AS attendance,
        CONCAT(
          e.firstName, ' ', COALESCE(e.middleName, ''), ' ', e.lastName, ' ', e.secondLastName
        ) AS employeeName,
        pt.payrollName AS payrollName,
        pa.createdDate AS createdDate,
        att.entryTime AS attendanceEntry,
        pa.exitPermission,
        pa.entryPermission,
        ROUND(TIMESTAMPDIFF(MINUTE, pa.exitPermission, pa.entryPermission) / 60, 2) AS permisoHours,
        p.permissionTypeName,

         CASE
         WHEN p.permissionTypeName = 'Otro' AND pa.comment <> ''
            THEN CONCAT('Otro - ', pa.comment)
            ELSE p.permissionTypeName
        END AS permissionTypeDisplay,
  
        pa.request,
        CONCAT(e_creador.firstName, ' ', COALESCE(e_creador.middleName, ''), ' ', e_creador.lastName) AS createdBy,
        CONCAT(e_aprobador.firstName, ' ', COALESCE(e_aprobador.middleName, ''), ' ', e_aprobador.lastName) AS approvedBy
      FROM permissionattendance_emp pa
      INNER JOIN permissiontype_emp p ON p.permissionTypeID = pa.permissionTypeID
      INNER JOIN employees_emp e ON e.employeeID = pa.employeeID
      INNER JOIN jobs_emp j ON e.jobID = j.jobID
      INNER JOIN payrolltype_emp pt ON pt.payrollTypeID = e.payrollTypeID
      LEFT JOIN users_us ua ON ua.userID = pa.approvedBy
      LEFT JOIN employees_emp e_aprobador ON e_aprobador.employeeID = ua.employeeID
      LEFT JOIN users_us uc ON uc.userID = pa.createdBy
      LEFT JOIN employees_emp e_creador ON e_creador.employeeID = uc.employeeID
      LEFT JOIN (
        SELECT employeeID, date, MIN(entryTime) AS entryTime
        FROM h_attendance_emp
        GROUP BY employeeID, date
      ) att ON pa.date = att.date AND pa.employeeID = att.employeeID
      ${whereClause}
      ORDER BY pa.date ASC, e.codeEmployee ASC, pa.permissionID ASC;
    `;

    const [results] = await db.query(query, params);


    // === CREACIÓN DE EXCEL ===
    const workbook = new ExcelJS.Workbook();
    const worksheet = workbook.addWorksheet("Permisos");

    // Helpers para formato
    const formatDate = (d) => (d ? dayjs(d).format("DD-MM-YYYY") : "-");
    const formatTime = (t) => {
      if (!t) return "-";
      const parsed = dayjs(t, ["HH:mm:ss", "YYYY-MM-DD HH:mm:ss"], true);
      return parsed.isValid() ? parsed.format("hh:mm A") : "-";
    };

    // 1) Agrupar resultados por (empleado, fecha)
    const grouped = {};
    for (const row of results) {
      const key = `${row.codeEmployee || ""}_${row.attendance || ""}`;
      if (!grouped[key]) grouped[key] = [];
      grouped[key].push(row);
    }

    // 2) Máximo de permisos
    const maxPermisos =
      Object.keys(grouped).length > 0
        ? Math.max(...Object.values(grouped).map((arr) => arr.length))
        : 0;

    // 3) Columnas base
    const baseColumns = [
      { header: "Ítem", key: "item", width: 8 },
      { header: "Código", key: "codeEmployee", width: 10 },
      { header: "Empleado", key: "employeeName", width: 30 },
      { header: "Planilla", key: "payrollName", width: 15 },
      { header: "Fecha", key: "permissionDate", width: 14 },

      // { header: "Fecha Creación", key: "createdDate", width: 18 },
      { header: "Entrada Asistencia", key: "attendanceEntry", width: 18 },
    ];

    // 4) Bloques dinámicos de permisos
    const permisoBlock = (i) => [
      { header: `Salida Permiso ${i}`, key: `exitPermission${i}`, width: 15 },
      { header: `Entrada Permiso ${i}`, key: `entryPermission${i}`, width: 15 },
      { header: `Tiempo Permiso`, key: `permisoHours${i}`, width: 16 },
      { header: `Pago`, key: `pago${i}`, width: 10 },
      { header: `Tipo Permiso`, key: `tipoPermiso${i}`, width: 20 },
      { header: `Solicitud`, key: `solicitud${i}`, width: 12 },
      { header: `Creado Por`, key: `creadoPor${i}`, width: 22 },
      { header: `Aprobado Por`, key: `aprobadoPor${i}`, width: 22 },
    ];

    // 5) Definir columnas
    let columns = [...baseColumns];
    for (let i = 1; i <= maxPermisos; i++) {
      columns = columns.concat(permisoBlock(i));
    }
    worksheet.columns = columns;

    // 6) Header agrupado
    if (maxPermisos > 0) {
      worksheet.insertRow(1, []);
      let startCol = baseColumns.length + 1;
      for (let i = 1; i <= maxPermisos; i++) {
        const endCol = startCol + 8 - 1;
        worksheet.mergeCells(1, startCol, 1, endCol);
        const cell = worksheet.getCell(1, startCol);
        cell.value = `Permiso ${i}`;
        cell.font = { bold: true, color: { argb: "FFFFFF" } };
        cell.alignment = { vertical: "middle", horizontal: "center" };
        cell.fill = {
          type: "pattern",
          pattern: "solid",
          fgColor: { argb: "4F81BD" },
        };
        for (let c = startCol; c <= endCol; c++) {
          worksheet.getCell(1, c).border = {
            top: { style: "thin" },
            left: { style: "thin" },
            bottom: { style: "thin" },
            right: { style: "thin" },
          };
        }
        startCol = endCol + 1;
      }
    }

    // 7) Encabezados
    const headerRowIndex = maxPermisos > 0 ? 2 : 1;
    const headerRow = worksheet.getRow(headerRowIndex);
    headerRow.eachCell((cell) => {
      cell.font = { bold: true, color: { argb: "FFFFFF" } };
      cell.fill = {
        type: "pattern",
        pattern: "solid",
        fgColor: { argb: "366092" },
      };
      cell.alignment = { vertical: "middle", horizontal: "center" };
      cell.border = {
        top: { style: "thin" },
        left: { style: "thin" },
        bottom: { style: "thin" },
        right: { style: "thin" },
      };
    });

    // 8) Llenar filas
    let rowIndex = 0;
    const totalColumns = worksheet.columnCount;
    for (const permisos of Object.values(grouped)) {
      rowIndex += 1;

      const base = {
        item: rowIndex,
        codeEmployee: permisos[0].codeEmployee
          ? Number(permisos[0].codeEmployee)
          : "-",
        employeeName: permisos[0].employeeName,
        payrollName: permisos[0].payrollName || "-",
        permissionDate: formatDate(permisos[0].attendance),
        // createdDate: formatDate(permisos[0].createdDate),
        attendanceEntry: formatTime(permisos[0].attendanceEntry),
      };

      for (let i = 1; i <= maxPermisos; i++) {
        base[`exitPermission${i}`] = "-";
        base[`entryPermission${i}`] = "-";
        base[`permisoHours${i}`] = "-";
        base[`pago${i}`] = "";
        base[`tipoPermiso${i}`] = "-";
        base[`solicitud${i}`] = "-";
        base[`creadoPor${i}`] = "-";
        base[`aprobadoPor${i}`] = "-";
      }

      permisos.forEach((p, i) => {
        const idx = i + 1;
        base[`exitPermission${idx}`] = p.exitPermission
          ? formatTime(p.exitPermission)
          : "-";
        base[`entryPermission${idx}`] = p.entryPermission
          ? formatTime(p.entryPermission)
          : "-";
        base[`permisoHours${idx}`] =
          typeof p.permisoHours === "number"
            ? p.permisoHours
            : p.permisoHours
              ? Number(p.permisoHours)
              : "-";
        base[`tipoPermiso${idx}`] =
          p.permissionTypeDisplay || p.permissionTypeName || "-";
        base[`solicitud${idx}`] = p.request ? "Solicitado" : "Diferido";
        base[`creadoPor${idx}`] = p.createdBy || "-";
        base[`aprobadoPor${idx}`] = p.approvedBy || "-";
      });
      const excelRow = worksheet.addRow(base);
      for (let c = 1; c <= totalColumns; c++) {
        const cell = excelRow.getCell(c);
        cell.border = {
          top: { style: "thin" },
          left: { style: "thin" },
          bottom: { style: "thin" },
          right: { style: "thin" },
        };
        cell.alignment = { vertical: "middle" };
      }
    }

    // 9) Descargar archivo
    const fileLabel = date
      ? toSQLDate(date)
      : startDate && endDate
        ? `${toSQLDate(startDate)}_a_${toSQLDate(endDate)}`
        : dayjs().format("YYYY-MM-DD");

    res.setHeader(
      "Content-Type",
      "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
    );
    res.setHeader(
      "Content-Disposition",
      `attachment; filename=permisos_${fileLabel}.xlsx`
    );

    await workbook.xlsx.write(res);
    res.end();
  } catch (error) {
    console.error("Error al exportar permisos:", error);
    res.status(500).json({
      success: false,
      message: "Error interno del servidor al exportar permisos",
      error: error.message,
    });
  }
};


// Endpoint para exportar reporte diario de permisos a Excel del modal de Record Attendance
//modal de permission
exports.exportPermissionReportExcel = async (req, res) => {
  console.log(">>> ENTRO A exportPermissionReportExcel <<<");
  try {
    const { nummWeek, status, startDate: qStart, endDate: qEnd } = req.query;

    const isValidDate = (v) => dayjs(v, "YYYY-MM-DD", true).isValid();

    let startDate, endDate;

    // 1) Si viene rango -> usarlo
    if (qStart || qEnd) {
      const s = qStart || qEnd;
      const e = qEnd || qStart;

      if (!isValidDate(s) || !isValidDate(e)) {
        return res.status(400).json({
          success: false,
          message: "Fechas inválidas. Usa formato YYYY-MM-DD en startDate/endDate.",
        });
      }

      startDate = dayjs(s).format("YYYY-MM-DD");
      endDate = dayjs(e).format("YYYY-MM-DD");

      // asegurar orden
      if (dayjs(endDate).isBefore(dayjs(startDate))) {
        const tmp = startDate;
        startDate = endDate;
        endDate = tmp;
      }
    }
    // 2) Si NO viene rango, usar semana (compatibilidad)
    else if (nummWeek) {
      startDate = dayjs().isoWeek(Number(nummWeek)).startOf("isoWeek").format("YYYY-MM-DD");
      endDate = dayjs().isoWeek(Number(nummWeek)).endOf("isoWeek").format("YYYY-MM-DD");
    } else {
      return res.status(400).json({
        success: false,
        message: "Falta startDate/endDate (o nummWeek).",
      });
    }

    if (status == null) {
      return res.status(400).json({ success: false, message: "Falta status." });
    }


    const LUNCH_HOURS = 0.75;

    // ===== Helpers de tiempo =====
    const getTimeString = (value) => {
      if (!value) return null;
      if (typeof value === "string") {
        const parts = value.split(" ");
        return parts[parts.length - 1]; // HH:mm:ss
      }
      return dayjs(value).format("HH:mm:ss");
    };

    const timeToMinutes = (value) => {
      const t = getTimeString(value);
      if (!t) return null;
      const [hStr, mStr, sStr] = t.split(":");
      const h = parseInt(hStr ?? "0", 10);
      const m = parseInt(mStr ?? "0", 10);
      // const s = parseInt(sStr ?? "0", 10);
      return h * 60 + m;
    };

    const diffHours = (start, end) => {
      const ms = timeToMinutes(start);
      const me = timeToMinutes(end);
      if (ms == null || me == null) return 0;
      let diffMin = me - ms;
      if (diffMin < 0) diffMin += 24 * 60; // cruces de medianoche
      return diffMin / 60;
    };

    // Detecta turno nocturno si la jornada cruza medianoche (ej: 18:00 -> 03:00)
    const isNightShiftByTimes = (startTime, endTime) => {
      const s = timeToMinutes(startTime);
      const e = timeToMinutes(endTime);
      if (s == null || e == null) return false;
      return e <= s; // cruza medianoche => noche
    };

    const formatDate = (d) => (d ? dayjs(d).format("DD-MM-YYYY") : "-");
    const formatTime = (t) => {
      if (!t) return "-";
      const parsed = dayjs(getTimeString(t), "HH:mm:ss", true);
      return parsed.isValid() ? parsed.format("hh:mm A") : "-";
    };

    // Helpers de intervalos (en minutos)
    const mergeIntervals = (intervals) => {
      if (!intervals.length) return [];
      const sorted = intervals
        .slice()
        .sort((a, b) => a[0] - b[0] || a[1] - b[1]);
      const result = [];
      let [curStart, curEnd] = sorted[0];
      for (let i = 1; i < sorted.length; i++) {
        const [s, e] = sorted[i];
        if (s <= curEnd) {
          if (e > curEnd) curEnd = e;
        } else {
          result.push([curStart, curEnd]);
          curStart = s;
          curEnd = e;
        }
      }
      result.push([curStart, curEnd]);
      return result;
    };

    // Devuelve segmentos "hueco" dentro de [segStart, segEnd] que NO están cubiertos por intervals
    const subtractIntervals = (intervals, segStart, segEnd) => {
      if (segStart == null || segEnd == null || segEnd <= segStart) return [];
      const merged = mergeIntervals(intervals);
      const gaps = [];
      let cursor = segStart;

      for (const [s, e] of merged) {
        if (e <= segStart) continue;
        if (s >= segEnd) break;

        const cs = Math.max(s, segStart);
        const ce = Math.min(e, segEnd);

        if (cs > cursor) gaps.push([cursor, cs]);
        cursor = Math.max(cursor, ce);
      }

      if (cursor < segEnd) gaps.push([cursor, segEnd]);
      return gaps;
    };

    const hoursRange = (start, end, hasLunch, lunchHours = LUNCH_HOURS) => {
      const h = diffHours(start, end);
      const lunch = hasLunch ? lunchHours : 0;
      return Math.max(h - lunch, 0);
    };

    const payLabel = (v) => (Number(v) === 1 ? "Con goce" : "Sin goce");

    const totalMinutes = (intervals) => {
      const merged = mergeIntervals(intervals);
      return merged.reduce((sum, [s, e]) => sum + (e - s), 0);
    };

    const coverageInSegment = (intervals, segStart, segEnd) => {
      if (segStart == null || segEnd == null || segEnd <= segStart) return 0;
      const clipped = [];
      for (const [s, e] of intervals) {
        const cs = Math.max(segStart, s);
        const ce = Math.min(segEnd, e);
        if (ce > cs) clipped.push([cs, ce]);
      }
      return totalMinutes(clipped);
    };

    // ===== Rango de fecha de la semana (L-D) =====
    // const startDate = dayjs()
    //   .isoWeek(nummWeek)
    //   .startOf("isoWeek")
    //   .format("YYYY-MM-DD");
    // const endDate = dayjs()
    //   .isoWeek(nummWeek)
    //   .endOf("isoWeek")
    //   .format("YYYY-MM-DD");

    // ============================================
    // 1) Rango total de permisos del día (dayPerm)
    // ============================================
    const [dayPermRows] = await db.query(
      `
      SELECT
        p2.employeeID,
        DATE(p2.date) AS d,
        MIN(p2.exitPermission)  AS day_perm_min_start,
        MAX(p2.entryPermission) AS day_perm_max_end
      FROM permissionattendance_emp p2
      INNER JOIN employees_emp e ON e.employeeID = p2.employeeID
      WHERE p2.date BETWEEN ? AND ?
        AND p2.isApproved = 1
       
      GROUP BY p2.employeeID, DATE(p2.date);
      `,
      [startDate, endDate]
    );

    const dayPermMap = new Map();
    for (const r of dayPermRows) {
      const key = `${r.employeeID}_${dayjs(r.d).format("YYYY-MM-DD")}`;
      dayPermMap.set(key, {
        day_perm_min_start: r.day_perm_min_start,
        day_perm_max_end: r.day_perm_max_end,
      });
    }

    // ==============================
    // 0) INCAPACIDADES DEL RANGO
    // ==============================
    const [disRows] = await db.query(
      `
    SELECT
      d.employeeID,
      DATE(d.startDate) AS startD,
      DATE(d.endDate)   AS endD,
      d.startTime
    FROM disability_emp d
    INNER JOIN employees_emp e ON e.employeeID = d.employeeID
    WHERE DATE(d.startDate) <= ?
      AND DATE(d.endDate) >= ?
     
    `,
      [endDate, startDate]
    );

    const disabilityMap = new Map();

    const pushDisInterval = (employeeID, dateStr, sMin, eMin) => {
      if (sMin == null || eMin == null) return;
      if (eMin <= sMin) return;

      const key = `${employeeID}_${dateStr}`;
      if (!disabilityMap.has(key)) disabilityMap.set(key, []);
      disabilityMap.get(key).push([sMin, eMin]);
    };

    for (const r of disRows) {
      const emp = r.employeeID;
      const startD = dayjs(r.startD);
      const endD = dayjs(r.endD);

      const sMin = timeToMinutes(r.startTime); // hora inicio
      const totalDays = endD.diff(startD, "day");

      for (let i = 0; i <= totalDays; i++) {
        const cur = startD.add(i, "day");
        const dateStr = cur.format("YYYY-MM-DD");

        if (i === 0) {
          // primer día: desde startTime hasta fin del día
          pushDisInterval(emp, dateStr, sMin, 24 * 60);
        } else {
          // resto de días (incluye último): todo el día
          pushDisInterval(emp, dateStr, 0, 24 * 60);
        }
      }
    }

    // ======================================================
    // 2) Datos base: permisos + detalles + turno del día (ds)
    // ======================================================
    const [rows] = await db.query(
      `
      SELECT
        e.employeeID,
        e.codeEmployee,
        CONCAT(e.firstName, ' ', e.middleName, ' ', e.lastName) AS fullName,
        payType.payrollName AS Planilla,
        COALESCE(hs.shiftID, e.shiftID) AS shiftID,
        p.date,
        p.permissionID,

        -- turno del día
        ds.day,
        ds.startTime,
        ds.endTime,

        -- cabecera del permiso
        p.exitPermission,
        p.entryPermission,

        -- horas de permiso original (cabecera)
        IF(p.exitPermission IS NOT NULL,
           TIMESTAMPDIFF(MINUTE, p.exitPermission, p.entryPermission) / 60.0,
           0) AS permisoHoursOriginal,

        CONCAT(p.exitPermission, ' - ', p.entryPermission) AS permisoRangeHours,

        -- comentario (detalle > cabecera)
        p.comment  AS permisoComment,
        dp.comment AS detalleComment,

        -- etiqueta de pago
        CASE 
          WHEN dp.withPay IS NOT NULL THEN 
            CASE dp.withPay WHEN 1 THEN 'Con goce' ELSE 'Sin goce' END
          ELSE 
            CASE p.isPaid  WHEN 1 THEN 'Con goce' ELSE 'Sin goce' END
        END AS Pago,

        -- bandera de almuerzo a nivel permiso (0/1)
        CASE 
          WHEN dp.lunchTime IS NOT NULL THEN dp.lunchTime
          ELSE p.lunchTime
        END AS lunchTime,

        -- marcajes
        h.entryTime,
        h.exitTime,

        -- Excepción vigente en la fecha del permiso; FK del empleado solo sin historial
        COALESCE(
          (
            SELECT exHistory.exceptionTime
            FROM h_assigmentexception_emp hx
            INNER JOIN exceptions_emp exHistory ON exHistory.exceptionID = hx.exceptionID
            WHERE hx.employeeID = e.employeeID
              AND hx.startDate <=DATE(p.date)
              AND (hx.endDate IS NULL OR hx.endDate >= DATE(p.date))
            ORDER BY hx.startDate DESC, hx.hassignmentexceptionID DESC
            LIMIT 1
          ),
          CASE
            WHEN EXISTS (
              SELECT 1 FROM h_assigmentexception_emp hx
              WHERE hx.employeeID = e.employeeID
            ) THEN 0
            ELSE COALESCE(exc.exceptionTime, 0)
          END
        ) AS exceptionTime,

        -- campos de detalle (para dpAgg en JS)
        dp.permitStartTime    AS dp_permitStartTime,
        dp.permitEndTime      AS dp_permitEndTime,
        dp.lunchTime          AS dp_lunchTime,
        dp.ausence_permissions AS dp_ausence_permissions,
        dp.withPay            AS dp_withPay
      FROM permissionattendance_emp p
      LEFT JOIN detailpermission_emp dp ON dp.permissionID = p.permissionID
      INNER JOIN employees_emp e         ON e.employeeID = p.employeeID
      LEFT JOIN h_attendance_emp h
        ON h.employeeID = e.employeeID
       AND DATE(h.date) = DATE(p.date)
      INNER JOIN payrolltype_emp payType ON payType.payrollTypeID = e.payrollTypeID
      LEFT JOIN exceptions_emp exc       ON exc.exceptionID = e.exceptionID
      LEFT JOIN h_assigmentshift_emp hs
        ON hs.employeeID = e.employeeID
       AND DATE(hs.startDate) <= DATE(p.date)
       AND (hs.endDate IS NULL OR DATE(hs.endDate) >= DATE(p.date))
      LEFT JOIN detailsshift_emp ds
        ON ds.shiftID = COALESCE(hs.shiftID, e.shiftID)
       AND ds.day     = DAYNAME(p.date)
      WHERE p.date BETWEEN ? AND ?
        AND p.isApproved = 1
       
      ORDER BY p.date ASC, e.codeEmployee ASC, p.permissionID ASC;
      `,
      [startDate, endDate]
    );

    // =================================================
    // 3) Agrupar por permisoID -> permissionRecords
    // =================================================
    const permissionsMap = new Map();

    for (const row of rows) {
      if (!row.permissionID) continue;

      let perm = permissionsMap.get(row.permissionID);
      if (!perm) {
        const dateStr = dayjs(row.date).format("YYYY-MM-DD");
        const dayKey = `${row.employeeID}_${dateStr}`;
        const dayPerm = dayPermMap.get(dayKey) || {};

        perm = {
          permissionID: row.permissionID,
          employeeID: row.employeeID,
          codeEmployee: row.codeEmployee,
          fullName: row.fullName,
          Planilla: row.Planilla,
          shiftID: row.shiftID,
          date: row.date,

          day: row.day,
          startTime: row.startTime,
          endTime: row.endTime,

          exitPermission: row.exitPermission,
          entryPermission: row.entryPermission,

          permisoHoursOriginal: row.permisoHoursOriginal,
          permisoRangeHours: row.permisoRangeHours,

          headerComment: row.permisoComment,
          pagoLabel: row.Pago,
          lunchTime: Number(row.lunchTime || 0),

          entryTime: row.entryTime,
          exitTime: row.exitTime,
          exceptionTime: row.exceptionTime,

          day_perm_min_start: dayPerm.day_perm_min_start || null,
          day_perm_max_end: dayPerm.day_perm_max_end || null,

          details: [],
        };
        permissionsMap.set(row.permissionID, perm);
      }

      if (row.dp_permitStartTime || row.dp_permitEndTime) {
        perm.details.push({
          permitStartTime: row.dp_permitStartTime,
          permitEndTime: row.dp_permitEndTime,
          lunchTime: row.dp_lunchTime,
          ausence_permissions: row.dp_ausence_permissions,
          withPay: row.dp_withPay,
          comment: row.detalleComment,
        });
      }
    }

    const permissionRecords = Array.from(permissionsMap.values());

    // =================================================
    // 4) AGRUPAR por EMPLEADO + FECHA (día completo)
    // =================================================
    const dayGroupsMap = new Map();

    for (const perm of permissionRecords) {
      const dateStr = dayjs(perm.date).format("YYYY-MM-DD");
      const key = `${perm.employeeID}_${dateStr}`;

      let g = dayGroupsMap.get(key);
      if (!g) {
        g = {
          employeeID: perm.employeeID,
          codeEmployee: perm.codeEmployee,
          fullName: perm.fullName,
          Planilla: perm.Planilla,
          date: perm.date,
          day: perm.day,
          startTime: perm.startTime,
          endTime: perm.endTime,
          entryTime: perm.entryTime,
          exitTime: perm.exitTime,
          exceptionTime: perm.exceptionTime,
          permissions: [],
          permissionIDs: [],
        };
        dayGroupsMap.set(key, g);
      }

      g.permissions.push(perm);
      if (perm.permissionID != null) {
        g.permissionIDs.push(perm.permissionID);
      }
    }

    // =================================================
    // 5) Cálculo de horas a nivel DÍA
    // =================================================
    const computeDayHoras = (group) => {
      const {
        startTime,
        endTime,
        entryTime,
        exitTime,
        exceptionTime,
        permissions,
      } = group;

      const dateStr = dayjs(group.date).format("YYYY-MM-DD");
      const disKey = `${group.employeeID}_${dateStr}`;
      let disabilityIntervals = disabilityMap.get(disKey) || [];
      group._hasBlockedByDisability = false;

      const isNightShift = isNightShiftByTimes(startTime, endTime);
      const EFFECTIVE_LUNCH_HOURS = isNightShift ? 0 : LUNCH_HOURS;

      // HrsLaborables de la jornada (restando almuerzo fijo de turno)
      let HrsLaborables = 0;
      if (startTime && endTime) {
        HrsLaborables = diffHours(startTime, endTime) - EFFECTIVE_LUNCH_HOURS;
        if (HrsLaborables < 0) HrsLaborables = 0;
      }

      const startMin = timeToMinutes(startTime);
      const endMin = timeToMinutes(endTime);
      const entryMin = timeToMinutes(entryTime);
      const exitMin = timeToMinutes(exitTime);

      let startM = startMin;
      let endM = endMin;
      let entryM = entryMin;
      let exitM = exitMin;

      if (isNightShift) {
        // el fin del turno pasa al "día siguiente"
        if (endM != null) endM += 1440;

        // si entrada/salida están después de medianoche, súmalas para caer en el mismo día lógico
        if (entryM != null && startM != null && entryM < startM) entryM += 1440;
        if (exitM != null && startM != null && exitM < startM) exitM += 1440;
      }

      if (isNightShift && startM != null && disabilityIntervals.length) {
        disabilityIntervals = disabilityIntervals.map(([s, e]) => {
          let ns = s;
          let ne = e;
          if (ns < startM) ns += 1440;
          if (ne < startM) ne += 1440;
          if (ne <= ns) ne += 1440;
          return [ns, ne];
        });
        // opcional pero recomendado para que subtractIntervals funcione “limpio”
        disabilityIntervals = mergeIntervals(disabilityIntervals);
      }

      const applyDisabilityBlock = (s, e) => {
        if (!disabilityIntervals.length) return [[s, e]];
        return subtractIntervals(disabilityIntervals, s, e);
      };

      // ✅ NUEVO: horas de incapacidad dentro del turno (para NO sumarlas como trabajadas)
      let disCoveredMin = 0;
      if (startM != null && endM != null && disabilityIntervals.length) {
        disCoveredMin = coverageInSegment(disabilityIntervals, startM, endM);
      }
      const disHours = disCoveredMin / 60.0;

      // ✅ Horas laborables efectivas (turno - almuerzo - incapacidad)
      const HrsLaborablesEff = Math.max(HrsLaborables - disHours, 0);

      // Intervalos en minutos
      const permisoIntervals = [];
      const ausenciaIntervals = [];

      let permisoLunchFlag = false;
      let ausenciaLunchFlag = false;
      let anyLunchFlag = false;

      let permisoHoursOriginalSum = 0;

      let headerComment = "-";
      let pagoLabel = "Sin goce";

      // RECORRER TODOS LOS PERMISOS DEL DÍA
      for (const perm of permissions) {
        permisoHoursOriginalSum += perm.permisoHoursOriginal || 0;

        if (perm.headerComment && perm.headerComment.trim() && headerComment === "-") {
          headerComment = perm.headerComment;
        }

        if (perm.pagoLabel) {
          pagoLabel = perm.pagoLabel;
        }

        const hasDetails = perm.details && perm.details.length > 0;

        if (hasDetails) {
          for (const d of perm.details) {
            let s = timeToMinutes(d.permitStartTime);
            let e = timeToMinutes(d.permitEndTime);

            if (isNightShift && s != null && e != null && startM != null) {
              if (s < startM) s += 1440;
              if (e < startM) e += 1440;
              if (e <= s) e += 1440;
            }
            if (s == null || e == null || e <= s) continue;

            const isAus = Number(d.ausence_permissions || 0) === 1;
            const hasLunch = Number(d.lunchTime || 0) === 1;



            if (isAus) {
              const remainingAus = applyDisabilityBlock(s, e);
              for (const [rs, re] of remainingAus) {
                ausenciaIntervals.push([rs, re]);
              }
              if (hasLunch) {
                ausenciaLunchFlag = true;
                anyLunchFlag = true;
              }
            } else {
              // permisoIntervals.push([s, e]);
              const remainingParts = applyDisabilityBlock(s, e);
              d._blockedByDisability = remainingParts.length === 0;

              if (d._blockedByDisability) {
                group._hasBlockedByDisability = true;
              } else {
                for (const [rs, re] of remainingParts) {
                  permisoIntervals.push([rs, re]);
                }
              }

              if (hasLunch) {
                permisoLunchFlag = true;
                anyLunchFlag = true;
              }
            }


          }

          // ====== NUEVO: AUSENCIA AUTOMÁTICA por reducción del permiso (cabecera vs detalles) ======
          if (perm.exitPermission && perm.entryPermission) {
            let origS = timeToMinutes(perm.exitPermission);
            let origE = timeToMinutes(perm.entryPermission);

            if (origS != null && origE != null) {
              if (isNightShift && startM != null) {
                if (origS < startM) origS += 1440;
                if (origE < startM) origE += 1440;
                if (origE <= origS) origE += 1440; // por si cruza medianoche
              }


              if (origE > origS) {


                const allDetailIntervals = [];

                for (const d of perm.details) {
                  let ds = timeToMinutes(d.permitStartTime);
                  let de = timeToMinutes(d.permitEndTime);
                  if (ds == null || de == null) continue;

                  if (isNightShift && ds != null && de != null && startM != null) {
                    if (ds < startM) ds += 1440;
                    if (de < startM) de += 1440;
                    if (de <= ds) de += 1440;
                  }

                  if (de > ds) allDetailIntervals.push([ds, de]);
                }

                // ✅ y SOLO si hay detalles, calculás gaps
                if (allDetailIntervals.length > 0) {

                  const shiftS = startM;
                  const shiftE = endM;

                  const clippedOrigS = (shiftS != null) ? Math.max(origS, shiftS) : origS;
                  const clippedOrigE = (shiftE != null) ? Math.min(origE, shiftE) : origE;

                  if (clippedOrigE > clippedOrigS) {
                    const gaps = subtractIntervals(allDetailIntervals, clippedOrigS, clippedOrigE);

                    for (const [gs, ge] of gaps) {
                      const remainingGap = applyDisabilityBlock(gs, ge);
                      for (const [rs, re] of remainingGap) {
                        if (re > rs) ausenciaIntervals.push([rs, re]);
                      }
                    }
                  }
                }
              }
            }
          }

        } else {


          if (perm.exitPermission && perm.entryPermission) {
            let s = timeToMinutes(perm.exitPermission);
            let e = timeToMinutes(perm.entryPermission);

            if (isNightShift && startM != null && s != null && e != null) {
              if (s < startM) s += 1440;
              if (e < startM) e += 1440;
              if (e <= s) e += 1440;
            }

            if (s != null && e != null && e > s) {
              // permisoIntervals.push([s, e]);
              const remainingParts = applyDisabilityBlock(s, e);

              perm._blockedByDisability = remainingParts.length === 0;

              if (remainingParts.length === 0) {
                group._hasBlockedByDisability = true;
              } else {
                for (const [rs, re] of remainingParts) {
                  permisoIntervals.push([rs, re]);
                }
              }
              if (Number(perm.lunchTime || 0) === 1) {
                permisoLunchFlag = true;
                anyLunchFlag = true;
              }
            }
          }
        }

        if (!hasDetails && Number(perm.lunchTime || 0) === 1) {
          permisoLunchFlag = true;
          anyLunchFlag = true;
        }
      }

      // H.P
      const totalPermMin = totalMinutes(permisoIntervals);
      const hrsPermiso_base = totalPermMin / 60.0;

      let descuentoAlmuerzoPermiso = 0;
      if (permisoLunchFlag) descuentoAlmuerzoPermiso = EFFECTIVE_LUNCH_HOURS;

      let hrsPermiso = Math.max(hrsPermiso_base - descuentoAlmuerzoPermiso, 0);

      // H.A detalle
      const totalAusMin = totalMinutes(ausenciaIntervals);
      const hrsAusente_detalle_base = totalAusMin / 60.0;

      let descuentoAlmuerzoAusente = 0;
      if (ausenciaLunchFlag) descuentoAlmuerzoAusente = EFFECTIVE_LUNCH_HOURS;

      let hrsAusente_detalle = Math.max(
        hrsAusente_detalle_base - descuentoAlmuerzoAusente,
        0
      );

      // Casos 1,2,3
      const soloEntradaSinSalida = !!entryTime && !exitTime;
      const soloSalidaSinEntrada = !entryTime && !!exitTime;
      const caso3 = soloEntradaSinSalida || soloSalidaSinEntrada;

      let hrsAusente_entrada = 0;
      let hrsAusente_salida = 0;
      let hrsAusencia = 0;
      let hrsTrabajadas = 0;

      if (caso3) {
        hrsPermiso = 0;
        hrsAusencia = 0;
        hrsTrabajadas = 0;
      } else {
        const noEntry = !entryTime;
        const noExit = !exitTime;

        if (noEntry && noExit && totalAusMin === 0) {
          // CASO 1
          const netPermiso = hrsPermiso;
          hrsAusencia = Math.max(HrsLaborablesEff - netPermiso, 0);
        } else {
          // CASO 2

          // REGLA 1: entrada tarde
          if (entryM != null && startM != null && entryM > startM) {
            const segEnd = (endM != null) ? Math.min(entryM, endM) : entryM;

            const coveredMin = coverageInSegment(
              [...permisoIntervals, ...ausenciaIntervals, ...disabilityIntervals],
              startM,
              segEnd
            );

            let baseMin = (segEnd - startM) - coveredMin;
            if (baseMin < 0) baseMin = 0;
//por aqui me quede
            baseMin = Math.max(baseMin - Number(exceptionTime || 0), 0);

            const lunchThresholdMin = 12 * 60 + 45;
            if (!isNightShift && baseMin > 0 && entryM >= lunchThresholdMin && !anyLunchFlag) {
              baseMin -= EFFECTIVE_LUNCH_HOURS * 60;
              if (baseMin < 0) baseMin = 0;
            }

            hrsAusente_entrada = baseMin / 60.0;
          }

          // REGLA 2: salida temprano (sin permisos)
          if (exitM != null && endM != null && exitM < endM) {
            const coveredAfterExit = coverageInSegment(
              [...permisoIntervals, ...ausenciaIntervals, ...disabilityIntervals],
              exitM,
              endM
            );

            let effectiveGapMin = (endM - exitM) - coveredAfterExit;
            if (effectiveGapMin < 0) effectiveGapMin = 0;

            let baseHours = effectiveGapMin / 60.0 - Number(exceptionTime || 0);
            if (baseHours < 0) baseHours = 0;

            hrsAusente_salida = baseHours;
          }

          hrsAusencia =
            hrsAusente_detalle + hrsAusente_entrada + hrsAusente_salida;
        }

        hrsTrabajadas = Math.max(
          HrsLaborablesEff - (hrsPermiso + hrsAusencia),
          0
        );
      }

      const sumaHoras = hrsPermiso + hrsAusencia + hrsTrabajadas;
      const diferenciaHoras = HrsLaborablesEff - sumaHoras;

      return {
        day: group.day,
        HrsLaborables,
        hrsPermiso,
        hrsAusencia,
        hrsTrabajadas,
        sumaHoras,
        diferenciaHoras,
        permisoHoursOriginal: permisoHoursOriginalSum,
        commentText: headerComment,
        Pago: pagoLabel,
      };
    };

    const empWeekAbsenceHours = new Map();
    const groupHorasMap = new Map();

    for (const [key, group] of dayGroupsMap.entries()) {
      const horas = computeDayHoras(group);
      groupHorasMap.set(key, horas);

      const dateObj = dayjs(group.date);
      // Clave única por empleado y su semana ISO correspondiente (ej: "123_2026_15")
      const weekKey = `${group.employeeID}_${dateObj.isoWeekYear()}_${dateObj.isoWeek()}`;

      const current = empWeekAbsenceHours.get(weekKey) || 0;
      empWeekAbsenceHours.set(weekKey, current + (horas.hrsAusencia || 0));
    }

    // =================================================
    // 6) Construir estructura final (filas por PERMISO / DETALLE)
    // =================================================
    const excelRows = [];
    const mergeGroups = []; // para mergear columnas de identificación por día

    for (const [key, group] of dayGroupsMap.entries()) {
      const horas = groupHorasMap.get(key);

      const dateObj = dayjs(group.date);
      const weekKey = `${group.employeeID}_${dateObj.isoWeekYear()}_${dateObj.isoWeek()}`;

      const totalWeekAbsenceHours = empWeekAbsenceHours.get(weekKey) || 0;
      const isSemanal = group.Planilla && String(group.Planilla).trim().toLowerCase() === "semanal";
      const shouldHighlightRed = totalWeekAbsenceHours > (5 / 60) && isSemanal;


      const baseDayInfo = {
        codeEmployee: group.codeEmployee,
        fullName: group.fullName,
        Planilla: group.Planilla,
        date: group.date,
        entryTime: group.entryTime,
        exitTime: group.exitTime,
        HrsLaborables: horas.HrsLaborables,
        // hrsPermiso: horas.hrsPermiso,
        hrsAusencia: horas.hrsAusencia,
        hrsTrabajadas: horas.hrsTrabajadas,
        // Pago: horas.Pago,
        blockedByDisability: group._hasBlockedByDisability,
        shouldHighlightRed,
      };

      const rowsForGroup = [];

      for (const perm of group.permissions) {
        const permId = perm.permissionID;
        const headerComment = perm.headerComment;

        if (perm.details && perm.details.length > 0) {
          let hasPermDetail = false;

          for (const d of perm.details) {
            const isAus = Number(d.ausence_permissions || 0) === 1;
            const hasLunch = Number(d.lunchTime || 0) === 1;
            const isNightShiftGroup = isNightShiftByTimes(group.startTime, group.endTime);
            const lunchHoursRow = isNightShiftGroup ? 0 : LUNCH_HOURS;

            const hPerm = isAus ? 0 : hoursRange(d.permitStartTime, d.permitEndTime, hasLunch, lunchHoursRow);

            const blockedRow = !isAus && !!d._blockedByDisability;

            const sStr = getTimeString(d.permitStartTime);
            const eStr = getTimeString(d.permitEndTime);
            const baseRange =
              sStr && eStr ? `${sStr} - ${eStr}` : "-";
            const tipoDetalle = isAus ? "D.A" : "D.P";
            const rango =
              baseRange !== "-" ? `${baseRange} (${tipoDetalle})` : "-";

            // Comentario SOLO texto (detalle > cabecera)
            const commentText =
              (d.comment && String(d.comment).trim()) || "-";

            // const remainingParts = applyDisabilityBlock(s, e);

            // let blockedRow = false;
            // if (remainingParts.length === 0) {
            //   blockedRow = true;
            //   // permisoIntervals no recibe nada
            // } else {
            //   for (const [rs, re] of remainingParts) permisoIntervals.push([rs, re]);
            // }

            rowsForGroup.push({
              ...baseDayInfo,
              blockedByDisabilityRow: blockedRow,
              permissionID: permId,
              rangoPermiso: rango,
              isAusDetail: isAus,
              hrsPermiso: blockedRow ? 0 : Number(hPerm.toFixed(2)),
              Pago: d.withPay != null ? payLabel(d.withPay) : (perm.pagoLabel || "Sin goce"),
              commentText,
              shouldHighlightRed,
            });

            if (!isAus) hasPermDetail = true;
          }

          // Si solo hubo detalles de AUSENCIA, mostramos también el rango original
          if (!hasPermDetail && perm.exitPermission && perm.entryPermission) {
            const sStr = getTimeString(perm.exitPermission);
            const eStr = getTimeString(perm.entryPermission);
            const rango =
              sStr && eStr ? `${sStr} - ${eStr}` : "-";

            const commentText =
              (headerComment && String(headerComment).trim()) || "-";

            rowsForGroup.push({
              ...baseDayInfo,
              permissionID: permId,
              rangoPermiso: rango,
              isAusDetail: false,
              hrsPermiso: 0,
              Pago: perm.pagoLabel || "Sin goce",
              commentText,
              shouldHighlightRed,
            });
          }
        } else {
          // Solo permiso original (sin detalles)
          const sStr = getTimeString(perm.exitPermission);
          const eStr = getTimeString(perm.entryPermission);
          const rango =
            sStr && eStr ? `${sStr} - ${eStr}` : "-";

          const isNightShiftGroup = isNightShiftByTimes(group.startTime, group.endTime);
          const lunchHoursRow = isNightShiftGroup ? 0 : LUNCH_HOURS;
          const hasLunch = Number(perm.lunchTime || 0) === 1;
          const hPerm = hoursRange(perm.exitPermission, perm.entryPermission, hasLunch, lunchHoursRow);
          const commentText =
            (headerComment && String(headerComment).trim()) || "-";

          const blockedRow = !!perm._blockedByDisability;

          rowsForGroup.push({
            ...baseDayInfo,
            blockedByDisabilityRow: blockedRow,
            permissionID: permId,
            rangoPermiso: rango,
            isAusDetail: false,
            hrsPermiso: blockedRow ? 0 : Number(hPerm.toFixed(2)),
            Pago: perm.pagoLabel || "Sin goce",
            commentText,
            shouldHighlightRed,
          });
        }
      }

      if (rowsForGroup.length === 0) {
        rowsForGroup.push({
          ...baseDayInfo,
          permissionID:
            group.permissionIDs.length === 1
              ? group.permissionIDs[0]
              : group.permissionIDs.join(", "),
          rangoPermiso: "-",
          isAusDetail: false,
          hrsPermiso: 0,
          Pago: "-",
          commentText: "-",
          shouldHighlightRed,
        });
      }

      const startIndex = excelRows.length;
      excelRows.push(...rowsForGroup);
      const endIndex = excelRows.length - 1;
      mergeGroups.push({ startIndex, endIndex });
    }

    // =================================================
    // 7) Construir Excel (sin Día / Hrs Laborables)
    // =================================================
    const workbook = new ExcelJS.Workbook();
    const ws = workbook.addWorksheet("Permisos");

    ws.columns = [
      // { header: "item", key: "item", width: 8 },
      // { header: "#Permiso", key: "permissionID", width: 16 },
      { header: "Código", key: "codeEmployee", width: 10 },
      { header: "Empleado", key: "fullName", width: 30 },
      { header: "Planilla", key: "Planilla", width: 14 },

      { header: "Fecha", key: "date", width: 12 },

      { header: "T.Permiso (Rangos)", key: "rangoPermiso", width: 26 },

      { header: "Horas Permiso", key: "hrsPermiso", width: 18 },
      { header: "Horas Ausentes", key: "hrsAusencia", width: 18 },
      { header: "Horas Trabajadas", key: "hrsTrabajadas", width: 18 },

      { header: "Pago", key: "Pago", width: 12 },
      { header: "Comentario", key: "commentText", width: 40 },
    ];

    // Título
    ws.spliceRows(1, 0, []);
    const titleCell = ws.getCell(1, 1);
    titleCell.value = "PERMISOS";
    ws.mergeCells(1, 1, 1, ws.columns.length);
    titleCell.font = { bold: true, size: 14 };
    titleCell.alignment = { vertical: "middle", horizontal: "center" };

    const headerRow = ws.getRow(2);
    headerRow.font = { bold: true, color: { argb: "FFFFFFFF" } };
    headerRow.alignment = { vertical: "middle", horizontal: "center" };
    headerRow.height = 20;
    for (let c = 1; c <= ws.columns.length; c++) {
      const cell = headerRow.getCell(c);
      cell.fill = {
        type: "pattern",
        pattern: "solid",
        fgColor: { argb: "FF1F2937" },
      };
      cell.border = {
        top: { style: "thin" },
        left: { style: "thin" },
        bottom: { style: "thin" },
        right: { style: "thin" },
      };
    }

    const thin = {
      top: { style: "thin" },
      left: { style: "thin" },
      bottom: { style: "thin" },
      right: { style: "thin" },
    };

    const colCodeEmployee =
      ws.columns.findIndex((c) => c.key === "codeEmployee") + 1;
    const colFullName =
      ws.columns.findIndex((c) => c.key === "fullName") + 1;
    const colPlanilla =
      ws.columns.findIndex((c) => c.key === "Planilla") + 1;
    const colFecha =
      ws.columns.findIndex((c) => c.key === "date") + 1;

    const rangoColIndex =
      ws.columns.findIndex((c) => c.key === "rangoPermiso") + 1;
    const comentarioColIndex =
      ws.columns.findIndex((c) => c.key === "commentText") + 1;

    let idx = 0;
    for (const g of excelRows) {
      idx += 1;

      const hpNum =
        g.hrsPermiso != null ? parseFloat(g.hrsPermiso) : (parseFloat(g.hrsPermiso) || 0);
      const haNum = parseFloat(g.hrsAusencia) || 0;
      const hrsTrabajadas = parseFloat(g.hrsTrabajadas) || 0;

      const row = ws.addRow({
        // item: idx,
        // permissionID: g.permissionID,
        codeEmployee: Number(g.codeEmployee ?? "-"),
        fullName: g.fullName ?? "-",
        Planilla: g.Planilla ?? "-",

        date: formatDate(g.date),

        rangoPermiso: g.rangoPermiso || "-",

        hrsPermiso: Number(hpNum.toFixed(2)),
        hrsAusencia: Number(haNum.toFixed(2)),
        hrsTrabajadas: Number(hrsTrabajadas.toFixed(2)),

        Pago: g.Pago,
        commentText: g.commentText || "-",
      });

      const colRango = ws.columns.findIndex((c) => c.key === "rangoPermiso") + 1;
      const colHP = ws.columns.findIndex((c) => c.key === "hrsPermiso") + 1;

      // Regla semanal acumulada.
      const shouldHighlightRed = !!g.shouldHighlightRed;
      // const shouldHighlightYellow = !shouldHighlightRed && g.blockedByDisability;
      const shouldYellow = !shouldHighlightRed && g.blockedByDisabilityRow;

      for (let c = 1; c <= ws.columns.length; c++) {
        const cell = row.getCell(c);
        cell.border = thin;
        cell.alignment = {
          vertical: "middle",
          horizontal: "center",
          wrapText: c === rangoColIndex || c === comentarioColIndex,
        };


        if (shouldHighlightRed) {
          cell.fill = { type: "pattern", pattern: "solid", fgColor: { argb: "FFFF9999" } };
        } else if (shouldYellow && (c === colRango || c === colHP)) {
          cell.fill = { type: "pattern", pattern: "solid", fgColor: { argb: "FFFFFF99" } };
        }
      }
    }

    const colHP = ws.columns.findIndex((c) => c.key === "hrsPermiso") + 1;
    const colHA = ws.columns.findIndex((c) => c.key === "hrsAusencia") + 1;
    const colHT = ws.columns.findIndex((c) => c.key === "hrsTrabajadas") + 1;

    for (const mg of mergeGroups) {
      if (mg.endIndex <= mg.startIndex) continue; // solo si hay 2+ filas en ese día

      const startRow = 3 + mg.startIndex;     // primera fila de datos es la 3
      const endRow = 3 + mg.endIndex;       // última fila del día

      for (const col of [/*colHP,*/ colHA, colHT]) {
        ws.mergeCells(startRow, col, endRow, col);
      }
    }

    // Merge SOLO de columnas de identificación (empleado/día)
    for (const mg of mergeGroups) {
      if (mg.endIndex <= mg.startIndex) continue;

      const startRow = 3 + mg.startIndex;
      const endRow = 3 + mg.endIndex;

      const colsToMerge = [
        colCodeEmployee,
        colFullName,
        colPlanilla,
        colFecha,
      ];

      for (const col of colsToMerge) {
        ws.mergeCells(startRow, col, endRow, col);
      }
    }

    const fileTag = nummWeek
      ? `week${nummWeek}`
      : `${startDate}_to_${endDate}`;

    res.setHeader(
      "Content-Disposition",
      `attachment; filename=permisos_${fileTag}.xlsx`
    );

    await workbook.xlsx.write(res);
    res.end();
  } catch (error) {
    console.error("Error en exportPermissionReportExcel:", error);
    res.status(500).json({
      success: false,
      message: "Error al exportar Excel de permisos",
      error: error.message,
    });
  }
};


exports.EditPermission = async (req, res) => {
  try {
    const { permissionID, field, newTime, newValue } = req.body;

    if (!permissionID || !field) {
      return res
        .status(400)
        .json({ success: false, message: "Datos incompletos." });
    }

    const allowedFields = [
      "exitPermission",
      "entryPermission",
      "isPaid",
      "comment",
      "lunchTime",
      "date", // YYYY-MM-DD
      "permissionTypeID",
      "request",
    ];
    if (!allowedFields.includes(field)) {
      return res
        .status(400)
        .json({ success: false, message: "Campo no permitido." });
    }

    // 🔹 Caso especial: isPaid (no validar horas)
    if (field === "isPaid") {
      const v = Number(newValue) ? 1 : 0;
      const [r] = await db.query(
        "UPDATE permissionattendance_emp SET isPaid=?, updatedDate=NOW(), updatedBy=? WHERE permissionID=?",
        [v, getUserIdFromToken(req) || null, permissionID]
      );

      // Notificar (opcional) - si quieres también para isPaid
      if (typeof io !== "undefined") {
        io.emit("permission:updatedHeader", {
          permissionID,
          field: "isPaid",
          isPaid: v,
        });
      }

      return res.json({
        success: r.affectedRows > 0,
        message: "Actualizado: Pagado.",
      });
    }

    if (field === "date") {
      const s = String(newValue || "").trim();
      if (!/^\d{4}-\d{2}-\d{2}$/.test(s)) {
        return res
          .status(400)
          .json({ success: false, message: "Fecha inválida. Usa YYYY-MM-DD." });
      }

      // Obtener datos actuales para emitir oldDate/employeeID
      const [[permRow]] = await db.query(
        "SELECT employeeID, date AS oldDate FROM permissionattendance_emp WHERE permissionID=?",
        [permissionID]
      );

      const [r] = await db.query(
        "UPDATE permissionattendance_emp SET date=?, updatedDate=NOW(), updatedBy=? WHERE permissionID=?",
        [s, getUserIdFromToken(req) || null, permissionID]
      );

      // Socket: notificar cambio de fecha (para refresco/auto-navegación)
      if (typeof io !== "undefined") {
        io.emit("permission:updatedHeader", {
          permissionID,
          field: "date",
          oldDate: permRow.oldDate,
          newDate: s,
          employeeID: permRow.employeeID,
        });
        io.emit("permission:updated");
      }

      return res.json({
        success: r.affectedRows > 0,
        message: "Fecha actualizada.",
      });
    }

    if (field === "permissionTypeID") {
      const val = Number(newValue);
      if (!val) {
        return res
          .status(400)
          .json({ success: false, message: "Tipo de permiso inválido." });
      }

      const [[ptRow]] = await db.query(
        "SELECT permissionTypeID, permissionTypeName FROM permissiontype_emp WHERE permissionTypeID=?",
        [val]
      );
      if (!ptRow) {
        return res
          .status(400)
          .json({ success: false, message: "Tipo de permiso no encontrado." });
      }

      const [r] = await db.query(
        "UPDATE permissionattendance_emp SET permissionTypeID=?, updatedDate=NOW(), updatedBy=? WHERE permissionID=?",
        [ptRow.permissionTypeID, getUserIdFromToken(req) || null, permissionID]
      );

      // Socket: notificar cambio de tipo
      if (typeof io !== "undefined") {
        io.emit("permission:updatedHeader", {
          permissionID,
          field: "permissionTypeID",
          permissionTypeID: ptRow.permissionTypeID,
          permissionTypeName: ptRow.permissionTypeName,
        });
        io.emit("permission:updated");
      }

      return res.json({
        success: r.affectedRows > 0,
        message: "Tipo de permiso actualizado.",
      });
    }

    // 🔹 Caso especial: lunchTime (no validar horas)
    if (field === "lunchTime") {
      const v = Number(newValue) ? 1 : 0;
      const [r] = await db.query(
        "UPDATE permissionattendance_emp SET lunchTime=? WHERE permissionID=?",
        [v, permissionID]
      );
      return res.json({
        success: r.affectedRows > 0,
        message: "Actualizado: Tiempo de almuerzo.",
      });
    }

    // 🔹 Caso especial: comment (no validar horas)
    if (field === "comment") {
      const [r] = await db.query(
        "UPDATE permissionattendance_emp SET comment=? WHERE permissionID=?",
        [newValue, permissionID]
      );
      return res.json({
        success: r.affectedRows > 0,
        message: "Actualizado: Comentario.",
      });
    }
    // 🔹 Caso especial: request (no validar horas
    if (field === "request") {
      //const status = newValue === 1 ? 1 : 0;
      const [r] = await db.query(
        "UPDATE permissionattendance_emp SET request=?, status=? WHERE permissionID=?",
        [newValue, newValue, permissionID]
      );
      return res.json({
        success: r.affectedRows > 0,
        message: "Actualizado",
      });
    }
    if (!newTime) {
      return res
        .status(400)
        .json({ success: false, message: "Falta la hora." });
    }
    const normalized = normalizeTimeToSQL(newTime);
    if (!normalized) {
      return res
        .status(400)
        .json({ success: false, message: "Formato de hora inválido." });
    }

    // Traer valores actuales para validar orden de horas
    const [[curr]] = await db.query(
      "SELECT exitPermission, entryPermission FROM permissionattendance_emp WHERE permissionID=?",
      [permissionID]
    );
    if (!curr) {
      return res
        .status(404)
        .json({ success: false, message: "No existe el permiso." });
    }

    const exitPerm =
      field === "exitPermission" ? normalized : curr.exitPermission;
    const entryPerm =
      field === "entryPermission" ? normalized : curr.entryPermission;

    // Validación: salida no puede ser mayor que entrada
    if (exitPerm && entryPerm && exitPerm > entryPerm) {
      return res.status(400).json({
        success: false,
        message: "La salida no puede ser mayor que la entrada.",
      });
    }

    const [result] = await db.query(
      `UPDATE permissionattendance_emp SET ${field}=?, updatedDate=NOW(), updatedBy=? WHERE permissionID=?`,
      [normalized, getUserIdFromToken(req) || null, permissionID]
    );

    // Socket: notificar cambio de hora real
    if (typeof io !== "undefined") {
      io.emit("permission:updatedTime", {
        permissionID,
        field,
        value: normalized,
      });
    }

    return res.json({
      success: result.affectedRows > 0,
      message: "Cambio de hora realizado exitosamente.",
    });
  } catch (error) {
    console.error(error);
    return res.status(500).json({
      success: false,
      message: "Error al actualizar el permiso.",
      error: error.message,
    });
  }
};

function normalizeTimeToSQL(value) {
  if (!value) return null;

  if (/^\d{2}:\d{2}:\d{2}$/.test(value)) return value;

  const tryFormats = ["hh:mm a", "hh:mm:ss a", "HH:mm", "HH:mm:ss"];
  for (const f of tryFormats) {
    const d = dayjs(value, f, true);
    if (d.isValid()) return d.format("HH:mm:ss");
  }
  return null;
}

