exports.editPermissionTime = async (req, res) => {
  try {
    const { permissionID, field, newTime } = req.body;
    if (!permissionID || !field || !newTime) {
      return res.status(400).json({
        success: false,
        message: "permissionID, field y newTime son requeridos",
      });
    }

    const [[perm]] = await db.query(
      `SELECT request, exitPermission, entryPermission, exitTimePermission, entryTimePermission, lunchTime
         FROM permissionattendance_emp
        WHERE permissionID = ?`,
      [permissionID]
    );
    if (!perm) {
      return res
        .status(404)
        .json({ success: false, message: "Permiso no encontrado" });
    }

    // === PERMITIR EDITAR CUALQUIERA DE LOS 4 CAMPOS ===
    const allowed = ["exitPermission", "entryPermission"];
    if (!allowed.includes(field)) {
      return res.status(400).json({
        success: false,
        message: `Campo no permitido. Usa: ${allowed.join(", ")}`,
      });
    }

    // Validación de formato y orden lógico del par correspondiente
    const hhmmss = String(newTime).trim();
    if (!/^\d{2}:\d{2}:\d{2}$/.test(hhmmss)) {
      return res
        .status(400)
        .json({ success: false, message: "Formato inválido. Usa HH:mm:ss" });
    }
    const toSec = (t) =>
      t
        ? t
          .split(":")
          .map(Number)
          .reduce((s, v, i) => s + v * [3600, 60, 1][i], 0)
        : null;

    // Clonar y colocar el cambio para evaluar el orden
    const next = { ...perm, [field]: hhmmss };

    if (field === "isPaid") {
      await db.query(
        "UPDATE permissionattendance_emp SET isPaid=? WHERE permissionID=?",
        [newValue ? 1 : 0, permissionID]
      );
      return res.json({ success: true });
    }

    // Si se edita un campo REAL, validar par real; si es OTORGADO, validar par otorgado
    if (field === "exitPermission" || field === "entryPermission") {
      const a = next.exitPermission; // SxP real
      const b = next.entryPermission; // SxR real
      if (a && b && toSec(a) > toSec(b)) {
        return res.status(400).json({
          success: false,
          message:
            "La salida real (SxP) no puede ser mayor que el regreso real (SxR).",
        });
      }
    } else {
      const a = next.exitPermission; // SxP real
      const b = next.entryPermission; // SxR real // otorgado fin
      if (a && b && toSec(a) > toSec(b)) {
        return res.status(400).json({
          success: false,
          message: "La hora otorgada de inicio no puede ser mayor a la de fin.",
        });
      }
    }

    // Actualizar
    await db.query(
      `UPDATE permissionattendance_emp
          SET ${field} = ?, updatedDate = NOW(), updatedBy = ?
        WHERE permissionID = ?`,
      [hhmmss, getUserIdFromToken(req) || null, permissionID]
    );

    // Tiempo real
    io.emit("permission:updatedTime", {
      permissionID,
      field, // cualquiera de los 4
      value: hhmmss, // 'HH:mm:ss'
    });

    return res.json({ success: true, message: "Hora actualizada" });
  } catch (err) {
    console.error(err);
    return res.status(500).json({
      success: false,
      message: "No se pudo editar la hora",
      error: err.message,
    });
  }
};

