//Endpoint para actualizar una maternidad
exports.updateMaternity = async (req, res) => {
  try {
    const { id } = req.params; // maternityID
    const { maternitytypeID, startDate, endDate, comment } = req.body;

    if (!maternitytypeID || !startDate || !endDate) {
      return res.status(400).json({ success: false, message: "Datos incompletos." });
    }

    const sd = dayjs(startDate).format('YYYY-MM-DD');
    const ed = dayjs(endDate).format('YYYY-MM-DD');

    if (dayjs(sd).isAfter(dayjs(ed))) {
      return res
        .status(400)
        .json({ success: false, message: "La fecha de inicio no puede ser mayor que la de fin." });
    }

    // Obtener el registro actual de maternidad para saber el employeeID y tipo anterior si es necesario
    const [existingMaternity] = await db.query(
      `SELECT employeeID, maternitytypeID, startDate, endDate
       FROM maternity_emp
       WHERE maternityID = ?
       LIMIT 1`,
      [id]
    );

    if (!existingMaternity || existingMaternity.length === 0) {
      return res.status(404).json({ success: false, message: "Registro de maternidad no encontrado." });
    }

    const employeeID = existingMaternity[0].employeeID;
    const previousMaternityType = Number(existingMaternity[0].maternitytypeID);
    const previousStartDate = dayjs(existingMaternity[0].startDate).format("YYYY-MM-DD");
    const previousEndDate = dayjs(existingMaternity[0].endDate).format("YYYY-MM-DD");
    const maternityType = Number(maternitytypeID);
    const isPreMaternity = maternityType === 1;
    const isPostMaternity = maternityType === 2;
    const wasPreMaternity = previousMaternityType === 1;
    const wasPostMaternity = previousMaternityType === 2;
    const userId = getUserIdFromToken(req) || null;

    //  Actualizar la tabla maternity_emp
    await db.query(
      `UPDATE maternity_emp
       SET maternitytypeID = ?, startDate = ?, endDate = ?, comment = ?, updatedDate = NOW(), updatedBy = ?
       WHERE maternityID = ?`,
      [maternitytypeID, sd, ed, comment || null, userId, id]
    );

    const [pregnancyExceptions] = await db.query(
      `SELECT exceptionID
       FROM exceptions_emp
       WHERE LOWER(exceptionName) LIKE '%embarazada%'
       LIMIT 1`
    );
    const [lactationExceptions] = await db.query(
      `SELECT exceptionID
       FROM exceptions_emp
       WHERE LOWER(exceptionName) LIKE '%lactancia%'
       LIMIT 1`
    );
    const [noExceptionRows] = await db.query(
      `SELECT exceptionID
       FROM exceptions_emp
       WHERE LOWER(exceptionName) LIKE '%sin excepciones%'
       LIMIT 1`
    );

    if (pregnancyExceptions.length > 0) {
      const pregnancyExceptionID = pregnancyExceptions[0].exceptionID;
      const previousPregnancyEndDate = dayjs(previousStartDate)
        .subtract(1, "day")
        .format("YYYY-MM-DD");

      if (wasPreMaternity) {
        if (isPreMaternity) {
          const [updated] = await db.query(
            `UPDATE h_assigmentexception_emp
             SET endDate = ?, updatedDate = NOW(), updatedBy = ?
             WHERE employeeID = ? AND exceptionID = ? AND DATE(endDate) = ?`,
            [dayjs(sd).subtract(1, "day").format("YYYY-MM-DD"), userId, employeeID, pregnancyExceptionID, previousPregnancyEndDate]
          );

          if (updated.affectedRows === 0) {
            await db.query(
              `UPDATE h_assigmentexception_emp
               SET endDate = ?, updatedDate = NOW(), updatedBy = ?
               WHERE employeeID = ? AND exceptionID = ?
                 AND (endDate IS NULL OR DATE(endDate) >= ?)`,
              [dayjs(sd).subtract(1, "day").format("YYYY-MM-DD"), userId, employeeID, pregnancyExceptionID, dayjs(sd).subtract(1, "day").format("YYYY-MM-DD")]
            );
          }
        } else {
          await db.query(
            `UPDATE h_assigmentexception_emp
             SET endDate = NULL, updatedDate = NOW(), updatedBy = ?
             WHERE employeeID = ? AND exceptionID = ? AND DATE(endDate) = ?`,
            [userId, employeeID, pregnancyExceptionID, previousPregnancyEndDate]
          );
        }
      } else if (isPreMaternity) {
        const pregnantEndDate = dayjs(sd).subtract(1, "day").format("YYYY-MM-DD");
        await db.query(
          `UPDATE h_assigmentexception_emp
           SET endDate = ?, updatedDate = NOW(), updatedBy = ?
           WHERE employeeID = ? AND exceptionID = ?
             AND (endDate IS NULL OR DATE(endDate) >= ?)`,
          [pregnantEndDate, userId, employeeID, pregnancyExceptionID, pregnantEndDate]
        );
      }
    }

    if (lactationExceptions.length > 0) {
      const lactationExceptionID = lactationExceptions[0].exceptionID;
      const previousLactationStartDate = dayjs(previousEndDate).add(1, "day").format("YYYY-MM-DD");
      const lactationStartDate = dayjs(ed).add(1, "day").format("YYYY-MM-DD");
      const lactationEndDate = dayjs(sd).add(6, "month").format("YYYY-MM-DD");
      const previousNoExceptionStartDate = dayjs(previousStartDate)
        .add(6, "month")
        .add(1, "day")
        .format("YYYY-MM-DD");
      const noExceptionStartDate = dayjs(lactationEndDate).add(1, "day").format("YYYY-MM-DD");

      if (isPostMaternity) {
        await db.query(
          `UPDATE h_assigmentexception_emp
           SET endDate = ?, updatedDate = NOW(), updatedBy = ?
           WHERE employeeID = ?
             AND exceptionID <> ?
             AND (endDate IS NULL OR DATE(endDate) >= DATE(?))
             AND DATE(startDate) < ?`,
          [
            dayjs(lactationStartDate).subtract(1, "day").format("YYYY-MM-DD"),
            userId,
            employeeID,
            lactationExceptionID,
            lactationStartDate,
            lactationStartDate,
          ]
        );
      }

      if (wasPostMaternity) {
        if (isPostMaternity) {
        const [existingLactation] = await db.query(
        `SELECT hassignmentexceptionID
        FROM h_assigmentexception_emp
        WHERE employeeID = ?
          AND exceptionID = ?
          AND DATE(startDate) <= DATE(?)
          AND (
            endDate IS NULL
            OR DATE(endDate) >= DATE(?)
          )
        ORDER BY hassignmentexceptionID DESC
        LIMIT 1`,
        [
          employeeID,
          lactationExceptionID,
          lactationEndDate,
          lactationStartDate,
        ]
      );

          if (existingLactation.length > 0) {
            await db.query(
              `UPDATE h_assigmentexception_emp
               SET startDate = ?, endDate = ?, updatedDate = NOW(), updatedBy = ?
               WHERE hassignmentexceptionID = ?`,
              [lactationStartDate, lactationEndDate, userId, existingLactation[0].hassignmentexceptionID]
            );
          } else {
            await db.query(
              `INSERT INTO h_assigmentexception_emp
               (employeeID, exceptionID, startDate, endDate, createdDate, createdBy)
               VALUES (?, ?, ?, ?, NOW(), ?)`,
              [employeeID, lactationExceptionID, lactationStartDate, lactationEndDate, userId]
            );
          }

          if (noExceptionRows.length === 0) {
            throw new Error("No se encontró la excepción 'Sin excepciones'.");
          }

          const noExceptionID = noExceptionRows[0].exceptionID;
          const [existingNoException] = await db.query(
            `SELECT hassignmentexceptionID
             FROM h_assigmentexception_emp
             WHERE employeeID = ? AND exceptionID = ? AND DATE(startDate) = ?
             ORDER BY hassignmentexceptionID DESC
             LIMIT 1`,
            [employeeID, noExceptionID, previousNoExceptionStartDate]
          );

          if (existingNoException.length > 0) {
            await db.query(
              `UPDATE h_assigmentexception_emp
               SET startDate = ?, endDate = NULL, updatedDate = NOW(), updatedBy = ?
               WHERE hassignmentexceptionID = ?`,
              [noExceptionStartDate, userId, existingNoException[0].hassignmentexceptionID]
            );
          } else {
            await db.query(
              `INSERT INTO h_assigmentexception_emp
               (employeeID, exceptionID, startDate, endDate, createdDate, createdBy)
               VALUES (?, ?, ?, NULL, NOW(), ?)`,
              [employeeID, noExceptionID, noExceptionStartDate, userId]
            );
          }
        } else {
          await db.query(
            `DELETE FROM h_assigmentexception_emp
             WHERE employeeID = ? AND exceptionID = ?
               AND DATE(startDate) = ?`,
            [employeeID, lactationExceptionID, previousLactationStartDate]
          );

          if (noExceptionRows.length > 0) {
            await db.query(
              `DELETE FROM h_assigmentexception_emp
               WHERE employeeID = ? AND exceptionID = ? AND DATE(startDate) = ?`,
              [employeeID, noExceptionRows[0].exceptionID, previousNoExceptionStartDate]
            );
          }
        }
      } else if (isPostMaternity) {
        const closePreviousDate = dayjs(lactationStartDate).subtract(1, "day").format("YYYY-MM-DD");
        await db.query(
          `UPDATE h_assigmentexception_emp
           SET endDate = ?, updatedDate = NOW(), updatedBy = ?
           WHERE employeeID = ? AND exceptionID = ?
             AND (endDate IS NULL OR DATE(endDate) >= ?)`,
          [closePreviousDate, userId, employeeID, lactationExceptionID, closePreviousDate]
        );
        await db.query(
          `INSERT INTO h_assigmentexception_emp
           (employeeID, exceptionID, startDate, endDate, createdDate, createdBy)
           VALUES (?, ?, ?, ?, NOW(), ?)`,
          [employeeID, lactationExceptionID, lactationStartDate, lactationEndDate, userId]
        );

        if (noExceptionRows.length === 0) {
           throw new Error("No se encontró la excepción 'Sin excepciones'.");
        }

        await db.query(
           `INSERT INTO h_assigmentexception_emp
            (employeeID, exceptionID, startDate, endDate, createdDate, createdBy)
            VALUES (?, ?, ?, NULL, NOW(), ?)`,
           [employeeID, noExceptionRows[0].exceptionID, noExceptionStartDate, userId]
        );
      }
    }

    return res.json({ success: true, message: "Maternidad y excepciones actualizadas correctamente." });
  } catch (err) {
    console.error("updateMaternity error:", err);
    return res.status(500).json({ success: false, message: "Error al actualizar maternidad" });
  }
};

