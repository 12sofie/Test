//Agregar boton para limpiar calendario **pendiente 
exports.addMaternity = async (req, res) => {
  try {
    const {
      employeeID,
      maternitytypeID,
      startDate,
      endDate,
      comment,
      documentation,
    } = req.body;

    if (!employeeID || !maternitytypeID || !startDate || !endDate) {
      return res.status(400).json({
        success: false,
        message: "Datos incompletos.",
      });
    }

    if (
      !dayjs(startDate).isValid() ||
      !dayjs(endDate).isValid() ||
      dayjs(startDate).isAfter(dayjs(endDate))
    ) {
      return res.status(400).json({
        success: false,
        message: "La fecha de inicio no puede ser mayor que la de fin.",
      });
    }

    const sd = dayjs(startDate).format("YYYY-MM-DD");
    const ed = dayjs(endDate).format("YYYY-MM-DD");
    const maternityType = Number(maternitytypeID);
    const isPreMaternity = maternityType === 1;
    const isPostMaternity = maternityType === 2;
    const userId = getUserIdFromToken(req) || null;

    // Evitar maternidades duplicadas o períodos incompatibles.
    const overlapQuery = `
      SELECT maternityID
      FROM maternity_emp
      WHERE employeeID = ?
      AND maternitytypeID = ?
        AND NOT (
          DATE(endDate) < DATE(?)
          OR DATE(startDate) > DATE(?)
        ) `;
        // ${
        //   isPostMaternity
        //     ? "AND NOT (maternitytypeID = 1 AND DATE(endDate) = DATE(?))"
        //     : ""
        // }
        // ${
        //   isPreMaternity
        //     ? "AND NOT (maternitytypeID = 2 AND DATE(startDate) = DATE(?))"
        //     : ""
        // }

    const overlapParams = [employeeID, maternitytypeID, sd, ed];

    // if (isPostMaternity) {
    //   overlapParams.push(sd);
    // } else if (isPreMaternity) {
    //   overlapParams.push(ed);
    // }

    const [overlap] = await db.query(overlapQuery, overlapParams);

    if (overlap.length > 0) {
      return res.status(400).json({
        success: false,
        message:
          "Ya existe una maternidad registrada para las fechas seleccionadas.",
      });
    }

    // Registrar maternidad.
    const [r] = await db.query(
      `INSERT INTO maternity_emp
        (
          employeeID,
          maternitytypeID,
          startDate,
          endDate,
          comment,
          documentation,
          createDate,
          createdBy
        )
       VALUES (?, ?, ?, ?, ?, ?, NOW(), ?)`,
      [
        employeeID,
        maternityType,
        sd,
        ed,
        comment || null,
        documentation || 0,
        userId,
      ]
    );

    // PRENATAL: cerrar la excepción de embarazada un día antes del prenatal.
    if (isPreMaternity) {
      const pregnantEndDate = dayjs(sd)
        .subtract(1, "day")
        .format("YYYY-MM-DD");

      const [pregnancyRows] = await db.query(
        `SELECT exceptionID
         FROM exceptions_emp
         WHERE LOWER(exceptionName) LIKE '%embarazada%'
         LIMIT 1`
      );

      if (pregnancyRows.length > 0) {
        const pregnancyExceptionID = pregnancyRows[0].exceptionID;
        await db.query(
          `UPDATE h_assigmentexception_emp
           SET endDate = ?,
               updatedDate = NOW(),
               updatedBy = ?
           WHERE employeeID = ?
             AND exceptionID = ?
             AND (endDate IS NULL OR DATE(endDate) >= ?)`,
          [
            pregnantEndDate,
            userId,
            employeeID,
            pregnancyExceptionID,
            pregnantEndDate,
          ]
        );
      }
    }

    // POSTNATAL: crear o actualizar lactancia sin duplicarla.
    if (isPostMaternity) {
      // La lactancia inicia al día siguiente del fin del postnatal.
      // Finaliza seis meses después del inicio del postnatal.
      const lactationStartDate = dayjs(ed)
        .add(1, "day")
        .format("YYYY-MM-DD");

      const lactationEndDate = dayjs(sd)
        .add(6, "month")
        .format("YYYY-MM-DD");

      const noExceptionStartDate = dayjs(lactationEndDate)
        .add(1, "day")
        .format("YYYY-MM-DD");

      const [lactationRows] = await db.query(
        `SELECT exceptionID
         FROM exceptions_emp
         WHERE LOWER(exceptionName) LIKE '%lactancia%'
         LIMIT 1`
      );

      const [noExceptionRows] = await db.query(
        `SELECT exceptionID
         FROM exceptions_emp
         WHERE LOWER(exceptionName) LIKE '%sin excepciones%'
         LIMIT 1`
      );

      if (lactationRows.length > 0) {
        const lactationExceptionID = lactationRows[0].exceptionID;

        // Buscar una excepción de lactancia existente que coincida
        // con el período que corresponde al postnatal.
        const [existingLactation] = await db.query(
          `SELECT hassignmentexceptionID
           FROM h_assigmentexception_emp
           WHERE employeeID = ?
             AND exceptionID = ?
             AND DATE(startDate) <= DATE(?)
             AND (
               endDate IS NULL
               OR DATE(endDate) >= DATE(?)
             )
           ORDER BY hassignmentexceptionID DESC
           LIMIT 1`,
          [
            employeeID,
            lactationExceptionID,
            lactationEndDate,
            lactationStartDate,
          ]
        );

        let existingLactationID = null;

        if (existingLactation.length > 0) {
          // Ya existe una lactancia: conservar el registro y actualizarlo.
          existingLactationID =
            existingLactation[0].hassignmentexceptionID;

          await db.query(
            `UPDATE h_assigmentexception_emp
             SET startDate = ?,
                 endDate = ?,
                 updatedDate = NOW(),
                 updatedBy = ?
             WHERE hassignmentexceptionID = ?`,
            [
              lactationStartDate,
              lactationEndDate,
              userId,
              existingLactationID,
            ]
          );
        } else {
          // No existe una lactancia para ese período: crearla.
          const [insertLactation] = await db.query(
            `INSERT INTO h_assigmentexception_emp
              (
                employeeID,
                exceptionID,
                startDate,
                endDate,
                createdDate,
                createdBy
              )
             VALUES (?, ?, ?, ?, NOW(), ?)`,
            [
              employeeID,
              lactationExceptionID,
              lactationStartDate,
              lactationEndDate,
              userId,
            ]
          );

          existingLactationID = insertLactation.insertId;
        }

        // Cerrar otros períodos de lactancia que se solapen con el período
        // nuevo, sin modificar el registro que acabamos de conservar.
        if (existingLactationID !== null) {
          const closePreviousDate = dayjs(lactationStartDate)
            .subtract(1, "day")
            .format("YYYY-MM-DD");

          await db.query(
            `UPDATE h_assigmentexception_emp
             SET endDate = ?,
                 updatedDate = NOW(),
                 updatedBy = ?
             WHERE employeeID = ?
               AND exceptionID = ?
               AND hassignmentexceptionID <> ?
               AND (endDate IS NULL OR DATE(endDate) >= ?)
               AND DATE(startDate) < DATE(?)`,
            [
              closePreviousDate,
              userId,
              employeeID,
              lactationExceptionID,
              existingLactationID,
              closePreviousDate,
              lactationStartDate,
            ]
          );
        }
      }

      // Al iniciar lactancia, cerrar la excepción activa anterior el día
      // anterior, sin cerrar la propia lactancia ni crear el solapamiento.
      await db.query(
        `UPDATE h_assigmentexception_emp
         SET endDate = ?,
             updatedDate = NOW(),
             updatedBy = ?
         WHERE employeeID = ?
           AND exceptionID <> COALESCE(?, -1)
             AND (endDate IS NULL OR DATE(endDate) >= DATE(?))
           AND DATE(startDate) < ?`,
        [
          dayjs(lactationStartDate).subtract(1, "day").format("YYYY-MM-DD"),
          userId,
          employeeID,
          lactationRows[0]?.exceptionID,
          lactationStartDate,
          lactationStartDate,
        ]
      );

      // Registrar o actualizar "Sin excepciones" para evitar duplicados
      // en la fecha de inicio calculada.
      if (noExceptionRows.length === 0) {
        throw new Error("No se encontró la excepción 'Sin excepciones'.");
      }

      const noExceptionID = noExceptionRows[0].exceptionID;

      const [existingNoException] = await db.query(
        `SELECT hassignmentexceptionID
         FROM h_assigmentexception_emp
         WHERE employeeID = ?
           AND exceptionID = ?
           AND DATE(startDate) = ?
         ORDER BY hassignmentexceptionID DESC
         LIMIT 1`,
        [employeeID, noExceptionID, noExceptionStartDate]
      );

      if (existingNoException.length > 0) {
        await db.query(
          `UPDATE h_assigmentexception_emp
           SET endDate = NULL,
               updatedDate = NOW(),
               updatedBy = ?
           WHERE hassignmentexceptionID = ?`,
          [
            userId,
            existingNoException[0].hassignmentexceptionID,
          ]
        );
      } else {
        await db.query(
          `INSERT INTO h_assigmentexception_emp
            (
              employeeID,
              exceptionID,
              startDate,
              endDate,
              createdDate,
              createdBy
            )
           VALUES (?, ?, ?, NULL, NOW(), ?)`,
          [employeeID, noExceptionID, noExceptionStartDate, userId]
        );
      }
    }

    return res.status(201).json({
      success: true,
      message: "Maternidad registrada y excepciones actualizadas.",
      maternityID: r.insertId,
    });
  } catch (err) {
    console.error("addMaternity error:", err);

    return res.status(500).json({
      success: false,
      message: "Error al registrar la maternidad.",
    });
  }
};


