exports.createGroupDeferredPermissions = async (req, res) => {
  const language = req.headers["accept-language"] || "en";

  try {
    const {
      date,
      comment,
      employeesSelected,
      permissionTypeID,
      isPaid,
      lunchTime,
    } = req.body;


    if (
      !date ||
      !comment ||
      !permissionTypeID ||
      !Array.isArray(employeesSelected) ||
      employeesSelected.length === 0
    ) {
      return res
        .status(400)
        .json({ success: false, message: t("requiredFields", language) });
    }

    const pType = Number(permissionTypeID);
    if (!pType || Number.isNaN(pType)) {
      return res
        .status(400)
        .json({ success: false, message: t("requiredFields", language) });
    }


    const paid = isPaid ? 1 : 0;
    const lunch = lunchTime ? 1 : 0;

    let inserted = 0;
    let skipped = 0;

    const tasks = employeesSelected.map(async (emp) => {
      const start = emp.startTime; // HH:mm:ss
      const entry = emp.entryTime; // HH:mm:ss
      const employeeID = emp.employeeID;

      if (!employeeID || !start || !entry) {
        skipped++;
        return;
      }

      try {
        await db.query(
          `INSERT INTO permissionattendance_emp 
            (
              permissionTypeID, employeeID, date, line,
              exitTimePermission, entryTimePermission, exitPermission, entryPermission,
              comment, coveredTime, lunchTime, request, isPaid, isApproved, approvedBy,
              status, createdDate, createdBy
            )
           VALUES ( ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ? )`,
          [
            pType,
            employeeID,
            dayjs(date).format("YYYY-MM-DD"),
            null,

            start, // exitTimePermission
            entry, // entryTimePermission
            start, // exitPermission
            entry, // entryPermission

            comment.trim(),
            0,      // coveredTime (NO lo usas)
            lunch,  // lunchTime
            0,      // request

            paid,

            1,      // isApproved (si tu flujo lo quiere así; si no, pon 0)
            3,      // approvedBy (ajusta según tu lógica / usuario)
            0,      // status

            ...camposAuditoriaADD(req),
          ]
        );

        inserted++;
      } catch (e) {
        console.error("Insert deferred permission error:", e);
        skipped++;
      }
    });

    await Promise.all(tasks);

    if (inserted > 0 && skipped === 0) {
      return res.json({
        success: true,
        message: t("saveSuccess", language),
      });
    }

    if (inserted > 0 && skipped > 0) {
      return res.json({
        success: true,
        message:
          t("saveSuccess", language) + ` (${inserted} OK, ${skipped} omitidos)`,
      });
    }

    return res.status(400).json({
      success: false,
      message: t("requiredFields", language),
    });
  } catch (err) {
    console.error("createGroupDeferredPermissions error:", err);
    return res
      .status(500)
      .json({ success: false, message: t("saveError", language) });
  }
};

// Exportar juntas Incapacidades y Maternidades a Excel
exports.exportDisabilityandMaternityToExcel = async (req, res) => {
  const language = (req.headers["accept-language"] || "es").toLowerCase();
  const { from, to } = req.query;
  const COLL = "utf8mb4_general_ci";
  const C = (expr) => `CONVERT(${expr} USING utf8mb4) COLLATE ${COLL}`;
  try {
    const kind = (req.query.kind || "ALL").toUpperCase(); // ALL | DIS | MAT
    const q = (req.query.q || "").trim();
    const qLike = `%${q}%`;
    const hasRange = !!(from && to);
    const weekFrom = hasRange ? dayjs(from).isoWeek() : null;
    const weekTo = hasRange ? dayjs(to).isoWeek() : null;
    const isWrappedWeekRange = hasRange ? weekFrom > weekTo : false;

    // ======================
    // SQL INCAPACIDADES
    // ======================
    const disabilitySQL = `
  SELECT
    ${C("'DIS'")} AS tipo,
    e.codeEmployee AS codigo,
    ${C(`CONCAT(
      COALESCE(e.firstName,''),' ',
      COALESCE(e.middleName,''),' ',
      COALESCE(e.lastName,''),' ',
      COALESCE(e.secondLastName,'')
    )`)} AS empleado,
    ${C("COALESCE(d.weekPaid,'-')")} AS weekPaid,
    ${C("dt.disabilityName")} AS tipoRegistro,
    ${C("COALESCE(ex.name,'-')")} AS extPor,
    startTime AS horaInicio,
    DATE(d.startDate) AS inicio,
    DATE(d.endDate) AS fin,
    (DATEDIFF(d.endDate, d.startDate) + 1) AS dias,
    ${C("COALESCE(d.comment,'')")} AS comentario,
    d.createdDate AS fechaCreacion
  FROM disability_emp d
  INNER JOIN disabilitytype_emp dt
    ON dt.disabilityTypeID = d.disabilityTypeID
  LEFT JOIN extdisability_emp ex
    ON ex.extByID = d.extByID
  INNER JOIN employees_emp e
    ON e.employeeID = d.employeeID
  WHERE 1=1 AND d.documentation = 1
  ${q
        ? `AND (
        e.codeEmployee LIKE ? OR
        CONCAT(
          COALESCE(e.firstName,''),' ',
          COALESCE(e.middleName,''),' ',
          COALESCE(e.lastName,''),' ',
          COALESCE(e.secondLastName,'')
        ) LIKE ?
      )`
        : ``
      }
  ${hasRange
        ? `AND (
            NOT (DATE(d.endDate) < DATE(?) OR DATE(d.startDate) > DATE(?))
            OR ${isWrappedWeekRange
          ? `(d.weekPaid >= ? OR d.weekPaid <= ?)`
          : `d.weekPaid BETWEEN ? AND ?`
        }
          )`
        : ``
      }
`;

    // ======================
    // SQL MATERNIDAD
    // ======================
    const maternitySQL = `
  SELECT
    ${C("'MAT'")} AS tipo,
   e.codeEmployee AS codigo,
    ${C(`CONCAT(
      COALESCE(e.firstName,''),' ',
      COALESCE(e.middleName,''),' ',
      COALESCE(e.lastName,''),' ',
      COALESCE(e.secondLastName,'')
    )`)} AS empleado,
    '-' AS weekPaid,
    ${C("mt.maternityType")} AS tipoRegistro,
    ${C("'-'")} AS extPor,
    '' AS horaInicio,
    DATE(m.startDate) AS inicio,
    DATE(m.endDate) AS fin,
    (DATEDIFF(m.endDate, m.startDate) + 1) AS dias,
    ${C("COALESCE(m.comment,'')")} AS comentario,
    m.createDate AS fechaCreacion
  FROM maternity_emp m
  INNER JOIN maternitytype_emp mt
    ON mt.maternitytypeID = m.maternitytypeID
  INNER JOIN employees_emp e
    ON e.employeeID = m.employeeID
  WHERE 1=1 AND m.documentation = 1
  ${q
        ? `AND (
        e.codeEmployee LIKE ? OR
        CONCAT(
          COALESCE(e.firstName,''),' ',
          COALESCE(e.middleName,''),' ',
          COALESCE(e.lastName,''),' ',
          COALESCE(e.secondLastName,'')
        ) LIKE ?
      )`
        : ``
      }
  ${hasRange
        ? `AND NOT (DATE(m.endDate) < DATE(?) OR DATE(m.startDate) > DATE(?))`
        : ``
      }
`;
    let rows = [];
    let params = [];
    const disParams = [
      ...(q ? [qLike, qLike] : []),
      ...(hasRange ? [from, to, weekFrom, weekTo] : []),
    ];
    const matParams = [
      ...(q ? [qLike, qLike] : []),
      ...(hasRange ? [from, to] : []),
    ];

    if (kind === "DIS") {
      params = disParams;
      const [r] = await db.query(disabilitySQL, params);
      rows = r;
    } else if (kind === "MAT") {
      params = matParams;
      const [r] = await db.query(maternitySQL, params);
      rows = r;
    } else {
      const unionSQL = `
        (${disabilitySQL})
        UNION ALL
        (${maternitySQL})
        ORDER BY fechaCreacion DESC
        `;
      params = [...disParams, ...matParams];
      const [r] = await db.query(unionSQL, params);
      rows = r;
    }

    // ======================
    // EXCEL
    // ======================
    const workbook = new ExcelJS.Workbook();
    const worksheet = workbook.addWorksheet("Incapacidades y Maternidad");

    worksheet.columns = [
      { header: "Tipo", key: "tipo", width: 12 },
      { header: "Código", key: "codigo", width: 12 },
      { header: "Empleado", key: "empleado", width: 35 },
      { header: "Semana Pagada", key: "weekPaid", width: 15 },
      { header: "Tipo Incapacidad / Maternidad", key: "tipoRegistro", width: 30 },
      { header: "Ext. Por", key: "extPor", width: 20 },
      { header: "Hora Inicio", key: "horaInicio", width: 14 },
      { header: "Comienzo", key: "inicio", width: 14 },
      { header: "Finalización", key: "fin", width: 14 },
      { header: "Días", key: "dias", width: 10 },
      { header: "Comentario", key: "comentario", width: 35 },
      { header: "Fecha de Creación", key: "fechaCreacion", width: 20 },
    ];

    // Header style
    worksheet.getRow(1).font = { bold: true };
    worksheet.getColumn("codigo").numFmt = "0";

    rows.forEach((r) => {
      worksheet.addRow({
        ...r,
        codigo: Number(r.codigo),
        inicio: r.inicio ? dayjs(r.inicio).format("YYYY-MM-DD") : "-",
        fin: r.fin ? dayjs(r.fin).format("YYYY-MM-DD") : "-",
        horaInicio: r.horaInicio ? dayjs(r.horaInicio, "HH:mm:ss").format("hh:mm A") : "-",
        fechaCreacion: r.fechaCreacion
          ? dayjs(r.fechaCreacion).format("YYYY-MM-DD hh:mm A")
          : "-",
      });
    });

    res.setHeader(
      "Content-Type",
      "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
    );
    res.setHeader(
      "Content-Disposition",
      `attachment; filename=disability_maternity_${kind}_${dayjs().format(
        "YYYYMMDD_HHmm"
      )}.xlsx`
    );

    await workbook.xlsx.write(res);
    res.end();
  } catch (error) {
    console.error("Export disability/maternity error:", error);
    res.status(500).json({
      success: false,
      message: "Error al exportar reporte",
    });
  }
};

// Endpoint para depurar y actulizar permisos 
exports.cleanAndUpdatePermissions = async (req, res) => {
  const language = req.headers["accept-language"] || "en";
  try {
    const { startDate, endDate } = req.body.params;
    if (!startDate || !endDate) {
      return res.status(400).json({ success: false, message: t('requiredFields') });
    }

    // Obetener los dias que hay entre las fechas (excluir día de hoy)
    const days = [];
    let current = dayjs(startDate);
    const end = dayjs(endDate);
    const today = dayjs().format("YYYY-MM-DD");
    while (current.isSameOrBefore(end)) {
      const d = current.format("YYYY-MM-DD");
      if (d !== today) {
        days.push(d);
      }
      current = current.add(1, "day");
    }

    for (const date of days) {
      // Obetener el horario del dia 
      const [infoTurnos] = await db.query(
        `
        select * from detailsshift_emp
        where day = ? and shiftID = 1;
        `,
        [capitalizar(dayjs(date).locale("en").format("dddd"))]
      );

      let entrada = infoTurnos[0]?.startTime || "07:00:00";
      let salida = infoTurnos[0]?.endTime || "16:45:00";

      // Obetener permisos para rellenar horas por llegada tarde
      const [permisosLlegadaTarde] = await db.query(
        `
        SELECT 
        permissionID, exitPermission, entryPermission, p.date, p.employeeID,
        entryTime, exitTime
        FROM permissionattendance_emp p
        left join h_attendance_emp h on p.date = h.date and p.employeeID = h.employeeID
        where p.date = ?
        and isnull(exitPermission) and isnull(entryPermission)
        and h.entryTime >= '07:05' and h.exitTime >= ?;
        `,
        [dayjs(date).format("YYYYMMDD"), salida]
      );

      // Obetener permisos que no se utilizaron para eliminarlos
      const [permisosNoUtilizados] = await db.query(
        `
          SELECT 
          permissionID, exitPermission, entryPermission, p.date, p.employeeID,
          entryTime, exitTime
          FROM permissionattendance_emp p
          left join h_attendance_emp h on p.date = h.date and p.employeeID = h.employeeID
          where p.date = ?
          and isnull(exitPermission) and isnull(entryPermission)
          and h.entryTime <= '07:05' and h.exitTime >= ?;
        `,
        [dayjs(date).format("YYYYMMDD"), salida]
      );

      const [permisosSinRegreso] = await db.query(
        `
        SELECT 
        p.permissionID, p.employeeID, p.exitPermission, p.entryPermission, 
        a.date assistenciaDate, a.entryTime, a.hattendanceID,
        COALESCE(
          (
            SELECT exHistory.exceptionTime
            FROM h_assigmentexception_emp hx
            INNER JOIN exceptions_emp exHistory ON exHistory.exceptionID = hx.exceptionID
            WHERE hx.employeeID = e.employeeID
              AND hx.startDate <= DATE(p.date)
              AND (hx.endDate IS NULL OR hx.endDate >= DATE(p.date))
            ORDER BY hx.startDate DESC, hx.hassignmentexceptionID DESC
            LIMIT 1
          ),
          CASE
            WHEN EXISTS (
              SELECT 1 FROM h_assigmentexception_emp hx
              WHERE hx.employeeID = e.employeeID
            ) THEN 0
            ELSE COALESCE(ex.exceptionTime, 0)
          END
        ) AS exceptionTime
        FROM permissionattendance_emp p
        inner join h_attendance_emp a on a.employeeID = p.employeeID and p.date = a.date
        inner join employees_emp e on a.employeeID = e.employeeID
        left join exceptions_emp ex on e.exceptionID = ex.exceptionID
        where p.date = ? and !isnull(p.exitPermission) and isnull(p.entryPermission);
        `,
        [
          dayjs(date).format("YYYY-MM-DD")
        ],
      );
      // Rellenar horas de llegada tarde
      for (const permiso of permisosLlegadaTarde) {
        await db.query(
          `
          UPDATE permissionattendance_emp
          SET exitPermission = ?, entryPermission = ?,
          updatedDate = NOW(), updatedBy = 2
          WHERE permissionID = ?;
        `,
          [entrada, permiso.entryTime, permiso.permissionID]
        );
      }

      // Eliminar permisos no utilizados
      for (const permiso of permisosNoUtilizados) {
        await db.query(
          `
          DELETE FROM permissionattendance_emp
          WHERE permissionID = ?;
        `,
          [permiso.permissionID]
        );
      }

      // Actualizar permisos sin regreso
      for (const permiso of permisosSinRegreso) {
        // Actualizar las horas de salida con el horario del dia
        await db.query(
          `
            UPDATE permissionattendance_emp
            SET entryPermission = ?
            WHERE permissionID = ?;
          `,
          [dayjs(`${dayjs(date).format("YYYY-MM-DD")} ${salida}`).subtract(permiso.exceptionTime, 'minutes').format("HH:mm:ss"), permiso.permissionID]
        );
        await db.query(
          `
            UPDATE h_attendance_emp
            SET exitTime = ?
            WHERE hattendanceID = ?;
      `,
          [permiso.exitPermission, permiso.hattendanceID],
        );
      }
    }
    res.status(200).json({ success: true, message: "Proceso de limpieza y actualización completado." });
  } catch (err) {
    console.error("cleanAndUpdatePermissions error:", err);
    return res.status(500).json({ success: false, message: t('updateError') });
  }
};

// Función para obtener permisos con filtros
exports.getAllPermissionsWithDetail = async (req, res) => {
  try {
    const { startDate, endDate } = req.query;
    let filters = [];
    let params = [];
    if (isValidString(startDate || dayjs().format("YYYY-MM-DD"))) {
      filters.push("pa.date >= ?");
      params.push(startDate || dayjs().format("YYYY-MM-DD"));
    }
    if (isValidString(endDate || dayjs().format("YYYY-MM-DD"))) {
      filters.push("pa.date <= ?");
      params.push(endDate || dayjs().format("YYYY-MM-DD"));
    }
    const whereClause =
      filters.length > 0 ? `WHERE ${filters.join(" AND ")}` : "";
    const [permissionResults] = await db.query(
      `
    	SELECT
	      pa.permissionID, pa.permissionTypeID, p.permissionTypeName, STR_TO_DATE(pa.date, '%Y-%m-%d') date,
        pa.comment, pa.isApproved, pa.exitPermission salida, pa.entryPermission entrada, pa.createdDate,
        CASE 
          WHEN pa.lunchTime THEN ROUND((TIMESTAMPDIFF(MINUTE, pa.exitPermission, pa.entryPermission)/60) -0.75, 2) 
          ELSE ROUND(TIMESTAMPDIFF(MINUTE, pa.exitPermission, pa.entryPermission)/60, 2) 
		    END diffTime, 
	      CONCAT(e.firstName, ' ', e.middleName, ' ', e.lastName) as fullName, e.codeEmployee,
	      CONCAT(e_aprobador.firstName, ' ', e_aprobador.lastName) AS approvedByFullName,
	      CONCAT(e_creador.firstName, ' ', e_creador.lastName) AS createdBy, 
        'Original' Type, pa.lunchTime, pa.isPaid
	    FROM
	      permissionattendance_emp pa
	      INNER JOIN permissiontype_emp p ON p.permissionTypeID = pa.permissionTypeID
	      INNER JOIN employees_emp e ON e.employeeID = pa.employeeID
	      LEFT JOIN users_us ua ON ua.userID = pa.approvedBy
	      LEFT JOIN employees_emp e_aprobador ON e_aprobador.employeeID = ua.employeeID
	      LEFT JOIN users_us uc ON uc.userID = pa.createdBy
	      LEFT JOIN employees_emp e_creador ON e_creador.employeeID = uc.employeeID
        ${whereClause}
	    ORDER BY pa.date ASC, e.codeEmployee ASC, pa.permissionID ASC;
      `,
      params
    );

    const [detailPermissions] = await db.query(
      `
        select 
        dp.detailPermissionID permissionID, 'N/A' permissionTypeID, 'N/A' permissionTypeName, STR_TO_DATE(pa.date, '%Y-%m-%d') date,
        dp.comment, 1 isApproved, dp.permitStartTime salida, dp.permitEndTime entrada, dp.createdDate,
        CASE 
          WHEN dp.lunchTime THEN ROUND((TIMESTAMPDIFF(MINUTE, dp.permitStartTime, dp.permitEndTime)/60) -0.75, 2) 
          ELSE ROUND(TIMESTAMPDIFF(MINUTE, dp.permitStartTime, dp.permitEndTime)/60, 2) 
        END diffTime,
        CONCAT(e.firstName, ' ', e.middleName, ' ', e.lastName) as fullName, e.codeEmployee,
        CONCAT(e_creador.firstName, ' ', e_creador.lastName) AS approvedByFullName,
        CONCAT(e_creador.firstName, ' ', e_creador.lastName) AS createdBy, 
        'Detalle' Type, dp.lunchTime, dp.withPay isPaid
        from detailpermission_emp dp
        inner join permissionattendance_emp pa on pa.permissionID = dp.permissionID
        INNER JOIN employees_emp e ON e.employeeID = pa.employeeID
        LEFT JOIN users_us uc ON uc.userID = dp.createdBy
        LEFT JOIN employees_emp e_creador ON e_creador.employeeID = uc.employeeID
        where dp.permissionID in 
      (select permissionID from permissionattendance_emp pa ${whereClause});
      `,
      params
    );
    let combinedResults = [...permissionResults, ...detailPermissions];
    combinedResults.sort((a, b) => {
      if (a.date < b.date) return -1;
      if (a.date > b.date) return 1;
      if (a.codeEmployee < b.codeEmployee) return -1;
      if (a.codeEmployee > b.codeEmployee) return 1;
      return 0;
    });

    res.json(combinedResults);
  } catch (err) {
    console.error("Error fetching permissions with filter:", err);
    res.status(500).json({
      message: "Error al cargar permisos con filtro",
      error: err.message,
    });
  }
};

exports.detailPermissionsByEmployee = async (req, res) => {
  try {
    const { employeeID, date } = req.query;

    const [attendance] = await db.query(
      `
      select * from
      h_attendance_emp h 
      where h.date = ? and h.employeeID = ?;
      `,
      [dayjs(date).format('YYYY-MM-DD'), employeeID]
    );

    const [permissionResults] = await db.query(
      `
        select 
        pa.*, pt.permissionTypeName,
        CONCAT(e_creador.firstName, ' ', e_creador.lastName) AS createdBy
        from
        permissionattendance_emp pa 
        inner join permissiontype_emp pt on pt.permissionTypeID = pa.permissionTypeID
        LEFT JOIN users_us uc ON uc.userID = pa.createdBy
	      LEFT JOIN employees_emp e_creador ON e_creador.employeeID = uc.employeeID
        where pa.date = ? and pa.employeeID = ?;
      `,
      [dayjs(date).format('YYYY-MM-DD'), employeeID]
    );

    const [permissionDetails] = await db.query(
      `
        select 
        *,
        CASE 
          WHEN dp.lunchTime THEN ROUND((TIMESTAMPDIFF(MINUTE, dp.permitStartTime, dp.permitEndTime)/60) -0.75, 2) 
          ELSE ROUND(TIMESTAMPDIFF(MINUTE, dp.permitStartTime, dp.permitEndTime)/60, 2) 
        END diffTime
        from
        detailpermission_emp dp 
        where dp.permissionID in (
          select permissionID from permissionattendance_emp p 
          where p.date = ? and p.employeeID = ?
        );
      `,
      [dayjs(date).format('YYYY-MM-DD'), employeeID]
    );

    let permissionWithDetails = permissionResults.map(pr => {
      return {
        ...pr,
        details: permissionDetails.filter(pd => pd.permissionID === pr.permissionID)
      }
    });

    res.json({ attendance: attendance[0], permissionWithDetails: permissionWithDetails });
  } catch (err) {
    console.log(err);

    res.status(500).json({
      message: "Error al cargar permisos detallados por empleado",
      error: err.message,
    });
  }
};

// Verificar si un usuario tiene acceso a un menú específico
exports.checkUserMenuPermission = async (req, res) => {
  try {
    const { userID, menuOptionID } = req.params;

    if (!userID || !menuOptionID) {
      return res.status(400).json({
        hasAccess: false,
        message: "userID y menuOptionID son requeridos"
      });
    }

    const [result] = await db.query(
      `SELECT 1
       FROM usermenu_us um
       WHERE um.userID = ?
         AND um.menuOptionID = ?
       LIMIT 1`,
      [userID, menuOptionID]
    );

    const hasAccess = result.length > 0;
    res.json({ hasAccess });
  } catch (error) {
    console.error('Error checking menu permission:', error);
    res.status(500).json({
      hasAccess: false,
      error: 'Error checking permission'
    });
  }
};
