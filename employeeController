// Agregar vacaciones (con GOCE/SIN GOCE)
exports.addEmployeeVacation = async (req, res) => {
  const language = req.headers["accept-language"] || "en";

  try {
    const { dates, employees, withPaid } = req.body;

    // Validar que los datos son correctos
    if (!Array.isArray(employees) || employees.length === 0 || !Array.isArray(dates) || dates.length === 0) {
      return res.status(400).json({ message: t("requiredFields", language) });
    }

    // Normalizar withPaid -> 0/1
    const paid = withPaid ? 1 : 0;

    // Validar/normalizar fechas (YYYY-MM-DD) y quitar duplicadas
    const cleanDates = Array.from(
      new Set(
        dates
          .map((d) => String(d).slice(0, 10))
          .filter((d) => dayjs(d, "YYYY-MM-DD", true).isValid())
      )
    );

    if (cleanDates.length === 0) {
      return res.status(400).json({
        message: "Fechas inválidas. Usa formato YYYY-MM-DD.",
      });
    }

    const audit = camposAuditoriaADD(req);


    const insertPromises = [];

    for (const date of cleanDates) {
      for (const employeeID of employees) {
        insertPromises.push(
          db.query(
            `
              INSERT INTO vacations_emp (employeeID, date, createdDate, createdBy, withPaid)
              VALUES (?, ?, ?, ?, ?)
            `,
            [employeeID, date, ...audit, paid]
          )
        );
      }
    }

    await Promise.all(insertPromises);

    return res.status(201).json({ message: t("saveSuccess", language) });
  } catch (error) {
    console.error("Error al agregar vacaciones:", error);
    return res.status(500).json({ message: t("saveError", language) });
  }
};


