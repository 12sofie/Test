    if (!existingRecord[0]) {
      return res.status(404).json({ message: "Registro de excepción no encontrado" });
    }

    const employeeID = existingRecord[0].employeeID;

    //validacion de bloqueo por maternidad(evitar edicion que proviene de la automatizacion)
    //CUANDO QUERIA MANEJAR DE FORMA AUTOMATICA Y MANUAL 
    // const[maternityCheck] = await db.query(
    //   `SELECT maternityID FROM maternity_emp
    //    WHERE employeeID = ?
    //    AND (
    //    (? BETWEEN startDate AND endDate)OR
    //    (? BETWEEN startDate AND endDate)OR
    //    (startDate BETWEEN ? AND ?)
    //    )`,
    //    [employeeID, formattedStartDate, formattedEndDate || formattedStartDate, formattedStartDate, formattedEndDate || formattedStartDate]
    // );

    // if (maternityCheck.length > 0) {
    //   return res.status(400).json({
    //     success:false,
    //     message:"No se puede editar esta excepción porque fue generada automáticamente por la programación de maternidad.",
    //   });
    // }
    
    const previousWasLactation = (existingRecord[0].exceptionName || "")
      .toLowerCase()
      .includes("lactancia");

    // 1. Cerrar las excepciones previas ABIERTAS (endDate IS NULL) un día antes de la fecha modificada
    await db.query(
      `UPDATE h_assigmentexception_emp
       SET endDate = DATE_SUB(?, INTERVAL 1 DAY)
       WHERE employeeID = ?
         AND DATE(startDate) < ?
         AND endDate IS NULL
         AND hassignmentexceptionID <> ?`,
      [formattedStartDate, employeeID, formattedStartDate, hassignmentexceptionID]
    );

    // 2. Validar que no se traslape con excepciones que ya tengan rangos cerrados
    const overlapCheck = await validateNoExceptionOverlap(
      employeeID,
      formattedStartDate,
      formattedEndDate,
      hassignmentexceptionID
    );

    if (!overlapCheck.valid) {
      return res.status(409).json({ message: overlapCheck.message });
    }

    // 3. Actualizar el registro de la excepción
    const [result] = await db.query(
      `UPDATE h_assigmentexception_emp
       SET exceptionID = ?, startDate = ?, endDate = ?, comments = ?, updatedDate = ?, updatedBy = ?
       WHERE hassignmentexceptionID = ?`,
      [
        exceptionID,
        formattedStartDate,
        formattedEndDate,
        comments || null,
        ...camposAuditoriaUPDATE(req),
        hassignmentexceptionID,
      ]
    );

    if (result.affectedRows === 0) {
      return res.status(404).json({ message: "Registro de excepción no encontrado" });
    }

    const [excRows] = await db.query(
      `SELECT exceptionName FROM exceptions_emp WHERE exceptionID = ?`,
      [exceptionID]
    );

    const nextIsLactation = (excRows[0]?.exceptionName || "")
      .toLowerCase()
      .includes("lactancia");

    if (previousWasLactation || nextIsLactation) {
      await syncLactationFollowUp(
        employeeID,
        previousWasLactation ? existingRecord[0].endDate : null,
        nextIsLactation ? formattedEndDate : null,
        req
      );
    }

    await syncEmployeeExceptionFromHistory(existingRecord[0].employeeID, req);

    return res.status(200).json({ message: "Registro actualizado correctamente" });
  } catch (error) {
    console.error("Error al actualizar el registro de excepción:", error);
    return res.status(500).json({ message: "Error interno al actualizar el historial de excepción" });
  }
};

exports.deleteExceptionHistory = async (req, res) => {
  const language = req.headers["accept-language"] || "es";
  const { hassignmentexceptionID } = req.params;

  if (!isValidNumber(hassignmentexceptionID)) {
    return res.status(400).json({ message: "ID de historial de excepción inválido" });
  }

  try {
    const [record] = await db.query(
      `SELECT h.employeeID,h.startDate, h.endDate, ex.exceptionName
       FROM h_assigmentexception_emp h
       LEFT JOIN exceptions_emp ex ON ex.exceptionID = h.exceptionID
       WHERE h.hassignmentexceptionID = ?
       LIMIT 1`,
      [hassignmentexceptionID]
    );

    if (!record[0]) {
      return res.status(404).json({ message: "Registro de excepción no encontrado" });
    }

    //validacion de bloqueo por maternidad(evitar eliminacion que proviene de la automatizacion)
    //CUANDO QUERIA MANEJAR FORMA AUTOMATICA Y MANUAL 
    // const[maternityCheck] = await db.query(
    //   `SELECT maternityID FROM maternity_emp
    //    WHERE employeeID = ?
    //     AND (
    //     (? BETWEEN startDate AND endDate)OR
    //     (? BETWEEN startDate AND endDate)OR
    //     (startDate BETWEEN ? AND ?)
    // )`,
    // [record[0].employeeID, record[0].startDate, record[0].endDate || record[0].startDate, record[0].startDate, record[0].endDate || record[0].startDate]
    // );

    // if (maternityCheck.length > 0) {
    //   return res.status(400).json({
    //     success:false,
    //     message:"No se puede eliminar esta excepción porque fue generada automáticamente por la programación de maternidad.",
    //   });
    // }

    const [result] = await db.query(
      "DELETE FROM h_assigmentexception_emp WHERE hassignmentexceptionID = ?",
      [hassignmentexceptionID]
    );
    if (result.affectedRows === 0) {
      return res.status(404).json({ message: "Registro de excepción no encontrado" });
    }

    // Al eliminar una excepción, la excepción anterior debe volver a cubrir
    // el período hasta el inicio de la siguiente; si era la última, queda abierta.
    const [nextException] = await db.query(
      `SELECT startDate
       FROM h_assigmentexception_emp
       WHERE employeeID = ?
         AND DATE(startDate) > DATE(?)
       ORDER BY startDate ASC, hassignmentexceptionID ASC
       LIMIT 1`,
      [record[0].employeeID, record[0].startDate]
    );

    const restoredEndDate = nextException.length > 0
      ? dayjs(nextException[0].startDate).subtract(1, "day").format("YYYY-MM-DD")
      : null;

    await db.query(
      `UPDATE h_assigmentexception_emp
       SET endDate = ?,
           updatedDate = NOW(),
           updatedBy = ?
       WHERE hassignmentexceptionID = (
         SELECT hassignmentexceptionID FROM (
           SELECT previous.hassignmentexceptionID
           FROM h_assigmentexception_emp previous
           WHERE previous.employeeID = ?
             AND DATE(previous.startDate) < DATE(?)
             AND (
               previous.endDate IS NULL
               OR DATE(previous.endDate) = DATE_SUB(DATE(?), INTERVAL 1 DAY)
             )
           ORDER BY previous.startDate DESC, previous.hassignmentexceptionID DESC
           LIMIT 1
         ) previous_assignment
       )`,
      [
        restoredEndDate,
        camposAuditoriaUPDATE(req)[1],
        record[0].employeeID,
        record[0].startDate,
        record[0].startDate,
      ]
    );

    if ((record[0].exceptionName || "").toLowerCase().includes("lactancia")) {
      await syncLactationFollowUp(record[0].employeeID, record[0].endDate, null, req);
    }

    await syncEmployeeExceptionFromHistory(record[0].employeeID, req);

    return res.status(200).json({ message: "Registro de excepción eliminado correctamente" });
  } catch (error) {
    console.error("Error al eliminar el registro de excepción:", error);
    return res.status(500).json({ message: "Error interno al eliminar la excepción del historial" });
  }
};

