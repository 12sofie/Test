    // de lo nuevo cambiar linea 1744 por esta
    const { exceptionID, startDate, endDate, comments } = req.body;

    // Validar que los IDs son números válidos
    if (!isValidNumber(employeeID) || !isValidNumber(exceptionID)) {
      return res
        .status(400)
        .json({ message: "ID de empleado o excepción no válido." });
    }
//de lo nuevo 
    if (!startDate) {
      return res.status(400).json({ message: "La fecha de inicio es obligatoria" });
    }

    const formattedStartDate = dayjs(startDate).format("YYYY-MM-DD");
    const formattedEndDate = endDate ? dayjs(endDate).format("YYYY-MM-DD") : null;
    // AND (endDate IS NULL OR DATE(endDate) >= ?) aqui se cierran todas las excepciones abiertas y cerradas 
    //Cerrar ÚNICAMENTE las excepciones previas que estén ABIERTAS (endDate IS NULL) un día antes del inicio de la nueva excepción
    await db.query(
      `UPDATE h_assigmentexception_emp
       SET endDate = DATE_SUB(?, INTERVAL 1 DAY)
       WHERE employeeID = ?
         AND DATE(startDate) < ?
         AND endDate IS NULL 
         AND exceptionID <> ?`,
      [formattedStartDate, employeeID, formattedStartDate, exceptionID]
    );

    const overlapCheck = await validateNoExceptionOverlap(
      employeeID,
      formattedStartDate,
      formattedEndDate
    );

    if (!overlapCheck.valid) {
      return res.status(409).json({ message: overlapCheck.message });
    }

    const [result] = await db.query(
      "UPDATE employees_emp SET exceptionID = ?, updatedDate = ?, updatedBy = ? WHERE employeeID = ?",
      [exceptionID, ...camposAuditoriaUPDATE(req), employeeID]
    );

    if (result.affectedRows === 0) {
      return res.status(404).json({ message: "Empleado no encontrado." });
    }
//de lo nuevo 
    await db.query(
      `INSERT INTO h_assigmentexception_emp
        (employeeID, exceptionID, startDate, endDate, comments, createdDate, createdBy)
       VALUES (?, ?, ?, ?, ?, ?, ?)`,
      [
        employeeID,
        exceptionID,
        formattedStartDate,
        formattedEndDate,
        comments || null,
        ...camposAuditoriaADD(req),
      ]
    );

     const [excRows] = await db.query(
      `SELECT exceptionName FROM exceptions_emp WHERE exceptionID=?`,
      [exceptionID]
    );
    if (excRows.length > 0 && excRows[0].exceptionName.toLowerCase().includes("lactancia") && formattedEndDate) {
      await syncLactationFollowUp(employeeID, null, formattedEndDate, req);
    }

    res
      .status(200)
      .json({ message: "Excepción del empleado actualizada correctamente." });
  } catch (error) {
    console.error("Error al actualizar la excepción del empleado:", error);
    res
      .status(500)
      .json({ message: "Error interno al actualizar la excepción." });
  }
};
//de lo nuevo 
async function validateNoExceptionOverlap(employeeID, startDate, endDate, excludeID = null) {
  if (endDate && startDate > endDate) {
    return {
      valid: false,
      message: "La fecha de inicio no puede ser mayor que la fecha final",
    };
  }

  const [rows] = await db.query(
    `SELECT hassignmentexceptionID
     FROM h_assigmentexception_emp
     WHERE employeeID = ?
       AND DATE(startDate) <= ?
       AND (endDate IS NULL OR DATE(endDate) >= ?)
       ${excludeID ? "AND hassignmentexceptionID <> ?" : ""}
     LIMIT 1`,
    [
      employeeID,
      endDate || "9999-12-31",
      startDate,
      ...(excludeID ? [excludeID] : []),
    ]
  );

  if (rows.length > 0) {
    return {
      valid: false,
      message: "El empleado ya tiene una excepción programada en ese rango de fechas",
    };
  }

  return { valid: true };
}

async function syncEmployeeExceptionFromHistory(employeeID, req = null) {
  const today = dayjs().format("YYYY-MM-DD");
  const [historyRows] = await db.query(
    `SELECT exceptionID
     FROM h_assigmentexception_emp
     WHERE employeeID = ?
       AND DATE(?) >= DATE(startDate)
       AND (endDate IS NULL OR DATE(?) <= DATE(endDate))
     ORDER BY startDate DESC, hassignmentexceptionID DESC
     LIMIT 1`,
    [employeeID, today, today]
  );

  const exceptionID = historyRows[0]?.exceptionID ?? 3;
  const auditValues = req
    ? camposAuditoriaUPDATE(req)
    : [dayjs().format("YYYY-MM-DD HH:mm:ss"), 0];

  await db.query(
    "UPDATE employees_emp SET exceptionID = ?, updatedDate = ?, updatedBy = ? WHERE employeeID = ?",
    [exceptionID, ...auditValues, employeeID]
  );
}

async function syncLactationFollowUp(employeeID, previousEndDate, nextEndDate, req) {
  const previousStartDate = previousEndDate
    ? dayjs(previousEndDate).add(1, "day").format("YYYY-MM-DD")
    : null;
  const nextStartDate = nextEndDate
    ? dayjs(nextEndDate).add(1, "day").format("YYYY-MM-DD")
    : null;

  if (!previousStartDate && !nextStartDate) {
    return;
  }

  const [noExceptionRows] = await db.query(
    `SELECT exceptionID
     FROM exceptions_emp
     WHERE LOWER(exceptionName) LIKE '%sin excepciones%'
     LIMIT 1`
  );

  if (noExceptionRows.length === 0) {
    throw new Error("No se encontró la excepción 'Sin excepciones'.");
  }

  const noExceptionID = noExceptionRows[0].exceptionID;
  const auditValues = camposAuditoriaUPDATE(req);

  if (previousStartDate && previousStartDate !== nextStartDate) {
    await db.query(
      `DELETE FROM h_assigmentexception_emp
       WHERE employeeID = ? AND exceptionID = ? AND DATE(startDate) = ?`,
      [employeeID, noExceptionID, previousStartDate]
    );
  }

  if (nextStartDate) {
    const [existingFollowUp] = await db.query(
      `SELECT hassignmentexceptionID
       FROM h_assigmentexception_emp
       WHERE employeeID = ? AND exceptionID = ? AND DATE(startDate) = ?
       ORDER BY startDate DESC
       LIMIT 1`,
     [employeeID, noExceptionID, dayjs(nextStartDate).subtract(7, "day").format("YYYY-MM-DD")]
    );

    if (existingFollowUp.length > 0) {
      await db.query(
        `UPDATE h_assigmentexception_emp
         SET endDate = NULL, updatedDate = ?, updatedBy = ?
         WHERE hassignmentexceptionID = ?`,
        [...auditValues, existingFollowUp[0].hassignmentexceptionID]
      );
    } else {
      await db.query(
        `INSERT INTO h_assigmentexception_emp
         (employeeID, exceptionID, startDate, endDate, comments, createdDate, createdBy)
         VALUES (?, ?, ?, NULL, ?, ?, ?)`,
        [
          employeeID,
          noExceptionID,
          nextStartDate,
          null,
          ...camposAuditoriaADD(req),
        ]
      );
