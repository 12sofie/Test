exports.updateEmployee = async (req, res) => {
  try {
    const { employeeID } = req.params;
    const schedulesManagedSeparately = req.body.schedulesManagedSeparately === true;
    //Actualizar datos del empleado
    if (!isValidNumber(employeeID)) {
      return res.status(400).json({ message: "ID de empleado inválido" });
    }
    const [result] = await db.query(
      `UPDATE employees_emp SET
          firstName = ?, middleName = ?, lastName = ?,
          secondLastName = ?, phoneNumber = ?, genderID = ?,
          docID = ?, docNumber = ?, birthDate = ?,
          bloodTypeID = ?, cityID = ?, stateID = ?,
          sectorID = ?, suburbID = ?, address = ?,
          gabachSize = ?, shirtSize = ?, divisionID = ?,
          departmentID = ?, areaID = ?, jobID = ?, managerID = ?,
          hireDate = ?, partnerName = ?, partnerage = ?,
          employeeTypeID =?, contractTypeID = ?, payrollTypeID = ?,
          shiftID = IF(?, shiftID, ?), exceptionID = IF(?, exceptionID, ?),
          educationLevelID = ?, educationGrade = ?, transportTypeID = ?,
          maritalStatusID = ?, nationality = ?, salary = ?,
          relatives = ?,
          requiredAttendance = ?, 
          updatedDate = ?, updatedBy = ?
          
      WHERE employeeID = ?`,
      [
        formatNamePart(req.body.employeeData.firstName),
        formatNamePart(req.body.employeeData.middleName),
        formatNamePart(req.body.employeeData.lastName),
        formatNamePart(req.body.employeeData.secondLastName),
        req.body.employeeData.phoneNumber,
        req.body.employeeData.genderID,
        req.body.employeeData.docID,
        req.body.employeeData.docNumber,
        dayjs(req.body.employeeData.birthDate).format("YYYY-MM-DD"),
        req.body.employeeData.bloodTypeID,
        req.body.employeeData.cityID.cityID,
        req.body.employeeData.stateID.stateID,
        req.body.employeeData.sectorID.sectorID,
        req.body.employeeData.suburbID.suburbID,
        req.body.employeeData.address,
        req.body.employeeData.gabachSize.sizeID,
        req.body.employeeData.shirtSize.sizeID,
        req.body.employeeData.divisionID.divisionID,
        req.body.employeeData.departmentID.departmentID,
        req.body.employeeData.areaID.areaID,
        req.body.employeeData.jobID.jobID,
        req.body.employeeData.managerID,
        dayjs(req.body.employeeData.hireDate).format("YYYY-MM-DD"),
        req.body.employeeData.partnerName,
        parseInt(req.body.employeeData.partnerage),
        req.body.employeeData.employeeTypeID,
        req.body.employeeData.contractTypeID,
        req.body.employeeData.payrollTypeID,
        schedulesManagedSeparately,
        req.body.employeeData.shiftID,
        schedulesManagedSeparately,
        req.body.employeeData.exceptionID || 3,
        req.body.employeeData.educationLevelID,
        req.body.employeeData.educationGrade,
        req.body.employeeData.transportTypeID,
        req.body.employeeData.maritalStatusID,
        req.body.employeeData.nationality,
        req.body.employeeData.salary,
        req.body.employeeData.relatives,
        req.body.employeeData.requiredAttendance,
        ...camposAuditoriaUPDATE(req),
        employeeID,
      ]
    );

    // 1. Manejo del Turno al actualizar datos generales
    if (!schedulesManagedSeparately && req.body.employeeData.shiftID) {
      const formattedStartDate = req.body.employeeData.shiftStartDate 
        ? dayjs(req.body.employeeData.shiftStartDate).format("YYYY-MM-DD") 
        : dayjs().format("YYYY-MM-DD");
      
      const formattedEndDate = req.body.employeeData.shiftEndDate 
        ? dayjs(req.body.employeeData.shiftEndDate).format("YYYY-MM-DD") 
        : null;

      // Verificamos si ya existe un registro activo para ese empleado en esa fecha exacta o cerramos el anterior
      await db.query(
        `UPDATE h_assigmentshift_emp
         SET endDate = DATE_SUB(?, INTERVAL 1 DAY)
         WHERE employeeID = ?
           AND DATE(startDate) < ?
           AND (endDate IS NULL OR DATE(endDate) >= ?)
           AND shiftID <> ?`,
        [formattedStartDate, employeeID, formattedStartDate, formattedStartDate, req.body.employeeData.shiftID]
      );

      // Comprobamos si ya existe el turno exacto para actualizarlo en lugar de insertar uno nuevo duplicado
      const [existingShift] = await db.query(
        `SELECT hassigmentshiftID FROM h_assigmentshift_emp 
         WHERE employeeID = ? AND DATE(startDate) = ? LIMIT 1`,
        [employeeID, formattedStartDate]
      );

      if (existingShift.length > 0) {
        // Si ya hay un registro en esa misma fecha, lo actualizamos
        await db.query(
          `UPDATE h_assigmentshift_emp 
           SET shiftID = ?, endDate = ?, comments = ?, updatedDate = ?, updatedBy = ?
           WHERE hassigmentshiftID = ?`,
          [
            req.body.employeeData.shiftID,
            formattedEndDate,
            req.body.employeeData.shiftComments || null,
            ...camposAuditoriaUPDATE(req),
            existingShift[0].hassigmentshiftID
          ]
        );
      } else {
        // Si no existe, insertamos el nuevo registro en el histórico
        await db.query(
          `INSERT INTO h_assigmentshift_emp (employeeID, shiftID, startDate, endDate, comments, createdDate, createdBy)
           VALUES (?, ?, ?, ?, ?, ?, ?)`,
          [
            employeeID,
            req.body.employeeData.shiftID,
            formattedStartDate,
            formattedEndDate,
            req.body.employeeData.shiftComments || null,
            ...camposAuditoriaADD(req)
          ]
        );
      }

      await syncEmployeeShiftFromHistory(employeeID, req);
    }

    // 2. Manejo de la Excepción al actualizar datos generales
    if (!schedulesManagedSeparately && req.body.employeeData.exceptionID) {
      const formattedExcStartDate = req.body.employeeData.exceptionStartDate 
        ? dayjs(req.body.employeeData.exceptionStartDate).format("YYYY-MM-DD") 
        : dayjs().format("YYYY-MM-DD");
      
      const formattedExcEndDate = req.body.employeeData.exceptionEndDate 
        ? dayjs(req.body.employeeData.exceptionEndDate).format("YYYY-MM-DD") 
        : null;

      const [existingException] = await db.query(
        `SELECT hassignmentexceptionID FROM h_assigmentexception_emp 
         WHERE employeeID = ? AND DATE(startDate) = ? LIMIT 1`,
        [employeeID, formattedExcStartDate]
      );

      if (existingException.length > 0) {
        await db.query(
          `UPDATE h_assigmentexception_emp 
           SET exceptionID = ?, endDate = ?, comments = ?, updatedDate = ?, updatedBy = ?
           WHERE hassignmentexceptionID = ?`,
          [
            req.body.employeeData.exceptionID,
            formattedExcEndDate,
            req.body.employeeData.exceptionComments || null,
            ...camposAuditoriaUPDATE(req),
            existingException[0].hassignmentexceptionID
          ]
        );
      } else {
        await db.query(
          `INSERT INTO h_assigmentexception_emp (employeeID, exceptionID, startDate, endDate, comments, createdDate, createdBy)
           VALUES (?, ?, ?, ?, ?, ?, ?)`,
          [
            employeeID,
            req.body.employeeData.exceptionID,
            formattedExcStartDate,
            formattedExcEndDate,
            req.body.employeeData.exceptionComments || null,
            ...camposAuditoriaADD(req)
          ]
        );
      }

      await syncEmployeeExceptionFromHistory(employeeID, req);
    }

    const [employee] = await db.query(
      `SELECT
          e.employeeID, e.codeEmployee, concat(firstName, " ", middleName, " ", lastName, " ", secondLastName) fullName,
          dep.departmentName, j.jobName, e.incapacitated, shi.shiftName, e.isActive, e.docNumber, if (e.isActive, 'ACTIVO', 'INACTIVO') isActive
        FROM employees_emp e
              INNER JOIN division_emp di on di.divisionID = e.divisionID
              INNER JOIN area_emp a on a.areaID = e.areaID
              INNER JOIN department_emp dep on dep.departmentID = e.departmentID
              INNER JOIN shifts_emp shi on shi.shiftID = e.shiftID
              INNER JOIN jobs_emp j on j.jobID = e.jobID
              where e.employeeID = ${employeeID}
        ORDER BY e.employeeID asc;`
    );

    //Agregar registro de historico del empleado
    res.status(201).json(...employee);
  } catch (error) {
    console.error(error);
    res.status(500).json({ message: "Error" });
  }
};

