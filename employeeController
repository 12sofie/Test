// Exportar reporte de vacaciones a Excel (endpoint separado)
exports.exportVacationsReport = async (req, res) => {
  const language = req.headers["accept-language"] || "en";
  try {
    const [vacations] = await db.query(
      `
        SELECT 
        e.codeEmployee, CONCAT(e.firstName, ' ', e.middleName, ' ', e.lastName) as fullName,
        e.hireDate, j.jobName, v.date
        FROM 
        employees_emp e
        left join vacations_emp v on e.employeeID = v.employeeID
        left join jobs_emp j on j.jobID = e.jobID
        where e.isActive;
      `
    );

    const result = Object.values(
      vacations.reduce((acc, item) => {
        const key = item.codeEmployee;
        if (!acc[key]) {
          acc[key] = {
            codeEmployee: item.codeEmployee,
            fullName: item.fullName,
            hireDate: item.hireDate,
            jobName: item.jobName,
          };
        }

        // Extraer el año de la fecha si existe
        if (item.date) {
          const year = dayjs(item.date).year();
          acc[key][year] = (acc[key][year] || 0) + 1;
        }
        return acc;
      }, {})
    );

    let startOperacionYear = 2022;
    let allYears = [];
    const currentYear = new Date().getFullYear();
    while (startOperacionYear <= currentYear) {
      if (!allYears.includes(startOperacionYear)) {
        allYears.push(startOperacionYear);
      }
      startOperacionYear++;
    }

    const normalized = result.map((emp) => {
      allYears.forEach((y) => {
        if (!emp[y]) emp[y] = 0;
      });
      return {
        ...emp,
        total: allYears.reduce((sum, year) => sum + emp[year], 0),
      };
    });

    normalized.forEach((emp) => {
      let { vacacionesDisponibles } = obtenerDiasDisponibles(
        emp.hireDate,
        emp.total
      );
      emp.vacacionesDisponibles = vacacionesDisponibles;
    });

    // Validar que tenemos datos para exportar
    if (normalized.length === 0) {
      return res.status(400).json({ message: "No hay datos para exportar" });
    }

    // Generar Excel
    const workbook = new ExcelJS.Workbook();
    const worksheet = workbook.addWorksheet("Reporte de Vacaciones");

    // Configurar encabezados
    worksheet.columns = [
      { header: t("employeeCode", language), key: "codeEmployee", width: 10 },
      { header: t("fullName", language), key: "fullName", width: 30 },
      { header: t("jobTitle", language), key: "jobName", width: 30 },
      { header: t("hireDate", language), key: "hireDate", width: 15 },
      ...allYears.map((year) => ({
        header: year,
        key: year.toString(),
        width: 8,
      })),
      { header: t("total", language), key: "total", width: 10 },
      {
        header: t("availableDays", language),
        key: "vacacionesDisponibles",
        width: 15,
      },
    ];

    // Calcular el número total de columnas
    const totalColumns = 4 + allYears.length + 2; // 4 columnas fijas + años + total + días disponibles

    // Aplicar estilos al encabezado (fila 1) solo a las columnas con datos
    const headerRow = worksheet.getRow(1);
    for (let col = 1; col <= totalColumns; col++) {
      const cell = headerRow.getCell(col);
      cell.font = { bold: true, color: { argb: "FFFFFFFF" } }; // Texto blanco y negrita
      cell.fill = {
        type: "pattern",
        pattern: "solid",
        fgColor: { argb: "FF4472C4" }, // Fondo azul
      };
      cell.alignment = { vertical: "middle", horizontal: "center" };
    }
    headerRow.height = 25;

    // Agregar datos
    normalized.forEach((emp, index) => {
      const row = [
        emp.codeEmployee || "",
        emp.fullName || "",
        emp.jobName || "",
        emp.hireDate ? dayjs(emp.hireDate).format("YYYY-MM-DD") : "",
        ...allYears.map((year) => emp[year] || 0),
        emp.total || 0,
        emp.vacacionesDisponibles,
      ];
      const addedRow = worksheet.addRow(row);

      // Aplicar negrita al nombre (columna 2)
      addedRow.getCell(2).font = { bold: true };

      // Centrar los números
      for (let i = 5; i <= addedRow.cellCount; i++) {
        addedRow.getCell(i).alignment = { horizontal: "center" };
      }
    });

    // Aplicar bordes solo a las celdas con datos
    worksheet.eachRow((row, rowNumber) => {
      for (let col = 1; col <= totalColumns; col++) {
        const cell = row.getCell(col);
        cell.border = {
          top: { style: "thin", color: { argb: "FF000000" } },
          left: { style: "thin", color: { argb: "FF000000" } },
          bottom: { style: "thin", color: { argb: "FF000000" } },
          right: { style: "thin", color: { argb: "FF000000" } },
        };
      }
    });

    // Configura encabezados HTTP para descarga
    res.setHeader(
      "Content-Type",
      "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
    );
    res.setHeader(
      "Content-Disposition",
      `attachment; filename=vacaciones_${Date.now()}.xlsx`
    );

    // Generar el buffer del archivo Excel
    await workbook.xlsx.write(res);
    res.end();
  } catch (error) {
    console.error("Error al exportar el reporte de vacaciones:", error);
    res
      .status(500)
      .json({ message: t("exportError", language) || "Error al exportar" });
  }
};

exports.exportVacationsDetailsReport = async (req, res) => {
  const language = req.headers["accept-language"] || "en";

  try {
    const { startDate: qStart, endDate: qEnd } = req.query;

    const isValidDate = (v) => dayjs(v, "YYYY-MM-DD", true).isValid();

    let startDate = null;
    let endDate = null;

    // 1) Si viene rango -> usarlo
    if (qStart || qEnd) {
      const s = qStart || qEnd;
      const e = qEnd || qStart;

      if (!isValidDate(s) || !isValidDate(e)) {
        return res.status(400).json({
          success: false,
          message: "Fechas inválidas. Usa formato YYYY-MM-DD en startDate/endDate.",
        });
      }

      startDate = dayjs(s).format("YYYY-MM-DD");
      endDate = dayjs(e).format("YYYY-MM-DD");

      // asegurar orden
      if (dayjs(endDate).isBefore(dayjs(startDate))) {
        const tmp = startDate;
        startDate = endDate;
        endDate = tmp;
      }
    }

    const sql = `
  SELECT 
    e.codeEmployee,
    CONCAT(e.firstName, ' ', e.middleName, ' ', e.lastName) as fullName,
    e.hireDate,
    j.jobName,
    v.date,
    v.withPaid
  FROM vacations_emp v
  LEFT JOIN employees_emp e ON e.employeeID = v.employeeID
  LEFT JOIN jobs_emp j ON j.jobID = e.jobID
  WHERE e.isActive
  ${startDate && endDate ? "AND v.date BETWEEN ? AND ?" : ""}
  ORDER BY v.date ASC, v.employeeID ASC;
`;

    const params = startDate && endDate ? [startDate, endDate] : [];

    const [detalleVacaciones] = await db.query(sql, params);

    // Organizar datos por empleado y año
    const empleadosAgrupados = {};

    detalleVacaciones.forEach((item) => {
      const key = item.codeEmployee;

      if (!empleadosAgrupados[key]) {
        empleadosAgrupados[key] = {
          codeEmployee: item.codeEmployee,
          fullName: item.fullName,
          hireDate: item.hireDate,
          jobName: item.jobName,
          vacacionesPorAño: {},
        };
      }

      if (item.date) {
        const año = dayjs(item.date).year();
        if (!empleadosAgrupados[key].vacacionesPorAño[año]) {
          empleadosAgrupados[key].vacacionesPorAño[año] = [];
        }
        const fechaFormateada = dayjs(item.date).format("DD-MM-YYYY");
        const estado = item.withPaid == 1 ? "Con Goce" : "Sin Goce";

        empleadosAgrupados[key].vacacionesPorAño[año].push(
          `${fechaFormateada} (${estado})`
        );
      }
    });

    // Obtener todos los años disponibles y calcular máximo de fechas por año
    const todosLosAños = new Set();
    const maxFechasPorAño = {};

    Object.values(empleadosAgrupados).forEach((emp) => {
      Object.keys(emp.vacacionesPorAño).forEach((año) => {
        const añoInt = parseInt(año);
        todosLosAños.add(añoInt);

        const numFechas = emp.vacacionesPorAño[año].length;
        if (!maxFechasPorAño[añoInt] || numFechas > maxFechasPorAño[añoInt]) {
          maxFechasPorAño[añoInt] = numFechas;
        }
      });
    });

    const añosOrdenados = Array.from(todosLosAños).sort();

    // Crear el workbook
    const workbook = new ExcelJS.Workbook();
    workbook.creator = "PMSB API";
    workbook.created = new Date();

    const worksheet = workbook.addWorksheet("Detalle de Vacaciones");

    // Configurar estructura de columnas dinámicamente
    const encabezadosBase = 4; // Código, Nombre, Fecha Ingreso, Puesto
    let totalColumnasFechas = 0;
    añosOrdenados.forEach((año) => {
      totalColumnasFechas += maxFechasPorAño[año] || 0;
    });
    const totalColumnas = encabezadosBase + totalColumnasFechas + 2; // +2 para columnas Total y Días Disponibles

    // Configurar anchos de columnas dinámicamente
    const columnWidths = [
      { width: 8 },  // Código
      { width: 30 }, // Nombre
      { width: 15 }, // Fecha de Ingreso
      { width: 25 }, // Puesto
    ];

    // Agregar anchos para fechas
    añosOrdenados.forEach((año) => {
      const numFechas = maxFechasPorAño[año] || 0;
      for (let i = 0; i < numFechas; i++) {
        columnWidths.push({ width: 12 });
      }
    });

    // Agregar anchos para columnas Total y Días Disponibles
    columnWidths.push({ width: 15 }); // Total
    columnWidths.push({ width: 18 }); // Días Disponibles

    worksheet.columns = columnWidths;

    // FILA 1: Encabezados principales + Años
    const headerRow1 = worksheet.getRow(1);

    headerRow1.getCell(1).value = "Código";
    headerRow1.getCell(2).value = "Nombre";
    headerRow1.getCell(3).value = "Fecha de Ingreso";
    headerRow1.getCell(4).value = "Puesto";

    // Años como encabezados
    let colIndex = encabezadosBase + 1;
    añosOrdenados.forEach((año) => {
      const startCol = colIndex;
      const numFechas = maxFechasPorAño[año] || 0;
      const endCol = colIndex + numFechas - 1;

      if (numFechas > 0) {
        if (numFechas > 1) worksheet.mergeCells(1, startCol, 1, endCol);
        headerRow1.getCell(startCol).value = año;
        colIndex += numFechas;
      }
    });

    headerRow1.getCell(totalColumnas - 1).value = "Total";
    headerRow1.getCell(totalColumnas).value = "Días Disponibles";

    // FILA 2: Sub-encabezados
    const headerRow2 = worksheet.getRow(2);

    for (let i = 1; i <= encabezadosBase; i++) {
      worksheet.mergeCells(1, i, 2, i);
    }

    colIndex = encabezadosBase + 1;
    añosOrdenados.forEach((año) => {
      const numFechas = maxFechasPorAño[año] || 0;
      for (let i = 0; i < numFechas; i++) {
        headerRow2.getCell(colIndex + i).value = "Fecha";
      }
      colIndex += numFechas;
    });

    worksheet.mergeCells(1, totalColumnas - 1, 2, totalColumnas - 1);
    headerRow2.getCell(totalColumnas - 1).value = "Días";

    worksheet.mergeCells(1, totalColumnas, 2, totalColumnas);
    headerRow2.getCell(totalColumnas).value = "Restantes";

    // Estilos FILA 1 base
    for (let col = 1; col <= encabezadosBase; col++) {
      const cell = headerRow1.getCell(col);
      cell.font = { bold: true, color: { argb: "FFFFFFFF" } };
      cell.fill = { type: "pattern", pattern: "solid", fgColor: { argb: "FF4472C4" } };
      cell.alignment = { vertical: "middle", horizontal: "center" };
    }

    // Estilos años
    colIndex = encabezadosBase + 1;
    añosOrdenados.forEach((año) => {
      const numFechas = maxFechasPorAño[año] || 0;
      if (numFechas > 0) {
        const cell = headerRow1.getCell(colIndex);
        cell.font = { bold: true, color: { argb: "FFFFFFFF" } };
        cell.fill = { type: "pattern", pattern: "solid", fgColor: { argb: "FF70AD47" } };
        cell.alignment = { vertical: "middle", horizontal: "center" };
        colIndex += numFechas;
      }
    });

    // Estilos FILA 2
    colIndex = encabezadosBase + 1;
    añosOrdenados.forEach((año) => {
      const numFechas = maxFechasPorAño[año] || 0;
      for (let i = 0; i < numFechas; i++) {
        const cell = headerRow2.getCell(colIndex + i);
        cell.font = { bold: true, color: { argb: "FFFFFFFF" } };
        cell.fill = { type: "pattern", pattern: "solid", fgColor: { argb: "FF92D050" } };
        cell.alignment = { vertical: "middle", horizontal: "center" };
      }
      colIndex += numFechas;
    });

    // Estilos Total/Días disponibles
    const totalCell = headerRow1.getCell(totalColumnas - 1);
    totalCell.font = { bold: true, color: { argb: "FFFFFFFF" } };
    totalCell.fill = { type: "pattern", pattern: "solid", fgColor: { argb: "FFFF6F00" } };
    totalCell.alignment = { vertical: "middle", horizontal: "center" };

    const diasDisponiblesCell = headerRow1.getCell(totalColumnas);
    diasDisponiblesCell.font = { bold: true, color: { argb: "FFFFFFFF" } };
    diasDisponiblesCell.fill = { type: "pattern", pattern: "solid", fgColor: { argb: "FFFF6F00" } };
    diasDisponiblesCell.alignment = { vertical: "middle", horizontal: "center" };

    headerRow1.height = 25;
    headerRow2.height = 25;

    // Agregar datos
    Object.values(empleadosAgrupados).forEach((empleado) => {
      const fila = [
        empleado.codeEmployee,
        empleado.fullName,
        dayjs(empleado.hireDate).format("DD-MM-YYYY"),
        empleado.jobName,
      ];

      let totalDias = 0;

      añosOrdenados.forEach((año) => {
        const fechasDelAño = empleado.vacacionesPorAño[año] || [];
        const numFechas = maxFechasPorAño[año] || 0;

        totalDias += fechasDelAño.length;

        for (let i = 0; i < numFechas; i++) {
          fila.push(fechasDelAño[i] || "");
        }
      });

      const { vacacionesDisponibles } = obtenerDiasDisponibles(
        empleado.hireDate,
        totalDias
      );

      fila.push(totalDias);
      fila.push(vacacionesDisponibles);

      const addedRow = worksheet.addRow(fila);

      addedRow.getCell(2).font = { bold: true };

      const totalCellRow = addedRow.getCell(totalColumnas - 1);
      totalCellRow.font = { bold: true };
      totalCellRow.fill = { type: "pattern", pattern: "solid", fgColor: { argb: "FFFFF2CC" } };

      const diasDisponiblesCellRow = addedRow.getCell(totalColumnas);
      diasDisponiblesCellRow.font = { bold: true };

      if (vacacionesDisponibles < 0) {
        diasDisponiblesCellRow.fill = { type: "pattern", pattern: "solid", fgColor: { argb: "FFFFCCCC" } };
        diasDisponiblesCellRow.font = { bold: true, color: { argb: "FFCC0000" } };
      } else {
        diasDisponiblesCellRow.fill = { type: "pattern", pattern: "solid", fgColor: { argb: "FFCCFFCC" } };
      }

      for (let col = encabezadosBase + 1; col <= totalColumnas; col++) {
        addedRow.getCell(col).alignment = { horizontal: "center" };
      }
    });

    // Bordes
    worksheet.eachRow((row) => {
      for (let col = 1; col <= totalColumnas; col++) {
        const cell = row.getCell(col);
        cell.border = {
          top: { style: "thin", color: { argb: "FF000000" } },
          left: { style: "thin", color: { argb: "FF000000" } },
          bottom: { style: "thin", color: { argb: "FF000000" } },
          right: { style: "thin", color: { argb: "FF000000" } },
        };
      }
    });

    // Nombre del archivo (incluye rango si aplica)
    const suffix =
      startDate && endDate ? `${startDate}_a_${endDate}` : dayjs().format("YYYY-MM-DD");
    const fileName = `Detalle_Vacaciones_${suffix}.xlsx`;

    res.setHeader(
      "Content-Type",
      "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
    );
    res.setHeader("Content-Disposition", `attachment; filename="${fileName}"`);

    const buffer = await workbook.xlsx.writeBuffer();
    res.send(buffer);
  } catch (error) {
    console.error("Error al exportar el reporte detallado de vacaciones:", error);
    res.status(500).json({ message: t("exportError", language) || "Error al exportar" });
  }
};
