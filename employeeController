    await db.query(
      `INSERT INTO h_assigmentshift_emp 
        (employeeID, shiftID, startDate, endDate, comments, createdDate, createdBy) 
       VALUES (?, ?, ?, ?, ?, ?, ?)`,
      [
        employeeID,
        shiftID,
        formattedStartDate,
        formattedEndDate,
        comments || null,
        ...camposAuditoriaADD(req),
      ]
    );

    await syncEmployeeShiftFromHistory(employeeID, req);

    res.status(200).json({ message: t("updateSuccess", language) });
  } catch (error) {
    console.error("Error al actualizar turno del empleado:", error);
    res.status(500).json({ message: t("updateError", language) });
  }
