async function validateNoShiftOverlap(employeeID, startDate, endDate, excludeID = null, previousShiftID = null) {
  const normalizedStart = dayjs(startDate).format("YYYY-MM-DD");
  const normalizedEnd = endDate ? dayjs(endDate).format("YYYY-MM-DD") : null;

  if (normalizedEnd && normalizedStart > normalizedEnd) {
    return {
      valid: false,
      message: "La fecha de inicio no puede ser mayor que la fecha final",
    };
  }

  const [rows] = await db.query(
    `SELECT hassigmentshiftID
     FROM h_assigmentshift_emp
     WHERE employeeID = ?
       AND DATE(startDate) <= ?
       AND (endDate IS NULL OR DATE(endDate) >= ?)
       ${excludeID ? "AND hassigmentshiftID <> ?" : ""}
       ${previousShiftID ? "AND NOT (DATE(startDate) < ? AND shiftID <> ?)" : ""}
     LIMIT 1`,
    [
      employeeID,
      normalizedEnd || "9999-12-31",
      normalizedStart,
      ...(excludeID ? [excludeID] : []),
      ...(previousShiftID ? [normalizedStart, previousShiftID] : []),
    ]
  );

  if (rows.length > 0) {
    return {
      valid: false,
      message: "El empleado ya tiene un turno programado en ese rango de fechas",
    };
  }

  return { valid: true };
}

async function syncEmployeeShiftFromHistory(employeeID, req = null) {
  const todayStr = dayjs().format("YYYY-MM-DD");

  const [historyRows] = await db.query(
    `SELECT hs.shiftID
     FROM h_assigmentshift_emp hs
     WHERE hs.employeeID = ?
       AND DATE(?) >= DATE(hs.startDate)
       AND (hs.endDate IS NULL OR DATE(?) <= DATE(hs.endDate))
     ORDER BY hs.startDate DESC, hs.hassigmentshiftID DESC
     LIMIT 1`,
    [employeeID, todayStr, todayStr]
  );

  const effectiveShiftID = historyRows[0]?.shiftID ?? null;

  if (effectiveShiftID !== null) {
    const auditValues = req ? camposAuditoriaUPDATE(req) : [dayjs().format("YYYY-MM-DD HH:mm:ss"), 0];
    await db.query(
      "UPDATE employees_emp SET shiftID = ?, updatedDate = ?, updatedBy = ? WHERE employeeID = ?",
      [effectiveShiftID, ...auditValues, employeeID]
    );
    return effectiveShiftID;
  }

  const [employeeRow] = await db.query(
    "SELECT shiftID FROM employees_emp WHERE employeeID = ? LIMIT 1",
    [employeeID]
  );

  if (employeeRow && employeeRow[0]) {
    const auditValues = req ? camposAuditoriaUPDATE(req) : [dayjs().format("YYYY-MM-DD HH:mm:ss"), 0];
    await db.query(
      "UPDATE employees_emp SET shiftID = ?, updatedDate = ?, updatedBy = ? WHERE employeeID = ?",
      [employeeRow[0].shiftID, ...auditValues, employeeID]
    );
    return employeeRow[0].shiftID;
  }

  return null;
}

exports.updateEmployeeShift = async (req, res) => {
  const language = req.headers["accept-language"] || "es";
  //para programacin de turnos
  // const { shiftID, startDate, endDate, comments } = req.body;
  try {
    const { employeeID } = req.params;
    const { shiftID, startDate, endDate, comments } = req.body;

    if (!isValidNumber(employeeID) || !isValidNumber(shiftID)) {
      return res
        .status(400)
        .json({ message: t("shiftemplooyeenotfound", language) });
    }
//descomentar para programacin de turnos
    if (!startDate) {
      return res
        .status(400)
        .json({ message: "La fecha de inicio es obligatoria" });
    }

    // Formateamos las fechas para tipo DATETIME
    const formattedStartDate = dayjs(startDate).format("YYYY-MM-DD");
    const formattedEndDate = endDate ? dayjs(endDate).format("YYYY-MM-DD") : null;

    const overlapCheck = await validateNoShiftOverlap(
      employeeID,
      formattedStartDate,
      formattedEndDate,
      null,
      shiftID
    );

    if (!overlapCheck.valid) {
      return res.status(409).json({ message: overlapCheck.message });
    }

    // 1. Actualizar la asignación del turno actual en el empleado
    const [result] = await db.query(
      "UPDATE employees_emp SET shiftID = ?, updatedDate = ?, updatedBy = ? WHERE employeeID = ?",
      [shiftID, ...camposAuditoriaUPDATE(req), employeeID]
    );

    if (result.affectedRows === 0) {
      return res.status(404).json({ message: t("employeenotfound", language) });
    }

